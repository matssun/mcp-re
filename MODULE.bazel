# The Python SDK's native module (sdk/python). `abi3-py39` builds ONE extension every
# CPython from 3.9 loads. The build scripts of pyo3-build-config and pyo3-ffi read the
# interpreter configuration from the PyO3 toolchain (//bazel/pyo3), never from whatever
# `python` a build host happens to have. The toolchain is named by its CANONICAL repository
# (`@@rules_rust_pyo3+`): the crate repositories cannot see the apparent name, and
# MODULE.bazel has no `Label()` to resolve it.
crate.spec(
    package = "pyo3",
    version = "0.29",
    features = [
        "abi3-py39",
        "extension-module",
    ],
    repositories = ["crates_mcp_re"],
)
crate.spec(
    package = "pyo3-introspection",
    version = "0.29",
    repositories = ["crates_mcp_re"],
)

[
    crate.annotation(
        build_script_data = ["@@rules_rust_pyo3+//:current_pyo3_toolchain"],
        build_script_env = {
            "PYO3_CROSS": "$(PYO3_CROSS)",
            "PYO3_CROSS_LIB_DIR": "$(PYO3_CROSS_LIB_DIR)",
            "PYO3_CROSS_PYTHON_IMPLEMENTATION": "$(PYO3_CROSS_PYTHON_IMPLEMENTATION)",
            "PYO3_CROSS_PYTHON_VERSION": "$(PYO3_CROSS_PYTHON_VERSION)",
            "PYO3_NO_PYTHON": "$(PYO3_NO_PYTHON)",
            "PYO3_PYTHON": "$(PYO3_PYTHON)",
        },
        build_script_toolchains = ["@@rules_rust_pyo3+//:current_pyo3_toolchain"],
        crate = name,
        repositories = ["crates_mcp_re"],
    )
    for name in ("pyo3-build-config", "pyo3-ffi")
]

# The TypeScript SDK's Node addon (sdk/typescript). napi-rs without its tokio runtime: the
# binding is synchronous. napi-derive also writes the type definitions
# `//sdk/typescript:native_type_defs` collects.
crate.spec(
    package = "napi",
    version = "3",
    default_features = False,
    features = ["napi8"],
    repositories = ["crates_mcp_re"],
)
crate.spec(
    package = "napi-derive",
    version = "3",
    repositories = ["crates_mcp_re"],
)

# The platforms MCP-RE builds for. A dependency the crates declare only for another
# target (the `windows-*` family, `wasi`) is not in the build graph, so it is neither
# compiled nor assessed by the supply-chain gate (scripts/supply_chain_gate.py), which
# reads the graph `bazel query` reports.
crate.from_specs(
    name = "crates_mcp_re",
    cargo_lockfile = "//bazel:crates.lock",
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates_mcp_re")

########################################
# OCI base image (distroless glibc + libstdc++ for the C FFI deps)
########################################
# The proxy binary is x86_64-unknown-linux-gnu (glibc) with C FFI dependencies
# (cryptoki-sys, ring), so the base must provide glibc + a C runtime — distroless
# cc (gcr.io/distroless/cc-debian12). linux/amd64 only for the v1 single-arch
# image. Digest-pinned to mirror the root monorepo's digest-pinning convention.

oci = use_extension(
    "@rules_oci//oci:extensions.bzl",
    "oci",
)
oci.pull(
    name = "distroless_cc_base",
    digest = "sha256:e1065a1d58800a7294f74e67c32ec4146d09d6cbe471c1fa7ed456b2d2bf06e0",
    image = "gcr.io/distroless/cc-debian12",
    platforms = ["linux/amd64"],
)
use_repo(
    oci,
    "distroless_cc_base",
    "distroless_cc_base_linux_amd64",
)

########################################
# Gazelle + gazelle_rust — first-party BUILD generation (ADR-MCPS-048 / MCPS-68)
########################################
#
# gazelle_rust parses each crate's `use` graph and generates/updates the
# first-party `rust_*` targets and their first-party `deps` edges. Combined with
# the `# gazelle:map_kind` directives in the root BUILD.bazel, generated targets
# use the house `nt_rust_*` macros; third-party edges resolve to the existing
# `@crates_mcp_re//:...` hub (see `# gazelle:rust_crates_prefix`). This makes the
# hand-maintained first-party deps surface — the entire #220 drift class —
# generated instead of hand-written. A CI staleness gate (MCPS-70) makes it stick.
#
# These are dev/tooling-only bazel_deps (host-side gazelle binary); they do not
# enter the runtime graph of any mcp-re crate or the published artifacts.

bazel_dep(name = "gazelle", version = "0.51.3", dev_dependency = True)
bazel_dep(name = "gazelle_rust", version = "0.1.0", dev_dependency = True)
