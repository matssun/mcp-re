# MCP-RE — nested Bazel module (clean-room build-graph firewall)
#
# This MODULE.bazel makes the MCP-RE Cargo workspace at components/mcp-re
# buildable via Bazel with ZERO submodules and no parent monorepo. It
# enforces the ADR-MCPS-001 clean-room firewall at the build-graph level:
# the module sees only its own crates + the crates.io deps pinned in its
# own committed Cargo.lock, and nothing from the surrounding repo.
#
# It can be used in two ways:
#
#   1. Standalone: `cd components/mcp-re && bazel test //...`
#      Proves the subtree is self-contained — the canonical hermetic
#      build/test for the publishable MCP-RE workspace (ADR-MCPS-010/012).
#
#   2. As a nested module of the root monorepo via:
#          bazel_dep(name = "mcp-re", version = "0.0.1")
#          local_path_override(
#              module_name = "mcp-re",
#              path = "components/mcp-re",
#          )
#      Then targets become accessible as `@mcp-re//mcp-re-core:mcp_re_core`
#      from anywhere in the parent workspace.
#
# Versions and toolchain pin to the root monorepo's shared Rust pins
# (infrastructure/config/build/build-manifests.toml [bazel_deps]/[rust])
# so the nested module is fully self-contained AND consistent with the
# parent.

module(
    name = "mcp-re",
    version = "0.0.1",
)

bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_python", version = "1.7.0")
# The Python SDK's native module (`mcp_re_sdk._core`) is a PyO3 extension.
bazel_dep(name = "rules_rust_pyo3", version = "0.70.0")

# The interpreter the PyO3 toolchain configures the SDK's native module against. The
# module is abi3, so this names the build interpreter, not the set it runs on.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

register_toolchains(
    "//bazel/pyo3:rust_pyo3_toolchain",
    "//bazel/pyo3:pyo3_toolchain",
)
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "1.0.0")
# `build_test`: compiles a `manual` target on every `bazel test //...` without running it.
# 1.8.2 is the version the module graph already resolves (via aspect_bazel_lib).
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# OCI image packaging of the production proxy artifact (mcp_re_proxy_ext) — pinned
# to the SAME versions as the root monorepo (infrastructure/config/build) so the
# nested module stays consistent with the parent's shared deps.
bazel_dep(name = "rules_oci", version = "2.0.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")
# NOTE: the zig toolchain is intentionally NOT registered globally here. It is
# only needed to cross-compile the linux/amd64 OCI image FROM a darwin host;
# registering it globally also makes it the exec/host C++ toolchain on a Linux
# runner, where zig's lld/wrapper breaks upb + rust tool links (undefined
# __start_linkarr_* under -z start-stop-gc, and zig rejects -z nostart-stop-gc).
# It is registered on darwin hosts only, via `build:macos --extra_toolchains` in
# .bazelrc (+ --enable_platform_specific_config). On a Linux host the native cc
# toolchain builds every target (the OCI cross is native there), so no zig.

########################################
# Tar toolchains (required for rules_pkg with bzlmod)
########################################

bazel_lib_toolchains = use_extension(
    "@aspect_bazel_lib//lib:extensions.bzl",
    "toolchains",
)
bazel_lib_toolchains.tar()
bazel_lib_toolchains.zstd()
use_repo(
    bazel_lib_toolchains,
    "bsd_tar_toolchains",
    "zstd_toolchains",
)

########################################
# Rust toolchain — pinned to the workspace's required version
########################################

# The pinned Verus release, for the Verus lane (//bazel/verus). Read from the toolchain lock,
# which is the one statement of the pin; only the `manual` `verus_verify` targets use it.
verus_install = use_repo_rule("//bazel/verus:repo.bzl", "verus_install")

verus_install(
    name = "verus",
    lock = "//:verification/policy/toolchains.lock.toml",
)

# The extraction container's Charon, for the Lean extraction lane (//bazel/charon); only
# the `manual` `charon_llbc` targets use it, inside that container.
charon_install = use_repo_rule("//bazel/charon:repo.bzl", "charon_install")

charon_install(name = "charon")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # 1.97.1 builds everything. The nightly is the extraction lane's alone (//bazel/charon):
    # Charon's driver is built against it, so the crates it reads must be too. It is
    # selected only by `--@rules_rust//rust/toolchain/channel=nightly`, which nothing but
    # that lane sets.
    versions = [
        "1.97.1",
        "nightly/2026-08-18",
    ],
    # Cross-compile the image binaries to Linux from a darwin host: amd64 for the
    # registry images, arm64 for the local kind fleet on Apple Silicon
    # (scripts/stage_image_binaries.sh).
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)

########################################
# Cross C++ toolchain (zig) for OCI image builds
########################################
# Hermetic zig-based cc toolchain so the proxy's C FFI deps (cryptoki-sys, etc.)
# cross-compile to the linux/amd64 image platform from a darwin host.

zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
)
use_repo(zig_toolchains, "zig_sdk")

########################################
# External crates — declared here, resolved by Bazel from no Cargo manifest
########################################
#
# Every external crate the build graph uses is named below, with its version
# requirement and features, and resolved into the `@crates_mcp_re` hub against
# `bazel/crates.lock`. Bazel reads no Cargo.toml and no Cargo.lock. The hub used to
# be spliced from the Cargo workspace (`crate.from_cargo`), which made Cargo's
# manifests the source of truth for the Bazel build; this is the first step of
# making Bazel the only build system. The Cargo lanes still read the manifests
# until they are moved over, and so does gazelle_rust (the BUILD drift detector,
# `gazelle:rust_mode generate_from_cargo` in //:BUILD.bazel) — a later step.
#
# Features are the union of what every workspace member requests, because one hub
# holds one feature set per crate — the unification Cargo performed.
# `default_features = False` means no member uses that crate's defaults.
#
# While the Cargo manifests exist, `scripts/crate_spec_parity_gate.py` fails when a
# spec here and the Cargo workspace disagree on a version or a feature, or when
# `bazel/crates.lock` and `Cargo.lock` pin a crate differently.
#
# To change a crate: edit its spec, then re-resolve the lock with
#     CARGO_BAZEL_REPIN=1 bazel mod show_extension @rules_rust//crate_universe:extension.bzl%crate
# A spec change takes effect without that (the lock only pins versions), but the
# lock must be re-resolved to record what the change pulled in.
# The hub MUST stay named `crates_mcp_re`: every BUILD file refers to it.

crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.spec(
    package = "asn1-rs",
    version = "0.7",
    repositories = ["crates_mcp_re"],
)
crate.spec(
    package = "base64",
    version = "0.23",
    repositories = ["crates_mcp_re"],
)
