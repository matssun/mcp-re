load("//bazel:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

# ADR-MCPRE-066 §2.1: the source tree, exposed so the conformance audit-vocabulary guard can
# MEASURE which files decide what an `mcp-re.*` verdict token says, rather than reading a
# hand-maintained list of producers. The sentinel names the tree; the guard walks it.
filegroup(
    name = "guard_src_files",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# MCPS-014: client-side ambassador. Pure library — depends only on the
# verification crate plus serde_json (request construction). No networking/async.
nt_rust_library(
    name = "mcp_re_host",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mcp_re_host",
    edition = "2021",
    deps = [
        "//mcp-re-client-core:mcp_re_client_core",
        "//mcp-re-core:mcp_re_core",
        # MCPS-033: OS CSPRNG for the production nonce source. Not networking/async.
        "@crates_mcp_re//:getrandom",
        "@crates_mcp_re//:serde_json",
    ],
)

# ADR-MCPS-048 / #220 (feature-flavor handling, cf. MCPS-69): a `test-fixtures`-enabled
# flavor of the SAME crate. FixedClock / SeededNonceSource are cfg'd behind
# `#[cfg(any(test, feature = "test-fixtures"))]` (audit #81 — kept off the production
# surface). In-workspace demo/test targets that consume those deterministic fixtures
# depend on THIS flavor, matching the Cargo `mcp-re-host = { features = ["test-fixtures"] }`
# dev-dep. Same `crate_name`, so consumers still `use mcp_re_host::…`; a target links
# EITHER this or `:mcp_re_host`, never both (one crate name). The plain `:mcp_re_host`
# stays fixture-free for production consumers.
nt_rust_library(
    name = "mcp_re_host_test_fixtures",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["test-fixtures"],
    crate_name = "mcp_re_host",
    edition = "2021",
    deps = [
        "//mcp-re-client-core:mcp_re_client_core",
        "//mcp-re-core:mcp_re_core",
        "@crates_mcp_re//:getrandom",
        "@crates_mcp_re//:serde_json",
    ],
)

# The crate's in-source controls. Registered as a target because it had NONE: `mcp-re-host`
# was four files and zero tests in BOTH lanes, and a crate with no test target is a crate the
# Bazel lane says nothing about. Built as the `test-fixtures` flavor because the controls
# compare the production source against the fixtures it gates — under `cfg(test)` the gate is
# satisfied either way, and the SOURCE-shape and MANIFEST controls are what establish the
# boundary for a production build.
nt_rust_test(
    name = "mcp_re_host_test",
    crate = ":mcp_re_host_test_fixtures",
    auto_cargo_toml = False,
    bazel_build_cfg = False,
    compile_data = [
        "Cargo.toml",
        "src/clock.rs",
        "src/nonce.rs",
    ],
    crate_features = ["test-fixtures"],
    edition = "2021",
    deps = [
        "//mcp-re-client-core:mcp_re_client_core",
        "//mcp-re-core:mcp_re_core",
        "@crates_mcp_re//:getrandom",
        "@crates_mcp_re//:serde_json",
    ],
)
