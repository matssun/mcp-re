# syntax=docker/dockerfile:1
# SPDX-License-Identifier: Apache-2.0
#
# In-cluster load generator for the zero-drop rolling-update proof (Proof 4 of
# docs/security/gke-multi-replica-validation.sh). It runs the HTTP-profile signed-
# request client (docs/security/mcp_re_gke_client.py) IN the cluster against the proxy
# SERVICE ClusterIP, so every request traverses kube-proxy — which removes a draining
# pod from the Service endpoints (preStop delay) and reroutes new connections to live
# pods. That L4 connection-rerouting is exactly what a host-side `kubectl port-forward`
# (a direct tunnel to ONE pinned pod) cannot exercise: when the rollout deletes the
# pinned pod, the tunnel dies and every subsequent request fails regardless of drain.
#
#   scripts/stage_image_binaries.sh --arch amd64
#   docker build -f deploy/docker/Dockerfile.loadgen --target loadgen \
#     --build-arg DIST=deploy/docker/dist/amd64 -t mcp-re-loadgen:0.17.0 .
#
# The client needs only the compiled mcp_re_sdk core + the stdlib; the KMS root pubkey
# and client fixtures are mounted at runtime from a Secret (never baked in). The SDK wheel
# is the one Bazel builds (//sdk/python:wheel), staged for the image's architecture; the
# image compiles nothing.

# The interpreter is the one `verification/policy/toolchains.lock.toml` `[python]` pins,
# named exactly rather than as a floating `3.14-slim`. Two reasons, and the first is the one
# that broke this file: `sdk/python` declares `requires-python >=3.14.5,<3.15`, so a base
# image outside that range cannot install the wheel — and it fails at `docker build`, after
# a full fleet rollout, reading like a deploy problem. The second is the reason
# `Dockerfile.inner` gives for pinning `mcp`: a floating tag makes the artefact a different
# one on every rebuild. `scripts/python_runtime_gate.py` holds this equal to the pin.

FROM python:3.14.7-slim AS loadgen
ARG DIST=deploy/docker/dist/amd64
COPY ${DIST}/wheels /wheels
RUN pip install --no-cache-dir /wheels/*.whl && rm -rf /wheels
COPY docs/security/mcp_re_gke_client.py /app/mcp_re_gke_client.py
WORKDIR /app
# The harness `kubectl exec`s the request loop; keep the pod alive.
ENTRYPOINT ["sleep", "infinity"]
