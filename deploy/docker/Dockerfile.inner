# syntax=docker/dockerfile:1
# SPDX-License-Identifier: Apache-2.0
#
# The ALLOWED inner-plane image for the MCP-RE fleet: a real MCP SDK
# Streamable-HTTP MCP backend (tools/fastmcp_inner_backend.py, built on
# `mcp.server.mcpserver.MCPServer`). MCP-RE is HTTP-profile only — the proxy
# forwards each verified request to this backend over `--inner-http-url`. This
# replaces the removed stdio-bridge sidecar.
#
#   docker build -f deploy/docker/Dockerfile.inner -t mcp-re-inner-fastmcp:0.14.0 .
#
# The port comes from config/ports.toml ([services.mcp_re_inner_backend].port);
# override with MCP_RE_INNER_BACKEND_PORT. The module builds its own ASGI app with
# json_response=True (a plain application/json JSON-RPC body — the shape
# http_inner.rs parses) and stateless_http=True (matching the proxy's
# one-POST-per-request forwarding), so neither needs an environment flag.
FROM python:3.12-slim AS inner
# `mcp` is the upstream MCP SDK; uvicorn serves the ASGI app the module builds, which
# is what lets the MRTR ConfirmActionShim wrap it.
RUN pip install --no-cache-dir "mcp>=2.0,<3" "uvicorn>=0.30"
WORKDIR /app
COPY tools/fastmcp_inner_backend.py /app/fastmcp_inner_backend.py
# The script resolves config/ports.toml one dir up from itself (here/../config);
# with the script at /app that is /config/ports.toml.
COPY config/ports.toml /config/ports.toml
ENV MCP_RE_INNER_BACKEND_HOST=0.0.0.0
# fastmcp_inner_backend.py binds config host by default; the K8s manifest sets
# MCP_RE_INNER_BACKEND_PORT and we bind 0.0.0.0 so the Service can reach it.
ENTRYPOINT ["python", "/app/fastmcp_inner_backend.py"]
