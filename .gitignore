# Rust
/target/
# Nested cargo build dirs (verification reproducers, sdk crates). The anchored
# rule above only covers the workspace root, so a reproducer's target/ was
# stageable — 173 build artefacts nearly went into a commit.
target/
**/*.rs.bk

# Bazel (build artifacts; symlinks point into ~/Library/Caches/bazel/)
/bazel-bin
/bazel-mcp-re
/bazel-out
/bazel-testlogs

# macOS
.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# work directory not to be tracked
/work/

# Python bytecode cache
__pycache__/
*.pyc

# Coverage artifact from running the SDK suite at the repo root.
.coverage

# Claude Code
/.claude

# ADR-MCPRE-059 attestation store — derived evidence, never source (§"Evidence attestation").
/.verification/
