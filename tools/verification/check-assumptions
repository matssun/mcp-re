#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""The proof-escape-hatch gate — ADR-MCPRE-059 §13, Case D.

A proof that is green because of an unregistered `assume`, `admit`, `axiom`,
`external_body`, `external`, or `assume_specification` is not valid MCP-RE evidence. This
gate finds those mechanisms in the verification tree and fails the merge unless the
registry accounts for them.

Two things it is honest about:

  * A token scan is an INITIAL detector, not the final control. Specification weakening
    happens without adding any of these tokens — a postcondition can simply be made
    weaker. The ADR says so explicitly, and the mature control compares parsed
    specification semantics. Until that exists, every specification diff is treated as
    security-sensitive by the review policy, not by this script.

  * Where it scans is derived, not assumed. `verification/` is always in scope. So is
    every file a unit in `verification.toml` declares, because the Phase 2 pilot puts
    specification text directly in the production source it constrains — a gate that
    scanned only `verification/` would have reported PASS with four escape hatches in
    `mcp-re-core/src/`. It did, before this was fixed.

    Production files are matched against the CODE forms of each mechanism, not the bare
    words, which is what the original limit was protecting against: `external` and
    "admit only the closed set" appear in ordinary Rust for reasons that have nothing to
    do with proofs. The verus-specific spellings are distinct tokens and are still caught.

  * Proof text outside a declared unit is a FAILURE, not a pass. Otherwise a
    specification could be weakened in a file the manifest does not know about, and no
    lane would ever look at it.

Registration is per UNIT, not per mechanism name. An assumption registers a mechanism
within the units its `scope` names, so `verus:external_body` trusted for the time parser
says nothing about a new `external_body` in the admission path. A flat set of mechanism
names would whitelist every existing and future site in scope the moment one assumption
mentioned the kind.

And two things registration can never excuse, because no assumption could honestly state
them:

  * A unit's own PROVED SYMBOL under an escape hatch. `external_body`, `external`,
    `opaque` or an `assume_specification` on the function a theorem is about makes that
    theorem vacuous while the prover still reports the symbol verified and the lane still
    reports PASS.
  * A proved symbol carrying no specification at all. The specification is a detachable
    attribute; deleting it leaves the function, the crate's verified count, and every
    gate exactly as they were.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _seams import (  # noqa: E402
    MECHANISMS,
    PRODUCTION_MECHANISMS,
    code_of,
    declared_items,
    production_lines,
    site_key,
)
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    load_assumptions,
    load_verification,
)

VERIFICATION_DIR = REPO_ROOT / "verification"

#: Tokens that mean "there is Verus specification text here". A production file carrying
#: one of these is a proof surface no matter where it lives, and must belong to a
#: declared unit.
PROOF_TEXT = re.compile(r"\bverus_spec\b|\bverus_verify\b|\bverus!\s*\{|\bassume_specification\b")

#: Directories whose Rust is never production source.
NON_PRODUCTION = ("verification/", "target/")

#: Mechanisms that, applied to the very function a unit claims to have proved, make the
#: claimed theorem vacuous or delete it. No assumption registers these at a proved symbol,
#: because there is no honest justification for one: the unit would be advertising a
#: theorem that the prover was told not to check.
VACUITY_AT_PROVED_SYMBOL = {
    "external_body": r"\bexternal_body\b",
    "external": r"verifier::external\b(?!_)|verus_verify\s*\(\s*external\s*\)",
    "external_fn_specification": r"\bexternal_fn_specification\b",
    "assume_specification": r"\bassume_specification\b",
    "opaque": r"verifier::opaque\b",
}

#: What makes an attribute block a SPECIFICATION rather than decoration.
SPECIFICATION_TEXT = re.compile(r"\bensures\b|\brequires\b")

def _definition(name: str) -> re.Pattern[str]:
    """A Rust function definition, as it appears at the head of the item."""
    return re.compile(
        r"^\s*(?:pub(?:\([^)]*\))?\s+)?"
        r"(?:default\s+|const\s+|async\s+|unsafe\s+|extern\s+\"[^\"]*\"\s+)*"
        rf"fn\s+{re.escape(name)}\s*[(<]"
    )


SCANNED_SUFFIXES = {".rs", ".lean", ".v"}

#: Generated Lean is machine-owned and may legitimately contain extraction artifacts. It is
#: excluded from the token scan and covered instead by the generated-drift gate: a
#: hand-edit there is caught by regeneration mismatch, which is the stronger control.
#:
#: Reproducers are standalone crates outside the Cargo workspace, in no unit's paths and in
#: no lane's input. Nothing there can make any unit's proof pass, so a token there is not an
#: escape hatch — it is a bug report about the prover.
EXCLUDED = ("verification/lean/generated/", "verification/reproducers/")


def registered_by_unit() -> dict[str, set[tuple[str, str]]]:
    """`(mechanism kind, SITE)` pairs the registry accounts for, per unit in `scope`.

    Scope is what makes registration mean something, and the SITE is what makes it mean one
    thing. `verus:external_body` trusted inside `core.time_rfc3339` is a statement about
    that unit's trusted computing base and no other; collapsing the registry to a set of
    names would hand every unit in the repository whatever any one assumption happened to
    need. Kind-level registration inside a unit had the same defect one level down —
    R9-C037 / R9-C067 / R9-C068: `scope` names whole crates, so one entry licensed every
    present and future site of that mechanism in every file those units declare. The
    registry recorded *"this unit trusts uninterpreted spec functions"*, which is not a fact
    about any seam.

    An assumption with NO `sites` therefore registers NOTHING. That is the fail-closed
    direction and the only one available: the alternative — absent means all — is the rule
    being replaced.
    """
    doc = load_assumptions()
    out: dict[str, set[tuple[str, str]]] = {}
    for entry in doc.get("assumption", []):
        mechanism = entry["tool_specific_mechanism"].split(":", 1)[-1]
        sites = [str(site) for site in entry.get("sites", [])]
        for target in entry.get("scope", []):
            target = str(target)
            if target.startswith("unit://"):
                unit_id = target.removeprefix("unit://")
                out.setdefault(unit_id, set()).update((mechanism, site) for site in sites)
    return out


def registered_sites() -> dict[str, set[str]]:
    """Every site each assumption registers — for detecting entries that name no seam."""
    doc = load_assumptions()
    return {
        entry["id"]: {str(site) for site in entry.get("sites", [])}
        for entry in doc.get("assumption", [])
        if entry.get("sites")
    }


def is_registered(
    mechanism: str,
    site: str | None,
    owners: frozenset[str] | set[str],
    registered: dict[str, set[tuple[str, str]]],
) -> bool:
    """Is THIS SEAM registered by an assumption scoped to a unit that declares its file?

    Three conjuncts, and each one is a way registration could say more than it means: the
    MECHANISM, because trusting an uninterpreted spec function is not trusting an
    `external_body`; the UNIT, because a trusted computing base belongs to the unit whose
    proofs rest on it; and the SITE, because a seam is a place a proof stops proving, and
    the registry is a statement about places.

    A file no unit declares has no owning trusted computing base, so nothing can register a
    mechanism there — which is why the empty owner set answers no rather than yes. A seam
    whose item cannot be named (`site is None`) is likewise unregistrable: it has no
    identity to register.
    """
    if site is None:
        return False
    return any((mechanism, site) in registered.get(unit_id, set()) for unit_id in owners)


def unit_files() -> dict[Path, set[str]]:
    """Every existing file a `verification.toml` unit names -> the units that name it."""
    doc = load_verification()
    files: dict[Path, set[str]] = {}
    for unit in doc.get("unit", []):
        for declared in unit["paths"]:
            for path in REPO_ROOT.glob(declared):
                if path.is_file():
                    files.setdefault(path, set()).add(unit["id"])
    return files


def declared_unit_files() -> set[Path]:
    """Every existing file a `verification.toml` unit names, expanded from its globs."""
    return set(unit_files())


def scan_paths() -> list[tuple[Path, bool, frozenset[str]]]:
    """(file, is_production, owning units) for everything in scope, in a stable order."""
    declared = unit_files()
    scoped: dict[Path, tuple[bool, frozenset[str]]] = {}
    if VERIFICATION_DIR.exists():
        for path in VERIFICATION_DIR.rglob("*"):
            if path.is_file() and path.suffix in SCANNED_SUFFIXES:
                scoped[path] = (False, frozenset(declared.get(path, ())))
    for path, owners in declared.items():
        if path.suffix in SCANNED_SUFFIXES:
            scoped.setdefault(path, (True, frozenset(owners)))
    out = []
    for path in sorted(scoped):
        rel = path.relative_to(REPO_ROOT).as_posix()
        if any(rel.startswith(prefix) for prefix in EXCLUDED):
            continue
        is_production, owners = scoped[path]
        out.append((path, is_production, owners))
    return out


#: A test region opens here — ADR-MCPRE-061 §5.1, the same definition
#: `scripts/module_size_gate.py` reads.
def scan() -> list[tuple[Path, int, str, str, frozenset[str], str | None]]:
    hits: list[tuple[Path, int, str, str, frozenset[str], str | None]] = []
    for path, is_production, owners in scan_paths():
        mechanisms = PRODUCTION_MECHANISMS if is_production else MECHANISMS
        text = path.read_text(encoding="utf-8")
        lines = text.splitlines()
        rel = path.relative_to(REPO_ROOT).as_posix()
        # One declaration pass per file, shared by every seam in it: the qualifier of an item
        # is decided by the blocks open above it, and re-deriving that per seam is quadratic
        # in exactly the specification files that carry the most seams.
        items = declared_items(lines)
        numbered = (
            production_lines(text)
            if is_production
            else list(enumerate(lines, start=1))
        )
        for lineno, line in numbered:
            # Comments are not code. Prose mentioning a mechanism counted as an escape-hatch
            # site, and kind-level registration hid it: the kind was registered, so a comment
            # and a real seam both read `[registered]`. One rule, in `_seams`, for both the
            # census here and the boundary rule that asks which seams a proof trusts.
            code = code_of(line)
            for name, pattern in mechanisms.items():
                if re.search(pattern, code):
                    hits.append(
                        (
                            path.relative_to(REPO_ROOT),
                            lineno,
                            name,
                            line.strip(),
                            owners,
                            site_key(rel, lines, lineno, items),
                        )
                    )
    return hits


def _bracket_balance(line: str) -> int:
    return sum(line.count(c) for c in "([{") - sum(line.count(c) for c in ")]}")


#: A line comment's tail, and a whole-line block comment. Removed before an attribute block
#: is searched — see `_definition_sites`.
_COMMENT_TAIL = re.compile(r"//.*$")


def _definition_sites(lines: list[str], pattern: re.Pattern[str]) -> list[tuple[int, str]]:
    """`(line index, ATTRIBUTE text)` for every definition `pattern` matches.

    Read forwards rather than backwards from the item. A Verus specification is a
    multi-line `#[cfg_attr(...)]` whose body is arbitrary expression text, so no
    line-shaped heuristic recognises its middle; accumulating the block from its opening
    `#[` until the brackets balance does.

    COMMENTS ARE NOT PART OF THE BLOCK, and that is the whole point of this function
    returning attribute text rather than everything above the item. They used to be
    accumulated, so `SPECIFICATION_TEXT` — the ONLY control for a deleted specification —
    matched the words `requires` or `ensures` in the doc comment above the function. A
    specification could therefore be deleted while the prose describing it stayed, and the
    gate would report the theorem present. Doc comments say what a function is supposed to
    do; the attribute is what makes the prover check it, and only the second is evidence.
    A comment cannot supply an escape-hatch mechanism either, so removing them fixes a
    false positive in the same walk.

    Comment lines still do not RESET the block: an attribute separated from its item by a
    doc comment is still that item's attribute.
    """
    sites: list[tuple[int, str]] = []
    block: list[str] = []
    depth = 0
    for index, line in enumerate(lines):
        if depth > 0:
            # Inside a multi-line attribute. A trailing `//` comment here is still prose,
            # so it is stripped before the text is kept — but the brackets on the line are
            # counted from the whole line, because a comment cannot close an attribute.
            block.append(_COMMENT_TAIL.sub("", line))
            depth += _bracket_balance(line)
            continue
        stripped = line.strip()
        if stripped.startswith("#["):
            block.append(_COMMENT_TAIL.sub("", line))
            depth = max(_bracket_balance(line), 0)
            continue
        if not stripped or stripped.startswith(("//", "/*", "*")):
            continue
        if pattern.match(line):
            sites.append((index, "\n".join(block)))
        block = []
    return sites


def proved_symbol_defects() -> list[str]:
    """Claimed theorems that no lane can distinguish from a deleted one.

    Three ways a unit advertises a theorem it does not have, none of which the prover's
    report shows: the function is not in the unit's declared paths at all, it carries an
    escape hatch that tells the prover not to check it, or its specification has simply
    been removed while the function stayed.
    """
    doc = load_verification()
    defects: list[str] = []
    for unit in doc.get("unit", []):
        symbols = unit.get("proved_symbols", [])
        if not symbols:
            continue
        sources = [
            path
            for path in sorted(declared_unit_files())
            if path.suffix == ".rs" and unit["id"] in unit_files()[path]
        ]
        for symbol in symbols:
            name = symbol.rsplit("::", 1)[-1]
            pattern = _definition(name)
            sites = 0
            for path in sources:
                lines = path.read_text(encoding="utf-8").splitlines()
                rel = path.relative_to(REPO_ROOT).as_posix()
                for index, block in _definition_sites(lines, pattern):
                    sites += 1
                    for mechanism, mechanism_pattern in sorted(
                        VACUITY_AT_PROVED_SYMBOL.items()
                    ):
                        if re.search(mechanism_pattern, block):
                            defects.append(
                                f"{unit['id']}: proved symbol {symbol} is annotated "
                                f"`{mechanism}` at {rel}:{index + 1}. The prover is told "
                                f"not to check the function the unit claims to have "
                                f"proved, so the theorem is vacuous while the symbol "
                                f"still appears verified."
                            )
                    if not SPECIFICATION_TEXT.search(block):
                        defects.append(
                            f"{unit['id']}: proved symbol {symbol} at {rel}:{index + 1} "
                            f"carries no `requires`/`ensures`. The specification is a "
                            f"detachable attribute: deleting it leaves the function, the "
                            f"crate's verified count and the prover's symbol list "
                            f"unchanged, so no lane sees the theorem go."
                        )
            if sites == 0:
                defects.append(
                    f"{unit['id']}: proved symbol {symbol} defines no function in the "
                    f"unit's declared paths. A theorem the manifest advertises over source "
                    f"the unit does not declare is invalidated by no change to it."
                )
    return defects


def undeclared_proof_text() -> list[tuple[Path, int, str]]:
    """Verus specification text in production Rust that no unit declares."""
    declared = declared_unit_files()
    found: list[tuple[Path, int, str]] = []
    for path in sorted(REPO_ROOT.rglob("*.rs")):
        rel = path.relative_to(REPO_ROOT).as_posix()
        if any(rel.startswith(prefix) for prefix in NON_PRODUCTION) or path in declared:
            continue
        for lineno, line in enumerate(
            path.read_text(encoding="utf-8", errors="replace").splitlines(), start=1
        ):
            if PROOF_TEXT.search(line):
                found.append((path.relative_to(REPO_ROOT), lineno, line.strip()))
    return found


def main() -> int:
    try:
        registered = registered_by_unit()
        stray = undeclared_proof_text()
        vacuous = proved_symbol_defects()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    if vacuous:
        print(f"check-assumptions: {len(vacuous)} claimed theorem(s) not established")
        for defect in vacuous:
            print(f"  [VACUOUS] {defect}")
        print(
            "\nFAIL: a unit claims a theorem the prover was not asked to check, or was "
            "asked\nto check nothing about. This is not registrable: an assumption may "
            "move an\nobligation into the trusted computing base, but it may not leave the "
            "manifest\nadvertising a proof of the thing it excused.",
            file=sys.stderr,
        )
        return 1

    if stray:
        print(f"check-assumptions: proof text in {len(stray)} undeclared location(s)")
        for path, lineno, text in stray:
            print(f"  [UNDECLARED] {path}:{lineno}  |  {text}")
        print(
            "\nFAIL: Verus specification text lives in a file no `verification.toml` unit "
            "declares.\nA specification outside a unit is checked by no lane and invalidated "
            "by no change,\nso weakening it would be invisible. Declare the unit, or remove "
            "the specification.",
            file=sys.stderr,
        )
        return 1

    def covered(mechanism: str, site: str | None, owners: frozenset[str]) -> bool:
        return is_registered(mechanism, site, owners, registered)

    hits = scan()
    unregistered = [hit for hit in hits if not covered(hit[2], hit[5], hit[4])]

    # A registration naming no seam is the same defect read backwards. A site key is derived
    # from the ITEM, so it survives formatting — but not a rename or a deletion, and an entry
    # left pointing at a seam that no longer exists reads as trust the tree no longer needs.
    # Refusing it is what keeps the registry a measurement rather than a memory.
    live_sites = {hit[5] for hit in hits if hit[5]}
    stale = {
        asm_id: sorted(sites - live_sites)
        for asm_id, sites in registered_sites().items()
        if sites - live_sites
    }

    if not hits:
        print("check-assumptions: PASS — no proof escape hatch in scope")
        print("VERDICT: PASS")
        print(f"  registered sites: {sum(len(m) for m in registered.values())}")
        return 0

    print(f"check-assumptions: {len(hits)} escape-hatch site(s) found")
    for path, lineno, name, text, owners, site in hits:
        status = "registered" if covered(name, site, owners) else "UNREGISTERED"
        where = ", ".join(sorted(owners)) or "no unit"
        identity = site or "UNNAMEABLE"
        print(f"  [{status}] {identity}  {name}  ({where})  |  {path}:{lineno}  {text}")

    if stale:
        print(
            "\nFAIL: an assumption registers a site that no longer exists. A site key names "
            "the\nITEM a seam sits on, so it survives formatting — an entry that has stopped "
            "resolving\nnames a seam that was renamed or removed, and the trust it records "
            "is trust nothing\nin the tree still needs. Discharge the entry, or point it at "
            "the seam that replaced it:",
            file=sys.stderr,
        )
        for asm_id, sites in sorted(stale.items()):
            for site in sites:
                print(f"  {asm_id}: {site}", file=sys.stderr)
        return 1

    if unregistered:
        # R9-C120. The remedy depends on whether the site HAS an owning unit, and naming
        # the wrong one is worse than naming none: a site in a file no `[[unit]]` declares
        # cannot be registered at all — `scope` names units, and there is no unit to name —
        # so telling its author to add an assumption scoped to "this unit" describes a step
        # that does not exist. The first move there is to declare the file.
        unowned = [hit for hit in unregistered if not hit[4]]
        owned = [hit for hit in unregistered if hit[4]]
        print(
            "\nFAIL: unregistered proof escape hatch. Every one of these moves an "
            "obligation\nout of the proof and into the trusted computing base.",
            file=sys.stderr,
        )
        if owned:
            print(
                "\nRegistration is per SITE, inside a unit: an assumption trusted in one "
                "unit does not\nexcuse the same mechanism in another, and trusting one seam "
                "does not excuse the next\none added beside it. Register each of these in "
                "verification/policy/assumptions.toml with a\njustification, an owner, a "
                "`scope` naming the unit that declares the file, and a `sites`\nentry naming "
                "the seam below — or discharge it:",
                file=sys.stderr,
            )
            for path, lineno, name, _text, owners, site in owned:
                identity = site or f"{path}:{lineno} (NO NAMEABLE ITEM)"
                print(f"  {identity}  {name}  in {', '.join(sorted(owners))}", file=sys.stderr)
        if unowned:
            print(
                "\nThese sit in files NO unit declares, so they cannot be registered at "
                "all: `scope`\nnames units, and there is no unit to name. Declare the file "
                "in the `[[unit]]` whose\nauthority it belongs to first — registering the "
                "mechanism is the step after that,\nnot instead of it:",
                file=sys.stderr,
            )
            for path, lineno, name, _text, _owners, _site in unowned:
                print(f"  {path}:{lineno}  {name}  (no unit declares this file)", file=sys.stderr)
        print(
            "\nA green proof created by an unregistered assumption is not MCP-RE evidence.",
            file=sys.stderr,
        )
        return 1

    print("\ncheck-assumptions: PASS — every SITE is registered")
    print("VERDICT: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
