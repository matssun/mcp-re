#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""The verification umbrella — ADR-MCPRE-059 "Authoritative CI loop".

Runs the platform's checks in the ADR's order and reports a single verdict:

    1. validate verification manifests
    2. validate toolchain pins
    3. detect assumption / TCB escape hatches
    4. check generated-model freshness
    5. the declared test batteries
    6. the V0 mutation probes — is each battery's claimed check load-bearing?
    7. full Verus verification
    8. Lean build and proofs

Report-only by default (Phase 1 deliverable 7): the platform reports its own health
without blocking unrelated code, because a verification lane that can fail the build
before it has ever produced a proof is a lane that will be disabled. `--gate` makes it
authoritative — that is the flag CI flips once the pilots land.

Each lane DECLARES its outcome on a single line, one of five:

    VERDICT: NOT_REQUIRED | PASS | FAIL | UNAVAILABLE | SKIPPED

Five rather than three, because three collapsed two pairs of genuinely different
situations, and both collapses are places a false PASS gets in:

    NOT_REQUIRED  the manifest asks nothing of this lane. Legitimate; does not hold the
                  aggregate back, and is never counted as evidence either.
    UNAVAILABLE   required, but could not execute — tools unpinned, lane absent on this
                  host, container unreachable.
    SKIPPED       required, could have executed, deliberately not executed.

`UNAVAILABLE` and `SKIPPED` both force INCOMPLETE; they stay apart because one is an
environment to fix and the other a decision to justify. Neither may read as success.

A lane that exits 0 without declaring a verdict is FAIL, as is one declaring two different
verdicts: both mean the lane cannot say what it did, and unknown is dirty (§2). The
declaration is what separates "ran and was satisfied" from "ran nothing and returned 0" —
a distinction no amount of reading the lane's prose can reliably recover.

The aggregate is `aggregate_verdict`, and it distinguishes lanes that produce EVIDENCE
(Verus, Lean, generated-model) from lanes that are PRECONDITIONS for trusting evidence
(manifest validation, the assumption/TCB gate). A hygiene lane can withhold a pass by
failing; its passing proves nothing about the code. So a repository with green hygiene
gates and no proofs reports INCOMPLETE, not PASS — otherwise an empty manifest would read
as a verified repository, which is "exits 0 having measured nothing" one level up again.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _compose import compose, contradictions, requirements  # noqa: E402
from _evidence import evidence_store, write_bundle  # noqa: E402
from _theorems import load_theorems, unsupported_theorems  # noqa: E402
from _manifest import (  # noqa: E402
    LANE_VERDICTS,
    REPO_ROOT,
    ManifestError,
    aggregate_verdict,
    assumption_scope_defects,
    boundary_class_violations,
    load_assumptions,
    load_toolchains,
    load_trust_boundaries,
    load_verification,
    unresolved_pins,
)

HERE = Path(__file__).resolve().parent

def _declared_verdict(output: str) -> str | None:
    """The verdict a lane declared, or None if it declared none.

    Exactly one VERDICT: line is expected. Two contradicting lines are not a tie to be
    broken here — they mean the lane does not know what it did, which is unknown, which
    is dirty.
    """
    found = {
        line.split(":", 1)[1].strip()
        for line in output.splitlines()
        if line.strip().startswith("VERDICT:")
    }
    if len(found) != 1:
        return None
    verdict = found.pop()
    return verdict if verdict in LANE_VERDICTS else None


#: (display name, script, is_formal).
#:
#: `is_formal` is what separates a lane that produces EVIDENCE from a lane that is a
#: PRECONDITION for trusting evidence. The assumption/TCB gate can withhold a pass by
#: failing, but its passing says nothing about the code — so it must never be able to
#: carry the aggregate to PASS on its own.
LANES = [
    ("assumptions", "check-assumptions", False),
    ("generated-model", "check-generated", True),
    ("test", "verify-tests", True),
    # A V0 claim's negative battery, self-tested: does deleting the check a theorem names
    # actually turn a declared control red? Formal in the `is_formal` sense — it produces
    # EVIDENCE about the code, not a precondition for trusting other evidence.
    ("mutation", "verify-mutations", True),
    ("verus", "verify-verus", True),
    ("lean", "verify-lean", True),
]

#: Which FORMAL lanes each execution phase may run — the split the two environments force.
#:
#: Charon links the private rustc crates and does not build on macOS, so the extracted-model
#: lanes run inside the pinned container; Verus and the cargo matrix are not in that
#: container, so they run on the host. Neither phase can run the other's lanes, which is why
#: neither may state the repository's aggregate: `--aggregate` does that, over records.
#:
#: HYGIENE LANES ARE IN NEITHER, and belong to the composer. They are whole-repository
#: propositions with no per-unit evidence to compose, they are host-capable, and running
#: them in a phase as well would be measuring the same thing twice and recording it nowhere.
#:
#: TOTAL over the formal lanes by construction, and checked below. A formal lane in no phase
#: would be a lane nothing executes — and because the aggregate derives its requirements
#: from the MANIFEST rather than from what ran, that shows up as a missing record.
PHASES = {
    "host": {"test", "mutation", "verus"},
    "extraction": {"generated-model", "lean"},
}
assert set().union(*PHASES.values()) == {
    name for name, _s, is_formal in LANES if is_formal
}
assert not (PHASES["host"] & PHASES["extraction"])


def gate_exit_code(aggregate: str, gate: bool) -> int:
    """The process status this run reports for an aggregate verdict.

    Only PASS exits 0 under `--gate`. INCOMPLETE is not a pass — it is the state in which
    no required lane produced formal evidence, which is what a downgraded unit, a deleted
    unit, an unavailable prover and a deliberately skipped lane all look like. An exit code
    that cannot tell those from a proved repository makes the CI check green for a run that
    measured nothing, and the exit code is the only thing CI reads.

    A FAIL EXITS NON-ZERO IN BOTH MODES. Report mode used to return 0 for a run that had
    just printed `VERIFICATION: FAIL`, on the reasoning that it is not authoritative —
    but "not authoritative" is a statement about what a PASS is worth, not a licence to
    report a failure as success. Anything reading the status rather than the verdict line
    read a failed lane as a pass, and something did: this repository has already recorded a
    lane as green off a report-mode exit status.

    What `--gate` still decides is the treatment of INCOMPLETE, which is the mode's real
    content: a report of "nothing measured" is a legitimate development state, while
    accepting it on the merge path is not.
    """
    if aggregate == "FAIL":
        return 1
    if not gate:
        return 0
    return 0 if aggregate == "PASS" else 1


@dataclass(frozen=True)
class RunOutcome:
    """What a verification run produced: its verdict, and what carried it.

    A value rather than a pair of statements, because the property that failed was one
    about EVERY exit path. `verify` wrote the bundle at the end of the lane sweep, so a run
    that returned earlier — manifest validation failed, or `--manifests` stopped it — left
    the PREVIOUS run's verdict on disk, and `attest` reads that file as "the last
    verification run". A failed run therefore made the tree look measured, and the earlier
    a run failed the more certainly the stale PASS survived it.

    Writing the bundle at each early return would fix the two paths that exist today and
    say nothing about the next one added. Returning this instead makes the write
    structural: `main` performs it once, on whatever `_run` returns, and there is no way to
    leave without stating an aggregate. Possession of a `RunOutcome` is what it means for a
    run to have a verdict.
    """

    exit_code: int
    aggregate: str
    lanes: dict[str, str]

    def policy_revision(self) -> str:
        """The revision this run validated against, or a marker if it cannot be read.

        Defensive because one caller is the path where manifest loading has ALREADY failed.
        An unreadable revision must not raise past the bundle write — that would restore
        the exact behaviour this type exists to remove.
        """
        try:
            return str(load_verification()["policy_revision"])
        except Exception:  # noqa: BLE001 — any load failure means the same thing here
            return "<unreadable>"


def validate_manifests() -> tuple[bool, list[str]]:
    notes: list[str] = []
    try:
        doc = load_verification()
        assumptions = load_assumptions()
        boundaries = load_trust_boundaries()
        toolchains = load_toolchains()
        theorems = load_theorems(
            {unit["id"] for unit in doc.get("unit", [])},
            [e for e in doc.get("edge", []) if e.get("kind") == "PROOF_DEPENDENCY"],
        )
    except ManifestError as exc:
        return False, [str(exc)]
    # `max_class_without_assumption` is a gate, not a comment: a unit promoted past the
    # class its crossed boundary permits over-reads what its proof establishes, and the
    # platform would otherwise report PASS over that over-read.
    violations = boundary_class_violations(doc, boundaries, assumptions)
    if violations:
        return False, violations
    # `[[assumption]].scope` is the one authoritative assumption→consumer relation, so a
    # scope naming a unit that does not exist is the whole of what can still be wrong: it
    # reads as a registration and carries the premise nowhere.
    defects = assumption_scope_defects(doc, assumptions)
    if defects:
        return False, defects
    notes.append(f"policy revision {doc['policy_revision']}")
    notes.append(f"{len(doc.get('unit', []))} unit(s), {len(doc.get('edge', []))} edge(s)")
    # Reported, never counted, and phrased as the structural fact it is. A resolving
    # support closure is not assurance — the unit's evidence may be stale, BLOCKED, or
    # resting on a dirty assumption — so this line says only that the closure resolves,
    # and never that a theorem is established.
    declared = len(theorems.get("theorem", []))
    unsupported = unsupported_theorems(theorems)
    notes.append(
        f"{declared} theorem(s), {len(unsupported)} without structural support closure"
        + (f": {', '.join(unsupported)}" if unsupported else "")
    )
    unresolved = unresolved_pins(toolchains)
    if unresolved:
        notes.append(f"unresolved toolchain pins: {', '.join(unresolved)}")
    return True, notes


#: The verdicts a lane may declare that are NOT a claim to have measured anything. Both say
#: "this lane produced no evidence", and both are non-passing — so a lane that exits
#: non-zero may still be believed when it says one of them.
_NON_MEASURING = ("UNAVAILABLE", "SKIPPED")


def _lane_verdict(returncode: int, declared: str | None, output: str) -> tuple[str, str]:
    """What this run records for one lane, and what to print with it.

    R9-C114. A non-zero exit used to overwrite the declared verdict with FAIL before the
    `VERDICT:` line was read at all, which made `UNAVAILABLE` and `SKIPPED` UNREACHABLE from
    any lane that reports them by exiting non-zero — the Verus lane does. A five-verdict
    algebra collapsed to two, and the states that mean "no evidence was produced, and here
    is why" became indistinguishable from "the evidence says the tree is broken". They call
    for opposite actions: install the prover, versus fix the code.

    The repair is not "believe the lane". It is that a lane is the authority on WHICH
    non-passing state it is in, and on nothing else:

      * no verdict line at all is FAIL, whatever the exit status. A lane that does not say
        what it did has unknown provenance, and unknown is dirty.
      * a declared `UNAVAILABLE` or `SKIPPED` stands even on a non-zero exit, because
        neither claims a measurement and both are already non-passing in the algebra.
      * anything else on a non-zero exit is FAIL, including — especially — `PASS`. A lane
        that crashed may never claim success, and the contradiction is reported rather than
        resolved in the lane's favour.
    """
    if declared is None:
        return "FAIL", (
            f"{output}\n\nFAIL: lane exited {returncode} without declaring a verdict. "
            "A lane that does not say what it did has unknown provenance, and unknown is "
            "dirty."
        ).strip()
    if returncode == 0:
        return declared, output
    if declared in _NON_MEASURING:
        return declared, output
    return "FAIL", (
        f"{output}\n\nFAIL: lane declared {declared} and exited {returncode}. A lane that "
        "did not complete may state which non-measuring case it is in, and nothing more."
    ).strip()


def main() -> int:
    """Run, then record. The bundle write is here and nowhere else."""
    outcome = _run()
    write_bundle(
        evidence_store(),
        outcome.aggregate,
        outcome.lanes,
        outcome.policy_revision(),
    )
    return outcome.exit_code



def _phase_contradictions(verdicts: dict[str, str]) -> list[str]:
    """Lanes in this phase that declared NOT_REQUIRED while the manifest requires them.

    Asked HERE because this is where the declared verdict exists: a lane reporting
    NOT_REQUIRED writes no record, so the composer downstream sees an absence and cannot
    tell it from a lane that simply did not run. The two call for different actions.
    """
    try:
        return contradictions(
            verdicts,
            requirements(load_verification(), load_toolchains(), load_assumptions()),
        )
    except ManifestError:
        # Manifest validation already ran and passed before any lane executed; if the
        # manifests have become unreadable since, that is not this function's finding to
        # report and inventing one would obscure it.
        return []


def _phase_outcome(phase: str, verdicts: dict[str, str]) -> RunOutcome:
    """What one execution phase reports: whether its own lanes ran, and nothing more.

    NO REPOSITORY AGGREGATE. This process cannot execute the other phase's lanes, so any
    verdict it stated about the repository would be a claim about measurements it did not
    make. What it owns is narrower and checkable: every lane it was asked to run either
    produced evidence or said why not.

    A lane that FAILED here stops the phase, because the record it wrote says `fail` and a
    later phase writing over it would be repairing a result. `UNAVAILABLE` also stops it:
    this phase was chosen because it CAN run these lanes, so a lane reporting that it
    cannot is an environment defect, not a missing measurement to be composed around.
    """
    broken = sorted(
        name for name, verdict in verdicts.items() if verdict in {"FAIL", "UNAVAILABLE", "SKIPPED"}
    )
    contradicted = _phase_contradictions(verdicts)
    print("\n" + "=" * 70)
    for note in contradicted:
        print(f"FAIL: {note}")
    if broken or contradicted:
        print(f"PHASE {phase}: FAIL — {', '.join(broken) or 'a lane contradicted the manifest'}")
        print("This phase's lanes are the ones it can run; one of them did not.")
    else:
        print(f"PHASE {phase}: OK — {len(verdicts)} lane(s) executed")
        print("No repository verdict here: `verify --aggregate` composes one.")
    print("=" * 70)
    # INCOMPLETE, always, and deliberately: a phase never produces a repository verdict, so
    # the bundle it leaves must not read as one. `attest` refuses on INCOMPLETE, which is
    # the correct posture between the phases of a run.
    return RunOutcome(1 if (broken or contradicted) else 0, "INCOMPLETE", verdicts)


def _composed_outcome(hygiene: dict[str, str], gate: bool) -> RunOutcome:
    """The repository verdict, composed from the evidence records this run produced."""
    try:
        doc = load_verification()
        toolchains = load_toolchains()
        assumptions = load_assumptions()
    except ManifestError as exc:
        print(f"\nFAIL: {exc}", file=sys.stderr)
        return RunOutcome(1, "FAIL", {"manifests": "FAIL"})

    store = evidence_store()
    aggregate, verdicts, refusals = compose(store, doc, toolchains, assumptions, hygiene)

    print(f"\n[compose] over {store}")
    for lane in sorted(set(verdicts) - set(hygiene)):
        print(f"    [{lane}] {verdicts[lane]}")
    for refusal in refusals:
        print(f"    REFUSED {refusal}")

    print("\n" + "=" * 70)
    if aggregate == "FAIL":
        print("VERIFICATION: FAIL — a record is not what it claims, or a lane recorded a failure")
    elif aggregate == "INCOMPLETE":
        print("VERIFICATION: INCOMPLETE — a required lane has no acceptable current record")
        print("A missing or stale record is not a pass. Run the phase that produces it.")
    else:
        print("VERIFICATION: PASS")
        print(f"Composed from records in {store}; every required lane has one, at this fingerprint.")
    if not gate:
        print("(report-only — pass --gate to make this authoritative)")
    print("=" * 70)
    return RunOutcome(gate_exit_code(aggregate, gate), aggregate, verdicts)


def _run() -> RunOutcome:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--gate",
        action="store_true",
        help="authoritative mode: any aggregate but PASS fails the build",
    )
    parser.add_argument(
        "--manifests",
        action="store_true",
        help="validate the manifests only, then stop",
    )
    parser.add_argument(
        "--phase",
        choices=sorted(PHASES),
        help=(
            "execute only the lanes this environment can run, and state NO repository "
            "aggregate. `--aggregate` composes the records afterwards."
        ),
    )
    parser.add_argument(
        "--aggregate",
        action="store_true",
        help=(
            "state the repository verdict by validating and composing the evidence "
            "records in the evidence directory. Executes the hygiene lanes; executes no "
            "formal lane."
        ),
    )
    args = parser.parse_args()
    if args.phase and args.aggregate:
        # They are different authorities. A process that executed lanes AND composed the
        # result would be the instrument certifying itself, which is the property the whole
        # split exists to remove.
        parser.error("--phase executes; --aggregate composes. Run them separately.")

    print("=" * 70)
    print("ADR-MCPRE-059 verification platform")
    print("=" * 70)

    ok, notes = validate_manifests()
    status = "PASS" if ok else "FAIL"
    print(f"\n[manifests] {status}")
    for note in notes:
        print(f"    {note}")
    if not ok:
        return RunOutcome(1, "FAIL", {"manifests": "FAIL"})
    if args.manifests:
        # A deliberate partial run is still a run, and after it the last verification of
        # this tree measured no lanes. INCOMPLETE rather than the previous verdict is the
        # fail-closed direction: `attest` refuses, and the remedy is to run the lanes
        # rather than to inherit a verdict from a run that no longer describes the tree.
        return RunOutcome(0, "INCOMPLETE", {"manifests": "PASS"})

    selected = PHASES[args.phase] if args.phase else {name for name, _s, _f in LANES}
    if args.aggregate:
        # The composer executes the HYGIENE lanes and no formal one. They are whole-
        # repository propositions with no per-unit evidence to compose, they are
        # host-capable, and they enter the algebra as they always have: able to withhold a
        # pass, never to carry one. Composing a formal lane's evidence and executing a
        # formal lane in the same process is exactly what `--phase` and `--aggregate` are
        # kept apart to prevent.
        selected = {name for name, _s, is_formal in LANES if not is_formal}

    verdicts: dict[str, str] = {}
    for name, script, _is_formal in LANES:
        if name not in selected:
            continue
        completed = subprocess.run(
            [sys.executable, str(HERE / script)],
            capture_output=True,
            text=True,
            check=False,
        )
        output = (completed.stdout + completed.stderr).strip()
        # The lane states its own verdict on a VERDICT: line. Inferring it from the prose
        # instead would mean a lane that exits 0 having done nothing reads as PASS purely
        # because it did not happen to print the word SKIPPED — the "exits 0 having measured
        # nothing" failure, one level up.
        declared = _declared_verdict(output)
        verdict, output = _lane_verdict(completed.returncode, declared, output)
        verdicts[name] = verdict
        print(f"\n[{name}] {verdict}")
        for line in output.splitlines():
            print(f"    {line}")

    if args.phase:
        return _phase_outcome(args.phase, verdicts)

    if args.aggregate:
        return _composed_outcome(verdicts, args.gate)

    formal = {name for name, _script, is_formal in LANES if is_formal}
    aggregate = aggregate_verdict(
        [verdict for name, verdict in verdicts.items() if name in formal],
        [verdict for name, verdict in verdicts.items() if name not in formal],
    )
    required_missing = [
        name
        for name, verdict in verdicts.items()
        if verdict in {"UNAVAILABLE", "SKIPPED"}
    ]
    failed = [name for name, verdict in verdicts.items() if verdict == "FAIL"]
    not_required = [
        name for name, verdict in verdicts.items() if verdict == "NOT_REQUIRED"
    ]

    print("\n" + "=" * 70)
    if aggregate == "FAIL":
        print(f"VERIFICATION: FAIL — {', '.join(failed)}")
    elif aggregate == "INCOMPLETE":
        if required_missing:
            print(f"VERIFICATION: INCOMPLETE — required and missing: {', '.join(required_missing)}")
        else:
            print("VERIFICATION: INCOMPLETE — the manifest requires no formal evidence")
        print("No required lane produced formal evidence. This is not a pass.")
    else:
        print("VERIFICATION: PASS")
    if not_required:
        # Reported, never counted. "The manifest asked nothing of Lean" and "Lean proved
        # something" are different claims, and only the second is evidence.
        print(f"(not required by this manifest: {', '.join(not_required)})")
    if not args.gate:
        print("(report-only — pass --gate to make this authoritative)")
    print("=" * 70)

    # Phase 3 of the evidence pipeline: the run's verdict becomes a record. Attestation is
    # a separate phase precisely so that the thing which DECIDES pass is never the thing
    # which STAMPS freshness; the issuer reads the bundle `main` writes from this and may
    # not overrule it.
    return RunOutcome(gate_exit_code(aggregate, args.gate), aggregate, verdicts)


if __name__ == "__main__":
    raise SystemExit(main())
