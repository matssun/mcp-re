#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""The `structural://` lane — ADR-MCPRE-068 §4.1, §12.1, Phase 0B.

A STRUCTURAL proposition is not established by a test that passes. It is established by a
construction the compiler REFUSES: *the representation admits no illegal inhabitant, so
possession of the value is the proof*. This lane is what makes that falsifiable.

    for each registered probe — write the hostile construction into a copy of the tree,
    compile it, and require the declared rustc error on the declared line.

Three properties make it evidence rather than a ritual, and each is one this repository has
already been burned by:

**The construction that COMPILES is the finding, not a lane malfunction.** If the illegal
inhabitant builds, the boundary is open and the structural claim above it is false. That is
reported as FAIL with the invariant named, so the response is to close the boundary rather
than to soften the claim.

**A refusal the probe cannot attribute is not evidence.** "Does not compile" is satisfied by
a typo, a missing import, or a fixture that stopped building for unrelated reasons. The
probe declares the rustc error code and the marker line its primary span must fall on.

**It never edits the working tree** (`_scratch.copy_tracked_tree`), so a crashed run leaves
the repository untouched and there is no restore step whose failure could be read as a
result.

ZERO EXECUTION IS A FAILURE, NOT A PASS — the owner's ratification of ADR-MCPRE-068:

> No unit may declare either scheme before its required lane exists and fail-closes on zero
> execution.

So: a unit declaring `structural://` with no probe registered FAILS; a run whose selection
resolves to no probe while some unit declares the scheme FAILS; an empty scratch copy FAILS.
Only a tree where NOTHING declares the scheme and NOTHING is registered reports
`NOT_REQUIRED`. A lane that could report PASS having attempted no hostile construction would
make `structural://` a word that costs nothing, which is the `-- --ignored` failure in new
clothes.

Verdicts follow the platform's five: NOT_REQUIRED when nothing claims and nothing is
registered, FAIL for an open boundary or an unattributable refusal, UNAVAILABLE when the
tree cannot be copied or Bazel cannot build, PASS otherwise.

Usage:
    tools/verification/verify-structural [--probe ID]... [--registry PATH] [--keep-tree]
"""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _evidence import EvidenceRecord, evidence_store, write_record  # noqa: E402
from _fingerprint import fingerprint_unit  # noqa: E402
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    load_assumptions,
    load_toolchains,
    load_verification,
)
from _scratch import copy_tracked_tree, lane_scratch, release  # noqa: E402
from _structural import (  # noqa: E402
    adjudicate,
    load_probes,
    marker_line,
    probe_module,
    relax,
    relaxation_verdict,
    provenance_problem,
)
from _unit_selection import (  # noqa: E402
    add_unit_argument,
    basis,
    filter_by_unit,
    refuse,
    selection_error,
)

REGISTRY = REPO_ROOT / "verification" / "policy" / "structural-probes.toml"

SCHEME = "structural://"


def claims_structural(unit: dict) -> bool:
    """Whether a `structural://` URI puts this unit inside the lane's attestation closure.

    `_evidence.required_lanes` reads every declared scheme, so a unit carrying this URI
    cannot be attested without a structural record measured at its exact fingerprint.
    """
    return any(str(e).startswith(SCHEME) for e in unit.get("evidence", []))


#: The rustc diagnostics this lane reads are JSON. The setting is rules_rust's; it applies to
#: every Rust action of the scratch build, so the owner's crate reports in the same form.
ERROR_FORMAT = "--@rules_rust//rust/settings:error_format=json"

_BOUNDARY_BUILD = """load("@rules_rust//rust:defs.bzl", "rust_test")

rust_test(
    name = "{name}",
    srcs = ["{name}.rs"],
    crate_root = "{name}.rs",
    edition = "2021",
    deps = ["{crate}"],
)
"""


def install(tree: Path, probe: dict, where: str) -> tuple[str, str, int]:
    """Write the hostile construction into the COPY, and make the compiler reach it.

    Returns (the target to build, the file the construction is in, the line its marker is
    on). A boundary probe becomes its own crate, in a package only the copy holds, whose one
    dependency is the owner's library. An in-crate probe is written INLINE into its parent
    module — the same place in the module tree and the same privacy as a file module, in a
    source the owner's target already compiles — so the owner's target is what is built.
    """
    if probe["kind"] == "crate-boundary-compile-fail":
        source = tree / str(probe["insertion_path"])
        build = source.parent / "BUILD.bazel"
        if source.exists() or build.exists():
            raise ManifestError(
                f"{where}: {probe['insertion_path']} or its package already exists in the "
                f"tree. The probe's construction is supposed to be UNWRITABLE here; a file "
                f"at that path means either the probe collides with real source or a "
                f"previous run leaked."
            )
        name = probe_module(probe)
        source.parent.mkdir(parents=True, exist_ok=True)
        source.write_text(str(probe["construction"]), encoding="utf-8")
        build.write_text(_BOUNDARY_BUILD.format(name=name, crate=probe["crate"]), encoding="utf-8")
        package = source.parent.relative_to(tree).as_posix()
        return f"//{package}:{name}", str(probe["insertion_path"]), marker_line(probe) or 0

    parent = tree / str(probe["insertion_parent"])
    if not parent.is_file():
        raise ManifestError(f"{where}: STALE — insertion parent {probe['insertion_parent']} does not exist")
    module = probe_module(probe)
    text = parent.read_text(encoding="utf-8")
    if f"mod {module}" in text:
        raise ManifestError(
            f"{where}: STALE — {probe['insertion_parent']} already declares `mod {module}`. "
            f"The probe's module is supposed to exist only inside this lane's copy."
        )
    head = text if text.endswith("\n") else text + "\n"
    # The construction's own lines start after the parent's, the blank line and the `mod`
    # line — which is where the marker's line is counted from.
    offset = head.count("\n") + 2
    parent.write_text(f"{head}\nmod {module} {{\n{probe['construction']}\n}}\n", encoding="utf-8")
    return str(probe["crate"]), str(probe["insertion_parent"]), offset + (marker_line(probe) or 0)


def compile_probe(tree: Path, target: str) -> tuple[bool, list[dict]]:
    """(the build reached rustc, diagnostics) for the injected tree.

    `bazel build` rather than a test: the question is whether the construction TYPES, and
    nothing here needs to run. A build that failed with no rustc diagnostic at all never
    got as far as compiling — a missing toolchain, an unresolvable dependency, an analysis
    error. That is UNAVAILABLE, not a verdict about the boundary, and it must not be read
    as "no error".
    """
    proc = subprocess.run(
        ["bazel", "build", ERROR_FORMAT, target],
        cwd=tree,
        capture_output=True,
        text=True,
        env=_env(),
    )
    diagnostics = []
    for line in (proc.stdout + proc.stderr).splitlines():
        if not line.startswith("{"):
            continue
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("$message_type") == "diagnostic" or "level" in message:
            diagnostics.append(message)
    if proc.returncode != 0 and not any(d.get("level") == "error" for d in diagnostics):
        return False, []
    return True, diagnostics


def _env() -> dict:
    import os

    return dict(os.environ)


def run_probe(tree: Path, probe: dict) -> str | None:
    """Why this probe did not witness its invariant, or None when it did."""
    where = f"probe {probe['id']}"
    try:
        target, relative, line = install(tree, probe, where)
        ran, diagnostics = compile_probe(tree, target)
        if not ran:
            raise EnvironmentError(f"{where}: Bazel stopped before rustc reported anything")
        problem = adjudicate(probe, diagnostics, relative, line)
        if problem is None and probe.get("relaxation"):
            problem = run_relaxed(tree, probe, target, where)
    finally:
        # Removed on EVERY path, including the one where `install` raised after writing the
        # package. A leftover construction would make the next probe's "this path already
        # exists" refusal fire about a file this lane put there — a stale-anchor report
        # about the lane's own residue.
        if probe["kind"] == "crate-boundary-compile-fail":
            shutil.rmtree((tree / str(probe["insertion_path"])).parent, ignore_errors=True)
    return problem


def run_relaxed(tree: Path, probe: dict, target: str, where: str) -> str | None:
    """The negative control: the same construction, with the owner's boundary opened.

    The owner's sources are restored whatever happens, so the next probe compiles against
    the tree as it is.
    """
    edits = probe["relaxation"]
    originals: dict[Path, str] = {}
    try:
        for path in sorted({str(e["path"]) for e in edits}):
            source = tree / path
            originals[source] = source.read_text(encoding="utf-8")
            source.write_text(relax(originals[source], path, edits), encoding="utf-8")
        ran, diagnostics = compile_probe(tree, target)
    finally:
        for source, text in originals.items():
            source.write_text(text, encoding="utf-8")
    if not ran:
        raise EnvironmentError(f"{where}: Bazel stopped before rustc reported anything (relaxed)")
    return relaxation_verdict(probe, diagnostics)


def revert(tree: Path, probe: dict, original: str | None) -> None:
    if original is not None:
        (tree / str(probe["insertion_parent"])).write_text(original, encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--probe", action="append", default=[], help="only these probe ids")
    add_unit_argument(parser)
    parser.add_argument("--registry", default=str(REGISTRY), help="probe registry to read")
    parser.add_argument("--keep-tree", action="store_true", help="leave the scratch copy")
    args = parser.parse_args()

    try:
        probes = load_probes(Path(args.registry))
        doc = load_verification()
        toolchains = load_toolchains()
        assumptions = load_assumptions()
        units = {unit["id"]: unit for unit in doc.get("unit", [])}
    except ManifestError as exc:
        return _fail(f"{exc}")

    # A SUBSTITUTED REGISTRY IS NOT THE ESTATE'S REGISTRY, so it is not judged against the
    # estate's declarations. `--registry` exists for this lane's own false-green catalogue,
    # which compiles fixture constructions against a dependency-free crate; asking whether
    # the tree's declaring units have a probe THERE is a category error, and it answered
    # FAIL for a run that was measuring the runner rather than the repository.
    official = Path(args.registry).resolve() == REGISTRY.resolve()
    if not official:
        print(
            f"verify-structural: reading a SUBSTITUTED registry ({args.registry}); this run "
            f"measures the LANE and says nothing about the repository's declarations"
        )
    declaring = (
        sorted(uid for uid, unit in units.items() if claims_structural(unit)) if official else []
    )
    registered = {probe["unit"] for probe in probes}
    registered_probes = list(probes)
    unknown = sorted({probe["unit"] for probe in probes} - set(units))
    if unknown:
        return _fail(
            f"probe(s) name unit(s) {unknown} that verification.toml does not hold. A probe "
            f"attacking no declared proposition witnesses nothing."
        )
    orphaned = [uid for uid in declaring if uid not in registered]
    if orphaned:
        return _fail(
            f"unit(s) {orphaned} declare {SCHEME} evidence but no probe is registered for "
            f"them. A declared evidence class nothing measures is unmeasured evidence."
        )

    drifted = [
        f"probe {probe['id']}: {problem}"
        for probe in probes
        if (problem := provenance_problem(probe, units[probe["unit"]], REPO_ROOT)) is not None
    ]
    if drifted:
        return _fail("; ".join(drifted))

    if args.unit:
        problem = selection_error(args.unit, set(units), registered, "structural probe")
        if problem:
            return refuse("verify-structural", problem)
        probes = filter_by_unit(probes, args.unit, lambda probe: probe["unit"])
    total = len(registered_probes)
    print(
        "verify-structural: selection basis — "
        + basis(args.unit, len(probes), total, f"every registered probe ({total})")
    )

    selected = [p for p in probes if p["id"] in set(args.probe)] if args.probe else list(probes)
    if not selected:
        if args.probe:
            # An empty SELECTION and an empty REGISTRY are different facts, and only one of
            # them is quiet. A selector that matches nothing has measured nothing, whatever
            # the registry holds — the same defect `verify-mutations --probe M25` had, where
            # every id is really `M25-<what-it-weakens>`.
            return _fail(
                f"--probe {sorted(set(args.probe))} selected NO registered probe. A "
                f"selector that matches nothing has measured nothing."
            )
        if declaring:
            return _fail(
                f"the selection resolved to NO probe while unit(s) {declaring} declare "
                f"{SCHEME}. A lane that measured nothing may not report a pass."
            )
        print("verify-structural: NOT_REQUIRED — no unit declares structural:// and no probe is registered")
        print("VERDICT: NOT_REQUIRED")
        return 0

    scratch = lane_scratch("structural")
    release(scratch)
    tree = scratch / "tree"
    try:
        copied = copy_tracked_tree(tree)
    except (subprocess.CalledProcessError, OSError) as exc:
        print(f"UNAVAILABLE: could not copy the tree: {exc}", file=sys.stderr)
        print("VERDICT: UNAVAILABLE")
        return 1
    if copied == 0:
        print(
            "UNAVAILABLE: the scratch copy is EMPTY, so every probe would compile nothing "
            "and report no error — the finding that means an OPEN boundary — about a tree "
            "that does not exist.",
            file=sys.stderr,
        )
        print("VERDICT: UNAVAILABLE")
        return 1

    failures: list[str] = []
    try:
        for probe in selected:
            original = None
            if probe["kind"] == "in-crate-source-injection":
                parent = tree / str(probe["insertion_parent"])
                original = parent.read_text(encoding="utf-8") if parent.is_file() else None
            try:
                problem = run_probe(tree, probe)
            except ManifestError as exc:
                print(f"  FAIL {probe['id']}: {exc}", file=sys.stderr)
                failures.append(probe["id"])
                continue
            except EnvironmentError as exc:
                print(f"UNAVAILABLE: {exc}", file=sys.stderr)
                print("VERDICT: UNAVAILABLE")
                return 1
            finally:
                revert(tree, probe, original)
            if problem is not None:
                print(f"  FAIL {probe['id']}: {problem}", file=sys.stderr)
                failures.append(probe["id"])
                continue
            control = ", admitted when relaxed" if probe.get("relaxation") else ""
            print(
                f"  ok   {probe['id']}  {probe['kind']}  refused by {probe['error_code']}{control}: "
                f"{probe['invariant']}"
            )
    finally:
        if args.keep_tree:
            print(f"  scratch tree kept at {scratch}")
        else:
            release(scratch)

    # Phase 3 of the evidence pipeline, as every other lane does it: a machine record BOUND
    # TO THE FINGERPRINT it was measured at. Written only for a complete run — a `--probe`
    # subset measured part of the witness, and a record from it would let "one probe passed"
    # stand in for "the boundary is closed".
    if not args.probe:
        # The units this run MEASURED — every registered one on a full run. Under `--unit`,
        # iterating the whole registry would write a pass for units no probe ran against.
        for unit_id in sorted({probe["unit"] for probe in selected}):
            unit = units.get(unit_id)
            if unit is None or not claims_structural(unit):
                continue
            mine = [p["id"] for p in selected if p["unit"] == unit_id]
            failed = [pid for pid in mine if pid in failures]
            write_record(
                evidence_store(),
                EvidenceRecord(
                    unit_id=unit_id,
                    lane="structural",
                    result="fail" if failed else "pass",
                    fingerprint=fingerprint_unit(unit, doc, toolchains, assumptions)["fingerprint"],
                    detail=(
                        f"{len(mine)} probe(s); failed: {', '.join(failed)}"
                        if failed
                        else f"{len(mine)} probe(s), each refused by the declared rustc error"
                    ),
                ),
            )

    if failures:
        print(
            f"\nFAIL: {len(failures)} of {len(selected)} probe(s) did not witness a closed "
            f"construction boundary: {', '.join(failures)}",
            file=sys.stderr,
        )
        print("VERDICT: FAIL")
        return 1
    print(f"\nverify-structural: PASS — {len(selected)} probe(s), each construction REFUSED by the compiler")
    print("VERDICT: PASS")
    return 0


def _fail(message: str) -> int:
    print(f"FAIL: {message}", file=sys.stderr)
    print("VERDICT: FAIL")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
