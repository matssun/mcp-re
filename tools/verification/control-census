#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""ADR-MCPRE-069 — every executable control, and what claims it.

    tools/verification/control-census                # the human report
    tools/verification/control-census --json         # the same facts, machine-readable
    tools/verification/control-census --residue      # the undispositioned population
    tools/verification/control-census --gate         # a verdict, non-zero when it fails
    tools/verification/control-census --selftest     # prove the instrument can see

ADR-MCPRE-069's question is *which controls run and are claimed by nothing?* This states
the answer as a measurement over the current tree rather than as a transcribed count: the
626 in ADR-069 §2 was Rust-only, pre-ADR-068, and blind to doctests, Python, TypeScript and
gates, and using it as a worklist would run a campaign against a population that no longer
exists.

# What the gate refuses

Four things, and each is a way for a green census to be false rather than an aesthetic
preference:

  * a `tested_symbols` selector that resolves to NO control — a stale identity the lane's
    `--exact` selection would fail on, and a sign the enumerator lost a control kind;
  * a disposition row about a control that is claimed or has ceased to exist — ADR-069 D4
    says a registered control leaves the census, so such a row is the registry disagreeing
    with the tree;
  * a `not-evidence` row with no reason family, or a family with no durable record — D3
    requires the reason, and a reason nobody can look up is a word next to a symbol;
  * a `[[proposition]]` whose `ratified_as` does not resolve to a declared unit or theorem,
    names more than one owner, resolves to a theorem whose support closure reaches no
    claiming unit, or leaves any of its own controls still claimed by nothing. Until this
    check existed the field was declared and read by nobody: setting
    `ratified_as = "THM-9999-does-not-exist"` on all 169 rows produced ZERO failures and
    made the report print 169 resolved propositions. That is the same class as a
    `too-many-lines-threshold` parameterising an allow-by-default lint — a configuration
    key nothing reads — arriving inside this campaign's own headline metric.

It does NOT refuse a large unclaimed population. During the campaign that population is the
work; a gate that failed on it would only invite the bulk registration ADR-069 D2 exists to
forbid. `scripts/control_census_gate.py` holds that population against a per-file baseline
instead, so it can only shrink, and `--closure` states ADR-069's closure criterion —
residue zero AND no unresolved `[[proposition]]` — which is the release-time question and
not the merge-time one.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from collections import Counter
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _census import (  # noqa: E402
    DISPOSITION_KEYS,
    PROPOSITION_KEYS,
    RESIDUE_DECISIONS,
    census,
    propositions,
    raw_registry,
    units,
)
from _census import theorems as theorem_rows  # noqa: E402
from _controls import KINDS, REPO_ROOT  # noqa: E402

#: ADR-MCPRE-068 §4.1's severity vocabulary. A proposition's consequence is compared against
#: other propositions' and against the units it would become, so a word outside the
#: vocabulary is a claim about consequence nobody can compare.
SEVERITIES = ("medium", "high", "critical")

#: The durable register a `not-evidence` reason family points at. Same mechanism as
#: ADR-MCPRE-061 §14's `review_ref` — a named record in a committed document, checked for
#: existence — and a separate register because the authorities are separate: 061 adjudicates
#: oversized units, 069 adjudicates controls.
REGISTER = REPO_ROOT / "docs" / "architecture" / "control-dispositions.md"


def _record(anchor: str) -> str | None:
    """The register section for `anchor`, or None if the record does not exist."""
    if not REGISTER.is_file():
        return None
    text = REGISTER.read_text()
    found = re.search(rf"^##\s+{re.escape(anchor)}\b(.*?)(?=^## |\Z)", text, re.M | re.S)
    return found.group(1) if found else None


def failures(report) -> list[str]:
    out: list[str] = []
    for unit, project, selector in report.stale:
        out.append(f"stale selector: {unit} ({project}) names no control: {selector}")
    for row in report.orphan_dispositions:
        out.append(
            f"orphan disposition {row.id}: {row.project} {row.control} is claimed or absent"
        )
    for row in report.dispositions:
        if row.decision not in RESIDUE_DECISIONS:
            out.append(f"{row.id}: decision {row.decision!r} is not one of {RESIDUE_DECISIONS}")
        if row.decision == "not-evidence" and not row.reason_family:
            out.append(f"{row.id}: not-evidence with no reason_family (ADR-069 D3)")
        record = _record(row.reason_family) if row.reason_family else None
        if row.reason_family and record is None:
            out.append(f"{row.id}: reason family {row.reason_family} has no record in {REGISTER.name}")
        if row.decision == "new-proposition" and not row.proposition:
            out.append(f"{row.id}: new-proposition with no proposition id")
        out.extend(_scope_failures(row, record))
    entries = propositions()
    known = {entry["id"] for entry in entries}
    for row in report.dispositions:
        if row.proposition and row.proposition not in known:
            out.append(f"{row.id}: proposition {row.proposition} is not declared")
    ratified = ratification_by_entry(report, entries)
    for entry in entries:
        # A proposition with no durable record is the §5 step-1 half missing: the census
        # would report unresolved debt that states nothing about what is missing.
        if _record(entry["id"]) is None:
            out.append(f"{entry['id']}: no record in {REGISTER.name}")
        # An entry naming a VALID resolving owner cites its owner instead of its controls:
        # its rows all went when their controls were claimed, so requiring a citing row
        # would make the resolved state unreachable. It is not an escape — a bad
        # `ratified_as` fails above and does not exempt, and `--closure` still requires the
        # entry itself to be gone.
        if ratified[entry["id"]] or not entry.get("ratified_as"):
            if not any(row.proposition == entry["id"] for row in report.dispositions):
                out.append(f"{entry['id']}: declared and no control cites it")
    out.extend(problem for entry in entries for problem in ratified[entry["id"]])
    out.extend(_orphan_records(report, known))
    out.extend(_schema_failures())
    return out


def _schema_failures(raw: dict | None = None) -> list[str]:
    """Unknown keys and an unknown severity, which the registry's own header promises.

    The header says "Unknown keys are a validation failure: a typo in a disposition must not
    read as an absent one" — and until this check existed, the loader simply ignored them,
    so the file promised an enforcement it did not have. That is the class ADR-MCPRE-069's
    parent record exists about, arriving inside this campaign's own registry.
    """
    out: list[str] = []
    raw = raw_registry() if raw is None else raw
    for row in raw.get("disposition", []):
        for key in set(row) - DISPOSITION_KEYS:
            out.append(f"{row.get('id', '?')}: unknown key {key!r}")
    for entry in raw.get("proposition", []):
        for key in set(entry) - PROPOSITION_KEYS:
            out.append(f"{entry.get('id', '?')}: unknown key {key!r}")
        if entry.get("consequence") not in SEVERITIES:
            out.append(
                f"{entry.get('id', '?')}: consequence {entry.get('consequence')!r} is not "
                f"one of {SEVERITIES}"
            )
    return out


def _orphan_records(report, propositions: set[str]) -> list[str]:
    """A `##` record in the register that nothing declares.

    The other direction is checked above — a declaration must have a record. This is the
    one the repository has already been bitten by in a different register: *a dead row hides
    the next live one.* A reason family or proposition record nobody cites reads as part of
    the campaign's reasoning while adjudicating nothing, and the next reader cannot tell it
    from one that is load-bearing.
    """
    if not REGISTER.is_file():
        return []
    declared = propositions | {row.reason_family for row in report.dispositions if row.reason_family}
    found = set(re.findall(r"^## (NP-\d+|ND-\d+)", REGISTER.read_text(), re.M))
    return [f"{name}: a record in {REGISTER.name} that nothing declares" for name in sorted(found - declared)]


#: What a family record must say before a FILE-wide disposition may cite it. The same
#: idiom as ADR-MCPRE-061 §14's `growth-authorization:` — a literal a reviewer has to write,
#: so that carrier scope is a decision somebody took rather than a field somebody set.
CARRIER_SCOPE_TOKEN = "carrier-scope: admitted"


def _scope_failures(row, record: str | None) -> list[str]:
    """Whether this row's SCOPE is one its decision and its family admit."""
    if row.scope == "control":
        return [] if row.control else [f"{row.id}: control-scoped row names no control"]
    if row.scope != "carrier":
        return [f"{row.id}: scope {row.scope!r} is neither 'control' nor 'carrier'"]
    out: list[str] = []
    if not row.carrier:
        out.append(f"{row.id}: carrier-scoped row names no carrier")
    if row.decision != "not-evidence":
        out.append(
            f"{row.id}: {row.decision} may not be carrier-scoped — a proposition is a claim "
            "about named controls, and a file-wide one is a claim nobody read"
        )
    if record is not None and CARRIER_SCOPE_TOKEN not in record:
        out.append(
            f"{row.id}: family {row.reason_family} does not state '{CARRIER_SCOPE_TOKEN}'"
        )
    return out


#: `ratified_as` names the CANONICAL owner, and exactly one of them. A value carrying any
#: of these separators is trying to name several, and this field cannot: where a
#: proposition genuinely resolved through more than one owner, the per-control claims in
#: `verification.toml` carry the rest, and a second name here would be a second place the
#: same fact is written with nothing holding the two in agreement.
_SEVERAL_OWNERS = re.compile(r"[\s,;+]")


def _named_owner(entry: dict) -> tuple[str, list[str]]:
    """The single id `ratified_as` names, and the reasons it names no single id."""
    name = entry.get("id", "?")
    value = entry.get("ratified_as", "")
    if isinstance(value, list):
        return "", [f"{name}: ratified_as is a list — it names ONE canonical owner"]
    if not isinstance(value, str):
        return "", [f"{name}: ratified_as {value!r} is not a string"]
    if value and _SEVERAL_OWNERS.search(value):
        return "", [
            f"{name}: ratified_as {value!r} is not a single id — a separator or padding "
            "makes it resolve to nothing, and several owners may not be named here"
        ]
    return value, []


def _support_closure(theorem: str, index: dict[str, dict]) -> set[str]:
    """The units a theorem rests on — its own `supported_by`, and its premises' too.

    Transitive through `depends_on`, because a theorem may support its claim entirely
    through the theorems below it; stopping at the direct `supported_by` would report an
    honest composite claim as backed by nothing.
    """
    units: set[str] = set()
    seen: set[str] = set()
    pending = [theorem]
    while pending:
        current = pending.pop()
        if current in seen or current not in index:
            continue
        seen.add(current)
        units.update(str(uri).removeprefix("unit://") for uri in index[current].get("supported_by", []))
        pending.extend(str(dep) for dep in index[current].get("depends_on", []))
    return units


def _ratification_owners(
    entry: dict, value: str, unit_ids: set[str], index: dict[str, dict], claiming: set[str]
) -> tuple[set[str], list[str]]:
    """The units a resolved `ratified_as` puts in charge, or why it puts nobody in charge.

    A theorem EXISTING is not the check. ADR-069 §5 step 2 resolves a proposition through
    the ordinary theorem-architecture route, and a theorem whose support closure reaches no
    unit — or only units whose batteries select nothing — is a title, so a proposition
    pointing at one has moved its debt into a second registry rather than discharged it.
    """
    name = entry.get("id", "?")
    if value in unit_ids:
        return {value}, []
    if value not in index:
        return set(), [f"{name}: ratified_as {value!r} is neither a declared unit nor a theorem"]
    closure = _support_closure(value, index)
    if not closure:
        return set(), [f"{name}: theorem {value} has an empty support closure — it names no unit"]
    if not closure & claiming:
        return set(), [
            f"{name}: theorem {value}'s support closure claims no control at all: "
            f"{sorted(closure)}"
        ]
    return closure, []


def _entry_ratification(
    entry: dict, rows: list, claimants: dict, unit_ids: set[str], index: dict, claiming: set[str]
) -> list[str]:
    """Whether ONE proposition's `ratified_as` is a fact about the tree or a typed word."""
    value, problems = _named_owner(entry)
    if problems or not value:
        return problems
    owners, problems = _ratification_owners(entry, value, unit_ids, index, claiming)
    if problems:
        return problems
    cited = [row for row in rows if row.proposition == entry.get("id")
             and row.decision == "new-proposition"]
    unowned = [row for row in cited
               if not claimants.get((row.project, row.control), set()) & owners]
    if not unowned:
        return []
    # EVERY cited control, not one of them: a row survives only for a control nothing
    # claims, so an owner claiming 1 of 37 would read as owning the proposition while 36
    # controls it was written about still establish nothing anybody states.
    return [
        f"{entry.get('id', '?')}: ratified_as {value} owns "
        f"{len(cited) - len(unowned)} of {len(cited)} cited control(s); "
        f"{len(unowned)} remain(s) claimed by nothing"
    ]


def ratification_by_entry(
    report, entries: list[dict] | None = None,
    unit_ids: set[str] | None = None, theorems: list[dict] | None = None,
) -> dict[str, list[str]]:
    """Every proposition's `ratified_as` verdict, keyed by proposition id.

    Returned per entry rather than as a flat list because `failures()` needs the verdict
    per proposition, not merely its total: a proposition that has genuinely resolved is
    exempt from the "no control cites it" check, and an unresolved one is not.
    """
    entries = propositions() if entries is None else entries
    unit_ids = {unit["id"] for unit in units()} if unit_ids is None else unit_ids
    rows = theorem_rows() if theorems is None else theorems
    index = {str(row.get("id")): row for row in rows}
    claimants: dict[tuple[str, str], set[str]] = {}
    for claim in report.claims:
        claimants.setdefault((claim.control.project, claim.control.identity), set()).add(claim.unit)
    claiming = {claim.unit for claim in report.claims}
    return {
        entry.get("id", "?"): _entry_ratification(
            entry, report.dispositions, claimants, unit_ids, index, claiming
        )
        for entry in entries
    }


def closure_failures(report) -> list[str]:
    """ADR-069's closure criterion, stated as the things that would falsify it.

    Two populations, and both must be empty. The residue is the controls nothing claims
    and nothing has decided. The propositions are ADR-069 §5's other half: a `[[proposition]]`
    row IS unresolved assurance debt — step 1 identified it, step 2 has not happened — and a
    closure verdict that ignored 169 of them would state that the campaign had closed while
    its own registry still said otherwise. `--gate` deliberately does not require this:
    step 2 runs through theorem architecture, on its own timescale, and failing every merge
    on it would be pressure to widen an existing unit, which §5 forbids in terms.
    """
    return failures(report) + [
        f"undispositioned: {control.project} {control.identity}" for control in report.residue
    ] + [
        f"unresolved proposition: {entry['id']} {entry.get('title', '')}"
        for entry in propositions()
    ]


def to_json(report) -> dict:
    return {
        "controls": len(report.controls),
        "by_kind": report.by_kind(report.controls),
        "claimed": len(report.claimed),
        "unclaimed": len(report.unclaimed),
        "unclaimed_by_kind": report.by_kind(report.unclaimed),
        "dispositioned": len(report.dispositioned),
        "dispositions_by_decision": dict(
            Counter(row.decision for row in report.dispositions)
        ),
        "residue": len(report.residue),
        "stale_selectors": len(report.stale),
        "propositions": [
            {
                "id": entry["id"],
                "ratified_as": entry.get("ratified_as", ""),
                "likely_owner": entry.get("likely_owner", ""),
            }
            for entry in propositions()
        ],
    }


def human(report) -> None:
    print(f"controls {len(report.controls)}  claimed {len(report.claimed)}  "
          f"unclaimed {len(report.unclaimed)}")
    print()
    print(f"  {'kind':14} {'ecosystem':18} {'total':>7} {'claimed':>8} {'unclaimed':>10}")
    total = report.by_kind(report.controls)
    unclaimed = report.by_kind(report.unclaimed)
    for kind, ecosystem in KINDS.items():
        print(f"  {kind:14} {ecosystem:18} {total[kind]:>7} "
              f"{total[kind] - unclaimed[kind]:>8} {unclaimed[kind]:>10}")
    print()
    decided = Counter(row.decision for row in report.dispositions)
    for decision in RESIDUE_DECISIONS:
        print(f"  {decision:18} {decided.get(decision, 0)}")
    print(f"  {'undispositioned':18} {len(report.residue)}")
    print(f"  {'stale selectors':18} {len(report.stale)}")
    entries = propositions()
    if entries:
        print()
        print("new propositions:")
        for entry in entries:
            landed = entry.get("ratified_as") or "unresolved"
            print(f"  {entry['id']:8} {landed:12} {entry.get('title','')}")


def residue_report(report) -> None:
    """The undispositioned population, grouped by carrier — the campaign's worklist.

    Grouped by FILE rather than listed flat, because a disposition batch is a semantic
    owner's controls and the file is the nearest cheap proxy for one; a flat list of 2,445
    identities invites exactly the regex-shaped batching ADR-069 D2 refuses.
    """
    groups: dict[str, list] = {}
    for control in report.residue:
        groups.setdefault(control.carrier, []).append(control)
    for carrier, controls in sorted(groups.items(), key=lambda kv: (-len(kv[1]), kv[0])):
        print(f"{len(controls):>4}  {carrier}")


def selftest() -> int:
    """Prove the instrument can SEE — one positive scope check per supported ecosystem."""
    import test_controls

    return test_controls.run()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--residue", action="store_true")
    parser.add_argument("--gate", action="store_true")
    parser.add_argument("--closure", action="store_true")
    parser.add_argument("--selftest", action="store_true")
    args = parser.parse_args()
    if args.selftest:
        return selftest()
    report = census()
    if args.json:
        print(json.dumps(to_json(report), indent=2))
        return 0
    if args.residue:
        residue_report(report)
        return 0
    if args.gate or args.closure:
        problems = closure_failures(report) if args.closure else failures(report)
        shown = problems[:40]
        for problem in shown:
            print(f"  {problem}")
        if len(problems) > len(shown):
            print(f"  … and {len(problems) - len(shown)} more")
        verdict = "PASS" if not problems else f"FAIL ({len(problems)} problem(s))"
        print(f"CONTROL CENSUS{' CLOSURE' if args.closure else ''}: {verdict}")
        return 0 if not problems else 1
    human(report)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
