#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Build, identify, preserve, and load the ADR-MCPRE-059 extraction container.

The image's identity is a function of the TOOLCHAIN IT CONTAINS, never of the product
release in VERSION. Both directions of that choice matter:

  * tagging it from VERSION would rebuild it on every release, mint a new digest with an
    unchanged prover, and invalidate every piece of formal evidence in the repository for
    no reason (Case F churn);
  * a toolchain bump between releases would leave the tag unmoved, which is a mutable tag
    pointing at a DIFFERENT prover — the failure the digest pin exists to prevent.

So the tag is derived from the pinned inputs, and the lock file pins the digest. Two
checkouts with the same pins compute the same tag; changing any pin changes it.

  tools/verification/extraction-image tag       # the tag the declared inputs compute to
  tools/verification/extraction-image build     # build it (arm64)
  tools/verification/extraction-image identity  # build + preserve + print the lock entry
  tools/verification/extraction-image verify    # the pinned artifact is here, and intact
  tools/verification/extraction-image load      # ensure it is loaded; print the image id

THERE IS NO REGISTRY IN THIS PATH. The assurance requirement is that Lean evidence names
the environment that produced it and is invalidated when that environment changes, and a
content digest does that whether the bytes sit in a local image store or a registry. The
lane runs on one self-hosted runner and no proposition claims cross-machine reproduction,
so publishing would add a distribution mechanism nothing asks for. Ruling:
verification/reviews/rulings/extraction-artifact-storage-2026-09-09.md.

BUT A DIGEST IS IDENTITY, NOT PRESERVATION. The local image store is disposable, and this
image cannot be rebuilt — apt and opam resolve versions nothing pins, and the opam
libraries are linked into the Aeneas binary, so a rebuild is a different instrument. An
identity over bytes a prune can delete leaves a claim that is still identifiable and no
longer reproducible. So `identity` also PERSISTS the artifact outside Docker's state,
under its own digest, and `load` is what every consumer runs: it checks the preserved bytes
and hands back an image id, never a tag. See `_extraction_artifact`.

The platform is linux/arm64 because the consumer is a self-hosted Apple Silicon runner.
An amd64 build of the same pins is a DIFFERENT image with a different digest, and the lock
file records one platform for that reason.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _extraction_artifact import (  # noqa: E402
    artifact_path,
    file_digest,
    preservation,
    record_problems,
    store_root,
)
from _extraction_identity import content_tag  # noqa: E402
from _extraction_identity import definition_digest  # noqa: E402
from _manifest import ManifestError, load_toolchains  # noqa: E402

REPO = Path(__file__).resolve().parent.parent.parent
DOCKERFILE = REPO / "verification" / "extraction" / "Dockerfile"
PLATFORM = "linux/arm64"

# A LOCAL reference, with no registry host. Not `mcp-re-<something>:<semver>` either:
# scripts/deploy_image_tag_gate.py requires any literal semver tag on an mcp-re-* image to
# equal VERSION, and this image must NOT track VERSION — the content tag keeps it outside
# that rule by construction rather than by exemption.
DEFAULT_IMAGE = "mcp-re-verification-extraction"


# The identity function lives in `_extraction_identity` so the PUBLISHER and the VALIDATOR
# cannot disagree about it. They did not disagree — nothing validated at all, which is how a
# pin came to name an image built from a Dockerfile the tree had replaced.


def _run(cmd: list[str], *, capture: bool = True) -> str:
    """Run a command, failing loudly on non-zero.

    Status is taken from the process itself, never from a shell pipeline: a pipeline
    reports its last stage, so a failed build can exit 0 and be recorded as a good one.

    `capture=False` streams instead, for the two commands that take minutes and whose
    progress is the only sign they are alive.
    """
    completed = subprocess.run(cmd, text=True, capture_output=capture, check=False)
    if capture:
        sys.stderr.write(completed.stderr)
    if completed.returncode != 0:
        raise SystemExit(f"FAIL: {' '.join(cmd[:3])}… exited {completed.returncode}")
    return (completed.stdout or "").strip()


# ---------------------------------------------------------------------------
# The smoke checks
# ---------------------------------------------------------------------------
#
# AN IMAGE THAT BUILDS IS NOT AN IMAGE THAT WORKS. The image pinned on 2026-08-30 built
# fine and could not run Lean at all, and the lane pinned to it reported nothing wrong for
# four weeks. Each check below is one thing a measurement found missing, asked directly.
#
# THEY LIVE HERE RATHER THAN IN THE BUILD WORKFLOW because they answer a question a
# RECEIVING host has too. The artifact is preserved on the machine that built it and moved
# to others by hand, and a host that has just been handed 5.6 GiB needs to establish that
# what it received works — without rebuilding, since a rebuild of this definition is a
# different instrument. As workflow steps they could only ever be asked on the build path.
#
# Every check runs against an IMAGE ID, never a tag, for the same reason the lane does: a
# tag resolves through the local image cache, and the cache is the thing that is not the
# evidence store.


def _smoke(image: str, toolchains: dict) -> None:
    lean_pin = str(toolchains["lean"]["toolchain"])
    want_lean = lean_pin.rsplit(":v", 1)[-1]
    mathlib = str(toolchains["aeneas_lean_backend"]["mathlib_revision"])

    # FIRST, because every check below runs a tool this image has to be able to start. The
    # lane's own entry points are Python and they run INSIDE the image; the first real run
    # of the pipeline answered `/usr/bin/env: 'python3': No such file or directory`, and
    # every check that had passed above it was about a COMPONENT rather than the harness.
    # `tomllib` rather than a version: what the scripts need is the module they parse the
    # toolchain lock with.
    print("smoke: the image can run the lane's own entry points")
    _run(["docker", "run", "--rm", image, "python3", "-c",
          "import tomllib, json, hashlib; print('harness interpreter ok')"])

    print(f"smoke: Lean is the pinned {lean_pin}")
    got = _run(["docker", "run", "--rm", image, "lean", "--version"])
    if f"version {want_lean}," not in got:
        raise SystemExit(f"FAIL: image Lean is {got!r}, not the pinned {lean_pin}")
    print(f"  {got}")

    # Sources without a `.lake/build` is the state the 2026-08-30 measurement found:
    # nothing elaborates against a library that was never compiled.
    #
    # `bash -c`, NEVER `bash -lc`. A login shell sources /etc/profile, which on Debian sets
    # PATH unconditionally for root — discarding the image's own ENV PATH before anything
    # runs. Checks whose paths are all absolute survive that; the ones below do not.
    print("smoke: the Aeneas Lean backend is BUILT, not merely present")
    _run(["docker", "run", "--rm", image, "bash", "-c",
          "test -d /opt/aeneas/backends/lean/.lake/build"])

    print(f"smoke: mathlib is resolved at {mathlib[:12]}")
    manifest = _run(["docker", "run", "--rm", "--entrypoint", "cat", image,
                     "/opt/aeneas/backends/lean/lake-manifest.json"])
    got_rev = next(
        p["rev"] for p in json.loads(manifest)["packages"] if p["name"] == "mathlib"
    )
    if got_rev != mathlib:
        raise SystemExit(f"FAIL: image mathlib is {got_rev}, the lock records {mathlib}")

    # `--help`/`-help`, not `--version`: the pinned Charon is a subcommand CLI and rejects
    # `--version`. The proposition is that both binaries EXECUTE.
    print("smoke: Charon and Aeneas execute")
    _run(["docker", "run", "--rm", image, "bash", "-c",
          '"$CHARON_EXE" --help >/dev/null && "$AENEAS_EXE" -help >/dev/null'])

    # End to end in miniature. Each check above proves one component answers; only this
    # proves they compose. `--preset=aeneas` is mandatory — without it Aeneas refuses the
    # LLBC outright — and at this pin it is an option of the `cargo` SUBCOMMAND.
    print("smoke: a tiny crate extracts and Aeneas emits Lean")
    _run(["docker", "run", "--rm", image, "bash", "-c", TINY_CRATE], capture=False)
    print("smoke: PASS — six check(s)")


#: Rust -> LLBC -> Lean, on a crate small enough that the whole thing is one step.
TINY_CRATE = """
set -euo pipefail
mkdir -p /tmp/smoke/src && cd /tmp/smoke
printf '[package]\nname = "smoke"\nversion = "0.0.0"\nedition = "2021"\n[lib]\npath = "src/lib.rs"\n' > Cargo.toml
printf 'pub fn double(x: u32) -> u32 { x.wrapping_add(x) }\n' > src/lib.rs
"$CHARON_EXE" cargo --preset=aeneas --dest-file /tmp/smoke/smoke.llbc 2>&1 \
  || { rc=$?; echo "charon exited $rc — the output above is the whole diagnostic"; exit "$rc"; }
"$AENEAS_EXE" -backend lean -dest /tmp/smoke/out /tmp/smoke/smoke.llbc
echo "emitted: $(ls /tmp/smoke/out)"
"""


def _preserve(ref: str, image: str) -> str:
    """Persist this image's exact bytes outside Docker's state; return the archive digest.

    Written through a staging file in the store's own directory and renamed into place,
    never at the content-addressed path directly. A digest-named file must be either absent
    or complete: an interrupted save at the final path would leave a truncated artifact
    under a valid identity, which is the one state the addressing exists to make impossible.
    """
    root = store_root()
    (root / "sha256").mkdir(parents=True, exist_ok=True)
    final = artifact_path(image, root)
    with tempfile.NamedTemporaryFile(
        dir=root / "sha256", prefix=".incoming-", suffix=".tar", delete=False
    ) as handle:
        staging = Path(handle.name)
    try:
        print(f"preserving {ref} ({image[:19]}…) → {final}")
        _run(["docker", "save", "-o", str(staging), ref], capture=False)
        digest = file_digest(staging)
        if final.exists():
            # Content-addressed by the IMAGE, so an existing file claims to be this same
            # image's preserved form. Whether it IS is a question about bytes, and it is
            # asked rather than assumed: a stale or truncated file here would otherwise be
            # kept in preference to the one just produced.
            if file_digest(final) == digest:
                print("already preserved, byte-identical")
                return digest
            print("replacing a preserved file that does not match this save")
        staging.replace(final)
    finally:
        if staging.exists():
            staging.unlink()
    # Read back from the store rather than trusting the digest of the staging file: what
    # the lock will record has to be what a later run will measure, and those are the same
    # bytes only if the rename actually produced them.
    return file_digest(final)


def _verify(toolchains: dict) -> int:
    """Whether the pinned artifact is here and intact. EVERY line of it goes to stderr.

    `load` calls this, and `load`'s stdout is an image id a caller substitutes straight into
    `docker run`. A report on stdout would be read as part of that id — measured: it produced
    `docker: invalid reference format` on the first real run of the lane. So the rule is not
    "be tidy", it is that this tool has exactly one thing to say on stdout and every other
    line belongs on stderr.
    """
    problems = record_problems(toolchains)
    for problem in problems:
        print(f"FAIL: {problem}", file=sys.stderr)
    if problems:
        return 1
    state = preservation(toolchains)
    if state is None:
        print(
            "extraction-image: the container pin is unresolved; nothing to preserve yet",
            file=sys.stderr,
        )
        return 0
    if state.usable:
        print(f"PRESENT: {state.path}", file=sys.stderr)
        entry = toolchains["extraction_container"]
        print(f"  image:   {entry['artifact_digest']}", file=sys.stderr)
        print(f"  archive: {entry['archive_digest']}", file=sys.stderr)
        return 0
    # ABSENT and MISMATCH both exit non-zero here because this action is an operator asking
    # a direct question. The LANE keeps them apart, because there UNAVAILABLE and FAIL are
    # different verdicts with different remedies.
    print(f"{state.status}: {state.detail}", file=sys.stderr)
    return 1


def _resolve_preserved(toolchains: dict) -> str | None:
    """Make the PRESERVED artifact executable here and return the image id, printing none.

    An id, never a tag. A tag resolves through the local image store, which is the thing
    that is not the evidence store: a same-tag entry from another build would run silently.

    SEPARATE FROM `_load` so that `load`'s stdout contract stays `load`'s. Two callers want
    this resolution and only one of them is handing an id to a shell — `smoke` printed
    `load`'s line into the middle of its own report until they were split.
    """
    if _verify(toolchains) != 0:
        return None
    state = preservation(toolchains)
    if state is None or not state.usable:
        return None
    image = str(toolchains["extraction_container"]["artifact_digest"])
    if not _present(image):
        print(f"loading {state.path}", file=sys.stderr)
        _run(["docker", "load", "-i", str(state.path)], capture=False)
    if not _present(image):
        print(
            f"FAIL: loading {state.path} did not produce image {image}. The preserved "
            "archive does not contain the pinned image, so nothing here can execute the "
            "pinned environment.",
            file=sys.stderr,
        )
        return None
    return image


def _load(toolchains: dict) -> int:
    """`_resolve_preserved`, with the id on stdout for a caller to substitute."""
    image = _resolve_preserved(toolchains)
    if image is None:
        return 1
    # THE ONE LINE THIS TOOL PUTS ON STDOUT.
    print(image)
    return 0


def _image_id(ref: str) -> str:
    """The image id docker reports for a reference."""
    return _run(["docker", "image", "inspect", ref, "--format", "{{.Id}}"])


def _present(ref: str) -> bool:
    return (
        subprocess.run(
            ["docker", "image", "inspect", ref], capture_output=True, check=False
        ).returncode
        == 0
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "action", choices=["tag", "build", "identity", "verify", "load", "smoke"]
    )
    parser.add_argument("--image", default=DEFAULT_IMAGE)
    parser.add_argument(
        "--built",
        action="store_true",
        help=(
            "smoke: check the image this checkout's pins BUILD to, rather than the "
            "preserved artifact the lock pins. The build path wants the first — nothing is "
            "pinned to it yet; a receiving host wants the second."
        ),
    )
    args = parser.parse_args()

    try:
        toolchains = load_toolchains()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    ref = f"{args.image}:{content_tag(toolchains)}"

    if args.action == "tag":
        print(ref)
        return 0
    if args.action == "verify":
        return _verify(toolchains)
    if args.action == "load":
        return _load(toolchains)
    if args.action == "smoke":
        # TWO SUBJECTS, because there are two moments this question is asked. On the build
        # path nothing is pinned to the new image yet, so the subject is the tag this
        # checkout computes. On a host that has just been handed an artifact the subject is
        # the PRESERVED one, resolved and loaded exactly as the lane resolves it — which is
        # what makes a transferred artifact verifiable without rebuilding.
        if args.built:
            if not _present(ref):
                print(f"FAIL: {ref} is not present; run `build`.", file=sys.stderr)
                return 1
            subject = _image_id(ref)
        else:
            resolved = _resolve_preserved(toolchains)
            if resolved is None:
                return 1
            subject = resolved
        print(f"smoke: subject {subject}")
        _smoke(subject, toolchains)
        return 0

    _run([
        "docker", "buildx", "build",
        "--platform", PLATFORM,
        # NO PROVENANCE ATTESTATION. buildx attaches one by default, it carries a build
        # TIMESTAMP, and it goes into the manifest list — so re-exporting identical cached
        # layers mints a DIFFERENT image id. Measured: `build` produced b119609d and the
        # `identity` that followed it produced 789de80d from the same cache, which meant the
        # artifact the smoke checks ran against was not the artifact being preserved. An
        # identity that changes when nothing did cannot be an evidence identity.
        "--provenance=false",
        "-t", ref,
        "--load",
        str(DOCKERFILE.parent),
    ], capture=False)
    print(f"\nbuilt: {ref}")

    if args.action == "identity":
        # The image's OWN content digest. `docker inspect .Id` is a digest over the image
        # config, which commits to every layer, so it identifies these bytes exactly as a
        # registry manifest digest does — and it exists without one.
        artifact = _run(["docker", "image", "inspect", ref, "--format", "{{.Id}}"])
        # PERSISTED before it is reported, and the order is the mechanism: a lock entry
        # naming an image that exists only in Docker's cache is an identity a prune can
        # orphan. What is recorded below is what the store holds.
        archive = _preserve(ref, artifact)
        print(f"artifact_digest: {artifact}")
        print(f"archive_digest:  {archive}")
        print("\nRecord in verification/policy/toolchains.lock.toml:")
        print("\n  [extraction_container]")
        print('  state = "resolved"')
        print(f'  artifact_digest = "{artifact}"')
        print(f'  archive_digest = "{archive}"')
        print(f'  tag = "{content_tag(toolchains)}"')
        # Printed WITH the artifact digest, because the two are one fact: this image is a
        # build of THIS definition. Recording one without the other is the state the lock
        # was in for four weeks — a pin that could not be checked against anything, and
        # that went on naming an old image through three Dockerfile changes.
        print(f'  definition_digest = "{definition_digest()}"')
        print(f'  platform = "{PLATFORM}"')
        print('  definition = "verification/extraction/Dockerfile"')
        print("\nTranscribe it exactly. The artifact digest, the archive digest and the")
        print("definition digest are one evidence-identity fact and must travel together.")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
