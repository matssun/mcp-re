#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Which units a change affects — the scope of a merge check's verification run.

    tools/verification/select-units --base REF --out FILE [--lane NAME] [--max-units N]
                                    [--github-output]

A unit is AFFECTED when its fingerprint at HEAD differs from its fingerprint at `--base`
(or it is new), and so is every unit that consumes an affected one over a prerequisite
edge. The fingerprint is the platform's own statement of everything a unit's evidence
depends on — its sources, its declared batteries and probes, the lane code that measures
it, the toolchains — so "the fingerprint moved" is exactly "the evidence no longer
describes this unit". The consumer closure is taken because a consumer may not be issued
over a producer whose evidence is unknown; it is not narrowed by sealed edges, which is
the conservative direction.

A MERGE CHECK NEVER RUNS EVERYTHING. It answers inside the CI time budget, and the
complete verification runs weekly, at release and on dispatch (the workflows call it
without `--units-file`). So when a scope cannot be trusted or cannot fit the budget, the
check is DEFERRED to that complete run, and says so, rather than widened to it:

  * the change touches the verification platform itself (`tools/verification/`) or the
    workflows that run it — a scope computed by a changed instrument is not trusted, and
    the platform's own self-tests, which the unconditional CI runs, are what check it;
  * the scope exceeds `--max-units` (a change to widely shared code, or to anything every
    fingerprint reads);
  * the scope cannot be computed.

The base tree is fingerprinted by ITS OWN tools, in a temporary worktree, so both sides
are measured by the instrument that describes them. A change to that instrument defers,
so the two instruments are the same whenever a scope is produced.

Output: FILE holds the affected unit ids, one per line (empty when nothing moved or the
check is deferred). The mode is `scoped` or `deferred`.

`--lane NAME` narrows the ids to the affected units that lane is REQUIRED for, read from
the composer's own `requirements` — the form a single lane's `--unit` accepts. It is for a
workflow that runs one lane on its own (`mutation-probe.yml`); `verify --units-file` does
this narrowing per lane itself.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _compose import FORMAL_LANES, requirements  # noqa: E402
from _evidence import PREREQUISITE_KINDS  # noqa: E402
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    load_assumptions,
    load_toolchains,
    load_verification,
)

#: A changed path under any of these defers the check to the complete run. The platform's
#: own code decides what every verdict means, so a scope computed by a changed instrument
#: is not trusted.
PLATFORM_PREFIXES = (
    "tools/verification/",
    ".github/workflows/verification.yml",
    ".github/workflows/mutation-probe.yml",
)


def changed_paths(base: str) -> list[str]:
    completed = subprocess.run(
        ["git", "-C", str(REPO_ROOT), "diff", "--name-only", base, "HEAD"],
        capture_output=True, text=True, check=True,
    )
    return [line for line in completed.stdout.splitlines() if line]


#: The largest scope a merge check measures. Measured 2026-09-25: 14 units took the
#: verification job 7-11 minutes, most of it fixed setup; the complete run of 245 units
#: took 95. A larger scope is deferred to the weekly / release run.
DEFAULT_MAX_UNITS = 20


def platform_change(paths: list[str]) -> str | None:
    hits = sorted(p for p in paths if p.startswith(PLATFORM_PREFIXES))
    if hits:
        return f"the change touches the verification platform: {', '.join(hits[:5])}"
    return None


def fingerprints(root: Path) -> dict[str, str]:
    """Every unit's fingerprint, measured by the tools checked out under `root`."""
    completed = subprocess.run(
        [sys.executable, str(root / "tools" / "verification" / "fingerprint")],
        cwd=root, capture_output=True, text=True, check=True,
    )
    return {row["unit_id"]: row["fingerprint"] for row in json.loads(completed.stdout)}


def base_fingerprints(base: str) -> dict[str, str]:
    """The base tree's fingerprints, from a throwaway worktree that is always removed."""
    with tempfile.TemporaryDirectory(prefix="mcp-re-select-") as scratch:
        tree = Path(scratch) / "base"
        subprocess.run(
            ["git", "-C", str(REPO_ROOT), "worktree", "add", "--detach", "--quiet",
             str(tree), base],
            capture_output=True, text=True, check=True,
        )
        try:
            return fingerprints(tree)
        finally:
            subprocess.run(
                ["git", "-C", str(REPO_ROOT), "worktree", "remove", "--force", str(tree)],
                capture_output=True, text=True, check=False,
            )


def moved(base: dict[str, str], head: dict[str, str]) -> set[str]:
    """Units new at HEAD or whose fingerprint differs from the base's."""
    return {unit_id for unit_id, fp in head.items() if base.get(unit_id) != fp}


def consumer_closure(units: set[str], edges: list[dict]) -> set[str]:
    """`units` plus every unit that consumes one of them over a prerequisite edge."""
    closure = set(units)
    grew = True
    while grew:
        grew = False
        for edge in edges:
            if edge.get("kind") in PREREQUISITE_KINDS and edge["from"] in closure:
                if edge["to"] not in closure:
                    closure.add(edge["to"])
                    grew = True
    return closure


def select(base: str, max_units: int = DEFAULT_MAX_UNITS) -> tuple[str, set[str], str]:
    """(mode, units, explanation): mode is `scoped` or `deferred`."""
    later = "; verified by the weekly / release run instead"
    try:
        reason = platform_change(changed_paths(base))
        if reason:
            return "deferred", set(), reason + later
        head = fingerprints(REPO_ROOT)
        before = base_fingerprints(base)
        edges = load_verification().get("edge", [])
    except (subprocess.CalledProcessError, OSError, ValueError, KeyError, ManifestError) as exc:
        detail = getattr(exc, "stderr", "") or str(exc)
        return "deferred", set(), f"the scope could not be computed ({detail.strip()[:300]})" + later
    changed = moved(before, head)
    affected = consumer_closure(changed, edges)
    if len(affected) > max_units:
        return (
            "deferred",
            set(),
            f"{len(affected)} of {len(head)} units are affected, more than a merge check "
            f"measures (--max-units {max_units})" + later,
        )
    return (
        "scoped",
        affected,
        f"{len(changed)} unit(s) changed fingerprint, {len(affected) - len(changed)} more "
        f"consume one of them; {len(affected)} of {len(head)} in scope",
    )


def required_of(lane: str, units: set[str]) -> set[str]:
    """The units among `units` that `lane` is required for."""
    required = requirements(load_verification(), load_toolchains(), load_assumptions())
    return {r.unit_id for r in required if r.lane == lane and r.unit_id in units}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--base", required=True, help="the commit the change is measured against")
    parser.add_argument("--out", required=True, type=Path, help="file to write the unit ids to")
    parser.add_argument(
        "--max-units", type=int, default=DEFAULT_MAX_UNITS,
        help=f"defer a scope larger than this (default {DEFAULT_MAX_UNITS})",
    )
    parser.add_argument(
        "--lane", choices=sorted(FORMAL_LANES),
        help="keep only the affected units this lane is required for",
    )
    parser.add_argument(
        "--github-output", action="store_true",
        help="also write mode= and count= to $GITHUB_OUTPUT",
    )
    args = parser.parse_args()

    mode, units, why = select(args.base, args.max_units)
    if args.lane and mode == "scoped":
        affected = len(units)
        units = required_of(args.lane, units)
        why += f"; {len(units)} of those {affected} owe the {args.lane} lane evidence"
    args.out.write_text("".join(f"{unit_id}\n" for unit_id in sorted(units)), encoding="utf-8")
    print(f"select-units: {mode} — {why}")
    for unit_id in sorted(units):
        print(f"    {unit_id}")
    if args.github_output and os.environ.get("GITHUB_OUTPUT"):
        with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as handle:
            handle.write(f"mode={mode}\ncount={len(units)}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
