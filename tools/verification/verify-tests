#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""The test-evidence lane — ADR-MCPRE-059 §2, §9.

Class V0 is "ordinary code: tests/conformance + Security Review Funnel". That sentence was
policy with no executable half: units declared `test://` evidence, no lane resolved it, and
`attest` refused every one of them for want of a record. The refusal was correct — absence
of measurement is not measurement — but it was permanent, because nothing could ever supply
the measurement it was waiting for. This lane is that half.

**A `test://` URI is a claim, and a claim must resolve to something that runs.** The URI
names a battery; `tested_symbols` names the battery's members. The lane selects exactly
those, by `--exact`, and both directions are gated:

  * a declared symbol that does not run is a FAIL, so deleting or renaming a test breaks
    the lane instead of quietly shrinking the evidence behind a green unit;
  * a symbol that runs but is `ignored` or `failed` is a FAIL, because a test that did not
    execute establishes nothing a test which did not exist would not also establish.

The selection is counted, never assumed. `--exact` matching nothing prints `running 0
tests` and exits 0, which is this repository's standing hazard — a command exiting 0 having
measured nothing is worse than a red one — so the lane compares the symbols that reported
`ok` against the symbols declared and refuses on any difference.

**A symbol names its target, because a test property includes the target the test exists
in.** `lib#path::to::test` and `tests/dispatch_test#some_test` are different claims even
when the test names match, and a battery that spans both is run as two selections rather
than one hopeful filter. A target whose file is feature-gated compiles to zero tests
without its feature; that is not a quiet pass here, it is the missing-symbol failure above.

The unit's `features` are NOT passed to Cargo. They name the specification feature carrying
the prover's text (`verify`), which is off in every production build and pulls in vstd;
running the battery under it would measure a different crate than the one that ships.

`test_features` is the other field and the opposite case: the SHIPPING features a unit's
controls are compiled by. A credential-egress control behind `#[cfg(feature =
"aws_kms_keysource")]` does not exist in the default lane, so a unit whose claim is about
credential egress and whose battery runs without the feature is measuring the part of its
own claim that happens to be unconditional. Declaring the features runs the battery where
the controls exist; the fingerprint carries them, so dropping one is a change of what was
measured rather than a quiet reduction of it. `_manifest` refuses the two fields to
overlap.

Like the Verus lane, the fingerprint is taken BEFORE the tests run and travels with the
record, so the issuer can tell "these tests passed over this source" from "these tests
passed over some source".
"""

from __future__ import annotations

import re
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _ecosystems import CARGO  # noqa: E402
from _ecosystems import RUNTIME_PROBES  # noqa: E402
from _ecosystems import ReportUnreadable  # noqa: E402
from _ecosystems import parse_results  # noqa: E402
from _ecosystems import test_argv  # noqa: E402
from _ecosystems import unit_ecosystem  # noqa: E402
from _ecosystems import valid_target  # noqa: E402
from _evidence import EvidenceRecord, write_record  # noqa: E402
from _fingerprint import fingerprint_unit  # noqa: E402
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    claims_test_evidence,
    load_assumptions,
    load_toolchains,
    load_verification,
    test_package_for,
)

EVIDENCE_STORE = REPO_ROOT / ".verification" / "evidence"

# The per-runner result syntax — including the libtest false-RED lesson that decided where
# the status is read from — lives in `_ecosystems.parse_results`, so that one rule about
# what a reported status MEANS is applied to every ecosystem the platform adapts.

#: A DOCTEST's result line, whose name contains spaces and a line number:
#: `test src/verified_response.rs - verified_response::VerifiedMcpResponse (line 82) - compile fail ... ok`
DOC_RESULT_LINE = re.compile(r"^test (.+?) \.\.\. (\w+)$", re.MULTILINE)

#: Separates a symbol's target from its path. `#` cannot occur in a Rust path, so the split
#: is unambiguous and a symbol that omits the target is malformed rather than defaulted —
#: defaulting it would let a moved test keep reporting under the target it left.
TARGET_SEP = "#"


def unit_crate(unit: dict) -> str | None:
    """The project whose targets carry this unit's tests, or None.

    Delegates to the manifest's `test_package_for`, which is the ONE answer: the lane runs
    the battery in this project and the ReviewFingerprint records this project as what was
    measured, so a second implementation here could let the two disagree. Which build system
    a project belongs to is `_ecosystems`' answer (issue #745), not this lane's.
    """
    return test_package_for(unit)


def doc_matches(observed: dict[str, str], item: str) -> list[str]:
    """The doctest result names belonging to `item`.

    A doctest's reported name embeds the LINE it starts on, so an exact symbol would break
    on any edit above it — churn that says nothing about the property. The symbol therefore
    names the ITEM (`doc#verified_response::VerifiedMcpResponse`) and this matches the
    item's doctests as a battery, which is what a `test://` URI means everywhere else.
    Zero matches is still a failure: a renamed or deleted control must break the lane.
    """
    return [name for name in observed if f" - {item} (line " in name]


def group_by_target(eco, symbols: list[str]) -> tuple[dict[str, list[str]], list[str]]:
    """Split `<target>#<path>` symbols into per-target selections, and the malformed ones.

    Which target names are runnable is the ECOSYSTEM's answer. A symbol naming a target its
    ecosystem does not run is malformed rather than skipped: a selector nothing executes is
    a declared control that establishes nothing, and the lane refuses on it in both
    directions already.
    """
    grouped: dict[str, list[str]] = defaultdict(list)
    malformed: list[str] = []
    for symbol in symbols:
        target, _, path = symbol.partition(TARGET_SEP)
        if not path or not valid_target(eco, target):
            malformed.append(symbol)
            continue
        grouped[target].append(path)
    return dict(grouped), malformed


def _rerun_unread(
    eco, crate: str, target: str, names: list[str], features: list[str],
    runtime: str | None = None,
) -> set[str]:
    """Re-run `names` ONE AT A TIME and return those that reported `ok` on their own.

    One at a time on purpose: a batch re-run can interleave the same way the first run did,
    and would then report the same unreadable line for a different member. Alone, a test's
    result line has nothing to interleave with except its own child process — and if that
    still happens, the symbol stays missing and the lane still fails.

    This admits only a FRESH `ok`. It does not carry anything over from the first run, and a
    test that fails or is ignored in isolation is reported from this run rather than from
    the one whose output could not be read.
    """
    recovered: set[str] = set()
    for name in names:
        again = subprocess.run(
            test_argv(eco, crate, target, [name], features, runtime),
            cwd=REPO_ROOT if eco is CARGO else REPO_ROOT / crate,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            check=False,
        )
        try:
            fresh = parse_results(eco, again.stdout)
        except ReportUnreadable:
            fresh = {}
        if again.returncode == 0 and fresh.get(name) == "ok":
            recovered.add(name)
    return recovered


def run_selection(
    eco,
    crate: str,
    target: str,
    paths: list[str],
    features: list[str] | None = None,
    runtime: str | None = None,
) -> tuple[bool, str]:
    """Run exactly `paths` in one target and say whether all of them passed.

    `check=False` and the runner's own per-test status: piping the run through anything
    replaces its exit code with the pipeline's, which is how a failed test reads as a
    success. The COMMAND and the report syntax are the ecosystem's; the rule applied to the
    result is this lane's and is one rule — a declared symbol that did not report success
    is a failure, whether it failed, was skipped, or never ran.
    """
    features = list(features or [])
    argv = test_argv(eco, crate, target, paths, features, runtime)
    proc = subprocess.run(
        argv,
        # Cargo is driven from the workspace root with `-p`; a pytest or vitest selection is
        # relative to its own project, which is where its configuration lives.
        cwd=REPO_ROOT if eco is CARGO else REPO_ROOT / crate,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if eco is CARGO and target == "doc":
        observed = dict(DOC_RESULT_LINE.findall(proc.stdout))
        missing = []
        for item in paths:
            names = doc_matches(observed, item)
            if not names:
                missing.append(f"{item} (no doctest reported for this item)")
            else:
                missing += [f"{item} ({observed[n]})" for n in names if observed[n] != "ok"]
        if missing:
            return False, (
                f"{target}: {len(missing)} declared doctest(s) did not pass: "
                + ", ".join(missing)
            )
        if proc.returncode != 0:
            return False, (
                f"{target}: every declared doctest passed but the run exited "
                f"{proc.returncode}; the target did not complete"
            )
        return True, f"{target}: {len(paths)} item(s) passed"

    try:
        observed = parse_results(eco, proc.stdout)
    except ReportUnreadable as unreadable:
        # Not "the controls failed" — the lane could not read the runner. Reported as its
        # own failure, with what the runner said, because presenting an unread report as a
        # battery of controls that never ran states something false about every one of them.
        return False, f"{target}: {unreadable}"
    passed = {name for name, status in observed.items() if status == "ok"}
    missing = sorted(set(paths) - passed)
    if missing:
        # A symbol with NO line at all is the one case that can be a reading failure rather
        # than a test failure, and the failure is this lane's own. A test that spawns a child
        # process — or any code writing to the real fd 2 rather than to the capture buffer —
        # can land bytes carrying a NEWLINE between the harness's `test <name> ... ` and its
        # status, and the result line then does not exist to be read. That is deliberately a
        # loud red rather than a quiet green, and it has fired on a deterministic control
        # (`audit_sink::tests::the_collector_preserves_emission_order`, twice).
        #
        # Re-measuring is not believing it. The symbol is RUN AGAIN, alone, and only its own
        # fresh result is admitted: a test that fails in isolation still fails, and one that
        # is genuinely absent still reports nothing. What this removes is a red that says
        # something about interleaved output and nothing about the property.
        unread = [name for name in missing if name not in observed]
        if unread:
            recovered = _rerun_unread(eco, crate, target, unread, features, runtime)
            passed |= recovered
            observed |= {name: "ok" for name in recovered}
            missing = sorted(set(paths) - passed)
    if missing:
        # One message for "never selected" and "selected but did not pass": the remedy
        # differs, the evidentiary standing does not. Either way the claimed battery did not
        # run to completion, so the unit has no test evidence from this target.
        detail = ", ".join(f"{name} ({observed.get(name, 'never ran')})" for name in missing)
        return False, f"{target}: {len(missing)} of {len(paths)} declared test(s) did not pass: {detail}"
    if proc.returncode != 0:
        return False, (
            f"{target}: every declared test passed but the run exited {proc.returncode}; "
            "the target did not complete, so the battery's result is unknown"
        )
    return True, f"{target}: {len(paths)} passed"


def pinned_runtimes(eco, toolchains: dict) -> tuple[list[str], str | None]:
    """The interpreter versions this ecosystem's batteries must be measured on.

    `([None], None)` for an ecosystem with no runtime pin: the battery is measured once, as
    it always was, and the returned `None` is the "no runtime named" the command builders
    already understand.

    An ecosystem whose pin exists but is UNRESOLVED gets a refusal rather than a run,
    because that is the whole meaning of an unresolved pin: the identity of the thing that
    decides the outcome is unknown, and unknown is dirty. A pin that is resolved but names
    no interpreter is the same failure wearing a resolved label, so it is refused too — a
    battery measured on an empty runtime set is a battery nobody ran.
    """
    entry = toolchains.get(eco.name)
    if not isinstance(entry, dict):
        return [None], None
    if entry.get("state") != "resolved":
        return [], (
            f"the [{eco.name}] runtime pin is unresolved, so the identity of the runtime "
            f"that decides this battery's outcome is unknown. A lane that ran anyway would "
            f"record a result describing no named runtime"
        )
    runtimes = [str(v) for v in entry.get("interpreters", [])]
    if not runtimes:
        return [], (
            f"the [{eco.name}] runtime pin is resolved and names no interpreter. An empty "
            f"runtime set selects no environment, so the battery would report on nothing"
        )
    return sorted(runtimes), None


def runtime_identity(eco, crate: str, runtime: str) -> tuple[bool, str]:
    """Whether the prepared environment for `runtime` holds exactly that runtime.

    The pin names an EXACT patch version, and this is what makes that more than a comment:
    an environment built on a different one is refused before a single test runs. Without
    the check the lane would report the pinned identity while measuring whatever the machine
    had — the same substitution the pin exists to prevent, one level down.

    A missing environment is a FAILURE, never a skip. `scripts/prepare_python_matrix.sh` and
    `scripts/prepare_node_matrix.sh` build them, and a lane that quietly measured four of
    five runtimes would report a green describing a supported set it never touched.

    ASKED, never derived from the directory name: a directory called `.node-v20` holding
    Node 22 is exactly the substitution this refuses, so the runtime states its own version
    and the pin is compared against what it said.
    """
    probe = RUNTIME_PROBES.get(eco.name)
    if probe is None:
        return True, runtime
    relative, argv = probe
    binary = REPO_ROOT / crate / relative(runtime)
    if not binary.is_file():
        return False, (
            f"{runtime}: no prepared environment at "
            f"{binary.parent.relative_to(REPO_ROOT)} — run the matrix preparation script"
        )
    proc = subprocess.run(
        [str(binary), *argv], capture_output=True, text=True, check=False
    )
    reported = proc.stdout.strip()
    if proc.returncode != 0 or reported != runtime:
        return False, (
            f"{runtime}: the prepared environment reports {reported or 'nothing'!r}, so the "
            f"battery would be measured on a runtime the pin does not name"
        )
    return True, runtime


def measure_unit(unit: dict, toolchains: dict) -> tuple[bool, str]:
    """Whether this unit's whole declared battery passed, and what to record about it.

    ONCE PER PINNED RUNTIME, and every one of them must pass. A unit whose ecosystem
    carries a runtime pin makes a claim about a SET of runtimes — for `sdk_python` the
    supported CPython minors — and one interpreter's green is not evidence about the others.
    The detail names each runtime measured, so the record says which set was covered rather
    than leaving a reader to assume the declared one.
    """
    eco = unit_ecosystem(unit)
    crate = unit_crate(unit)
    if eco is None or crate is None:
        return False, (
            "the unit's paths name no single project to test: they belong to no build "
            "system this platform adapts, span two of them, or sit outside every project "
            "of their own"
        )

    symbols = sorted(unit.get("tested_symbols", []))
    grouped, malformed = group_by_target(eco, symbols)
    if malformed:
        return False, (
            f"{len(malformed)} tested_symbol(s) name no runnable {eco.name} target "
            f"({', '.join(malformed)})"
        )

    runtimes, refusal = pinned_runtimes(eco, toolchains)
    if refusal is not None:
        return False, refusal

    features = sorted(unit.get("test_features", []))
    details: list[str] = []
    failed = False
    for runtime in runtimes:
        if runtime is not None:
            ok, identity = runtime_identity(eco, crate, runtime)
            if not ok:
                details.append(identity)
                failed = True
                continue
        for target in sorted(grouped):
            suffix = f" (--features {','.join(features)})" if features else ""
            where = f" on {eco.runtime_label}-{runtime}" if runtime is not None else ""
            print(f"    {crate} {target}: {len(grouped[target])} test(s){suffix}{where}")
            ok, detail = run_selection(eco, crate, target, grouped[target], features, runtime)
            prefix = f"{eco.runtime_label}-{runtime} " if runtime is not None else ""
            details.append(f"{prefix}{detail}")
            failed = failed or not ok
    return not failed, "; ".join(details)


def main() -> int:
    try:
        doc = load_verification()
        toolchains = load_toolchains()
        assumptions = load_assumptions()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    units = [unit for unit in doc.get("unit", []) if claims_test_evidence(unit)]
    if not units:
        # NOT_REQUIRED, not SKIPPED: the manifest asks nothing of this lane. SKIPPED would
        # mean it was required and deliberately not run.
        print("verify-tests: NOT_REQUIRED — no unit declares test:// evidence")
        print("VERDICT: NOT_REQUIRED")
        return 0

    failures = 0
    for unit in units:
        # Taken before the tests run: the record must say which source was measured, not
        # which source exists when someone later reads it.
        measured_at = fingerprint_unit(unit, doc, toolchains, assumptions)["fingerprint"]
        print(f"verify-tests: {unit['id']}")
        ok, detail = measure_unit(unit, toolchains)
        write_record(
            EVIDENCE_STORE,
            EvidenceRecord(
                unit_id=unit["id"],
                lane="test",
                result="pass" if ok else "fail",
                fingerprint=measured_at,
                detail=detail,
            ),
        )
        if ok:
            print(f"  PASS: {detail}")
        else:
            print(f"  FAIL: {detail}", file=sys.stderr)
            failures += 1

    if failures:
        print(
            f"\nFAIL: {failures} of {len(units)} unit(s) did not pass their declared "
            "test battery.",
            file=sys.stderr,
        )
        print("VERDICT: FAIL")
        return 1

    print(f"\nverify-tests: PASS — {len(units)} unit(s) tested")
    print("VERDICT: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
