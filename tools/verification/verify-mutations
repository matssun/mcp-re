EVIDENCE_STORE = evidence_store()

REGISTRY = REPO_ROOT / "verification" / "policy" / "mutation-probes.toml"

_OPTIONAL_PROBE_KEYS = {"note", "theorem", "also"}

_PROBE_KEYS = {
    "id",
    "unit",
    "theorem",
    "conjunct",
    "path",
    "anchor",
    "weakening",
    "expect_red",
    "note",
    "also",
}

#: The keys an `also` entry carries: one further site of the SAME proposition.
#:
#: DEFENCE IN DEPTH IS WHY THIS EXISTS, and it is deliberately narrow. Where two or more
#: independent sites each enforce the WHOLE proposition, removing any one of them leaves every
#: declared control green -- so a one-anchor probe measures nothing and the lane reports the
#: conjunct as unprotected, which is false. The weakening that falsifies such a proposition has
#: to remove the COMPLETE carrying set, atomically.
#:
#: This is NOT a mutation language. There is no ordering, no conditional, no expression over
#: sites: an `also` entry is another `(path, anchor, weakening)` triple held to exactly the same
#: single-site rule as the primary one, and every site is applied before the battery runs and
#: reverted after it. A probe using it states that these sites TOGETHER carry one conjunct.
#:
#: COMPOSITION MUST NOT USE IT. Where two checks each refuse a shape the other admits, they are
#: two conjuncts and each takes its own probe -- weakening both at once would report one
#: discharge for two propositions and hide which of them a battery covers.
_ALSO_KEYS = {"path", "anchor", "weakening"}


def load_probes() -> list[dict]:
    """The registry, validated strictly — an unknown key is a failure, not an ignored field.

    Same rule as every other manifest here: a mistyped security declaration must not read
    as an absent one.
    """
    if not REGISTRY.is_file():
        return []
    with REGISTRY.open("rb") as handle:
        doc = tomllib.load(handle)
    probes = doc.get("probe", [])
    seen: set[str] = set()
    for index, probe in enumerate(probes):
        where = f"mutation-probes.toml [[probe]] #{index + 1}"
        unknown = set(probe) - _PROBE_KEYS
        if unknown:
            raise ManifestError(f"{where}: unknown key(s) {sorted(unknown)}")
        missing = _PROBE_KEYS - _OPTIONAL_PROBE_KEYS - set(probe)
        if missing:
            raise ManifestError(f"{where}: missing required key(s) {sorted(missing)}")
        if probe["id"] in seen:
            raise ManifestError(f"{where}: duplicate probe id {probe['id']!r}")
        seen.add(probe["id"])
        if not probe["expect_red"]:
            raise ManifestError(
                f"{where}: `expect_red` is empty. A probe that expects no control to fail "
                f"asserts nothing; it would pass over an unprotected conjunct."
            )
        for position, also in enumerate(probe.get("also", [])):
            at = f"{where} `also` #{position + 1}"
            unknown = set(also) - _ALSO_KEYS
            if unknown:
                raise ManifestError(f"{at}: unknown key(s) {sorted(unknown)}")
            absent = _ALSO_KEYS - set(also)
            if absent:
                raise ManifestError(f"{at}: missing required key(s) {sorted(absent)}")
        sites = [(probe["path"], probe["anchor"])] + [
            (also["path"], also["anchor"]) for also in probe.get("also", [])
        ]
        if len(set(sites)) != len(sites):
            raise ManifestError(
                f"{where}: two sites name the same (path, anchor). A probe that weakens one "
                f"site twice weakens one site, and would report a compound falsifier over a "
                f"carrying set it never removed."
            )
    return probes


def claims_mutation_evidence(unit: dict) -> bool:
    """Whether a `mutation://` URI claims this unit's probe battery.

    The declaration is what puts the lane inside the ATTESTATION closure:
    `_evidence.required_lanes` reads every scheme a unit declares, so a unit carrying this
    URI cannot be attested without a mutation record measured at its exact fingerprint. A
    probe suite CI could quietly delete would otherwise be a comment.
    """
    return any(str(e).startswith("mutation://") for e in unit.get("evidence", []))


def declared_battery(
    units: dict, probe: dict, where: str
) -> tuple[str, dict[str, list[str]], list[str], list[str], object]:
    """The unit's package and its declared members, grouped by cargo target.

    Read from `verification.toml` rather than restated here: the probe names controls, and
    a control the unit does not declare is not evidence for its theorem however red it goes.

    `expect_red` is compared against the unit's `tested_symbols` VERBATIM — target and
    symbol — because that is what test identity is here. Matching on the bare symbol would
    let a probe be satisfied by a same-named test in a target it never meant to touch.

    The unit's `test_features` travel with the battery, for the reason the test lane already
    takes them: Cargo compiles a different crate per feature set, so a control behind
    `#[cfg(feature = ...)]` DOES NOT EXIST without it. Omitting them here never made a probe
    pass wrongly — the adjudicator refuses a control it did not watch execute — but it made
    every probe over a feature-gated battery UNMEASURABLE, reporting the lane's own blindness
    as a MEASUREMENT FAILURE against the probe. Found by the first such probe, M119/M120 over
    the `async_serve` drain battery, 2026-09-06.
    """
    unit = units.get(probe["unit"])
    if unit is None:
        raise ManifestError(f"{where}: unit {probe['unit']!r} is not in verification.toml")
    # A probe whose every expectation is a GATE names no compiled control, so it needs no
    # cargo package — and demanding one would refuse the probe on a Python or TypeScript unit
    # whose carrier is a source-text gate over the whole workspace. That is the shape of
    # THM-0094's and THM-0095's carriers, so the refusal would fall exactly on the two SDK
    # system roots this lane was extended to reach.
    gate_only = all(str(n).startswith("gate#") for n in probe["expect_red"])
    # ADR-MCPRE-068 Phase 2. The ECOSYSTEM travels with the battery, because what the
    # battery is does not vary but how it is RUN does. `test_package_for` already answers
    # for every ecosystem -- it returns `sdk/python` for a `sdk_python.*` unit, not None --
    # so resolution was never what stopped this lane reaching the two SDK system roots.
    # `run_battery` was: it spoke cargo and nothing else, so a probe over a `pytest#` or
    # `vitest#` control could not be executed at all, and the only probes those units could
    # carry were the gate-only ones Phase 1 added.
    eco = unit_ecosystem(unit)
    package = test_package_for(unit)
    if package is None and not gate_only:
        raise ManifestError(f"{where}: unit {probe['unit']!r} has no runnable test package")
    grouped: dict[str, list[str]] = {}
    declared: set[str] = set()
    for symbol in unit.get("tested_symbols", []):
        target, _, path = str(symbol).partition("#")
        declared.add(str(symbol))
        if target == "doc":
            # Doctests are compile-fail controls; a runtime weakening cannot move them.
            continue
        grouped.setdefault(target, []).append(path)
    # ADR-MCPRE-068 Phase 1. A gate control is declared in its own field and resolved by a
    # different runner, so it joins the battery here rather than being a `tested_symbols`
    # member a symbol resolver would have to recognise as a path.
    gates = [str(g) for g in unit.get("gate_controls", [])]
    declared.update(f"gate#{g}" for g in gates)
    unknown = [name for name in probe["expect_red"] if name not in declared]
    if unknown:
        raise ManifestError(
            f"{where}: expect_red names {unknown}, which unit {probe['unit']!r} does not "
            f"declare as tested_symbols or gate_controls. A control outside the battery is "
            f"not evidence. Members are named verbatim, as `tests/<target>#<symbol>`, "
            f"`lib#<symbol>` or `gate#<script path>`."
        )
    doctests = [name for name in probe["expect_red"] if name.startswith("doc#")]
    if doctests:
        raise ManifestError(
            f"{where}: expect_red names doctest control(s) {doctests}. Those are "
            f"compile-fail controls; no runtime weakening can turn one red, so a probe "
            f"expecting it could never be satisfied honestly."
        )
    features = sorted(str(f) for f in unit.get("test_features", []))
    if gate_only:
        # Run only what the probe NAMES. The adjudicator reads nothing but `expect_red`, so a
        # cargo battery here would be measured and discarded — and on a unit whose symbols are
        # `pytest#` or `vitest#` it cannot be run at all, because the argv spoke cargo.
        grouped = {}
    return package, grouped, features, gates, eco


def adjudicate(probe: dict, observed: dict[str, str]) -> tuple[list[str], list[str]]:
    """(never reported, actually failed) among the probe's expected controls.

    The distinction the first version of this lane did not make. It read
    `results.get(name, "never ran") != "ok"`, so an ABSENT result satisfied the probe —
    a control that never executed counted as evidence that the weakening broke it. That is
    the same false green as a filter selecting nothing and exiting 0, one layer up: the
    lane cannot conclude anything about a check from a test it did not watch run.

    So absence is a MEASUREMENT FAILURE reported on its own terms, and only an observed
    `FAILED` is red. `ok` and `ignored` are both "not red": an ignored test did not execute
    either, and must never be read as one that ran and objected.
    """
    missing = [name for name in probe["expect_red"] if name not in observed]
    red = [name for name in probe["expect_red"] if observed.get(name) == "FAILED"]
    return missing, red


#: What each ecosystem's runner says when the WEAKENED TREE DOES NOT BUILD, as opposed to
#: when its controls fail.
#:
#: This distinction is the whole correctness of the lane. A weakening routinely breaks the
#: build -- a deleted binding, a now-unused import, a type that no longer matches -- and a
#: tree that does not build has not tested anything. If that state were read as "every
#: control FAILED", a probe would be satisfied by BREAKING THE TREE rather than by
#: weakening the property, and the redness would measure the compiler instead of the claim.
#:
#: The same defect was found and fixed for gate controls in Phase 1: a gate that had been
#: DELETED by the weakening read as red, so a probe could be satisfied by removing its own
#: control. Absent is not red. This is that rule for the three test runners.
_DID_NOT_BUILD = {
    CARGO: ("error[E", "error: could not compile"),
    # pytest reports an import or collection failure before any test runs. Both spellings
    # appear: `ERROR collecting` for a module that raised on import, and `INTERNALERROR`
    # when the failure is in the plugin/conftest layer.
    PYTHON: ("ERROR collecting", "INTERNALERROR", "ModuleNotFoundError", "ImportError while"),
    # vitest fails at transform time before the suite exists. `Failed to load` covers a
    # missing module; the transform errors carry the file that would not parse.
    TYPESCRIPT: ("Failed to load", "Transform failed", "Could not resolve", "error TS"),
}


def _did_not_build(eco, text: str) -> bool:
    return any(marker in text for marker in _DID_NOT_BUILD.get(eco, ()))


def probe_runtime(eco, toolchains: dict) -> tuple[str | None, str | None]:
    """The ONE pinned interpreter this lane measures a probe on, and why if it cannot.

    `verify-tests` measures a unit's battery once per pinned runtime because the unit
    CLAIMS something about that whole set. A probe asks a different question -- can this
    control go red at all -- and one interpreter answers it. Running the matrix here would
    multiply every probe by the pinned runtimes to re-establish what the test lane already
    establishes.

    WHICH ONE IS NOT ARBITRARY AND NOT SILENT: it is the lowest pinned version, because a
    control that goes red on the oldest supported interpreter is the weakest claim of the
    set, and it is printed with the probe's result so the record says which environment
    decided it. An unresolved pin is refused here exactly as the test lane refuses it --
    unknown identity is dirty, not a default.
    """
    entry = toolchains.get(eco.name)
    if not isinstance(entry, dict):
        return None, None
    if entry.get("state") != "resolved":
        return None, (
            f"the [{eco.name}] runtime pin is unresolved, so the identity of the runtime "
            f"that would decide this probe is unknown"
        )
    runtimes = [str(v) for v in entry.get("interpreters", [])]
    if not runtimes:
        return None, (
            f"the [{eco.name}] runtime pin is resolved and names no interpreter, so this "
            f"probe would be measured on nothing"
        )
    # NUMERIC, not lexicographic. `sorted(["9.0.0", "20.1.0"])` puts 20 first, so a string
    # sort would name the HIGHEST version as the lowest the moment a single-digit major is
    # pinned. Today's pins hide that -- every Node major here is two digits -- which is
    # exactly the kind of latent wrong answer that surfaces years later on a version bump.
    def _version_key(value: str) -> tuple:
        return tuple(int(part) if part.isdigit() else -1 for part in value.split("."))

    return min(runtimes, key=_version_key), None


#: Untracked build artefacts an SDK battery needs in order to run at all, per ecosystem.
#:
#: The scratch tree is a copy of the TRACKED files, which is right for cargo -- it builds
#: from source -- and not sufficient for the two SDKs. `sdk/python`'s package imports a
#: compiled `_core.abi3.so` that `.gitignore` excludes, and `sdk/typescript` cannot run
#: vitest without `node_modules`. Neither is copied, so a battery in the scratch tree fails
#: to import before a single control runs.
#: Both SDKs are Rust extensions with a thin language-native wrapper, so both need their
#: compiled artefact as well as their dependency tree. The TypeScript binding's filename
#: carries the host triple, so it is discovered rather than spelled.
#:
#: Each entry maps the path the battery LOOKS FOR to the places the artefact may actually
#: live, in order. Python needs both: `maturin develop` leaves `_core.abi3.so` beside the
#: package in the source tree, while `prepare_python_matrix.sh` -- the form CI runs, and the
#: one that pins an environment per supported interpreter -- builds a WHEEL and installs it,
#: leaving the tree without a `.so` at all. A lane that knew only the first spelling refused
#: every Python probe on a correctly prepared runner and called the environment unbuilt.
_SCRATCH_NEEDS = {
    PYTHON: {
        "python/mcp_re_sdk/_core.abi3.so": (
            "python/mcp_re_sdk/_core.abi3.so",
            ".venv-cp*/lib/python*/site-packages/mcp_re_sdk/_core.abi3.so",
        ),
    },
    TYPESCRIPT: {
        "node_modules": ("node_modules",),
        "native/*.node": ("native/*.node",),
    },
}

#: The script that builds each ecosystem's matrix. NAMED, not derived from `eco.name`:
#: TypeScript's is `prepare_node_matrix.sh`, because what it installs is Node runtimes, and
#: a refusal telling a reader to run `prepare_typescript_matrix.sh` sends them to a file
#: that does not exist -- which is worse than saying nothing, since it reads as authoritative.
_MATRIX_SCRIPT = {
    PYTHON: "scripts/prepare_python_matrix.sh",
    TYPESCRIPT: "scripts/prepare_node_matrix.sh",
}


#: `prepare_scratch` returns one of these beside its message, because the two refusals it
#: can make are different facts and must not share a signal.
#:
#:   UNPREPARED  the environment this probe needs was never built here. An ENVIRONMENT
#:               fact, like the lean lane outside the extraction image: a missing
#:               measurement, not a failed one.
#:   STALE       the probe would weaken a source the carried artefact was compiled from,
#:               so the battery would run old native code against a new declaration. A
#:               PROBE DEFECT, and never skippable.
UNPREPARED = "unprepared"
STALE = "stale"


def prepare_scratch(
    eco, tree: Path, package: str, probe_path: str
) -> tuple[str, str] | None:
    """Make the weakened project runnable, or say why it cannot be.

    WHAT IS CARRIED ACROSS IS ONLY WHAT THE WEAKENING DOES NOT CHANGE. The probe edits a
    tracked source file; these artefacts are built from OTHER sources, so carrying the
    existing ones states nothing false about the weakened tree. `node_modules` is linked
    rather than copied because it is third-party and large; the `.so` is copied because a
    link into the working tree would let a future lane write through it.

    AND A PROBE THAT WOULD INVALIDATE A CARRIED ARTEFACT IS REFUSED. If the weakening
    touches a source the `.so` was COMPILED FROM, the carried binary is stale by
    construction: the battery would run the old native code against the new declaration and
    report a green that describes neither tree. That is the one case this helper cannot
    bridge, so it refuses instead of measuring -- the same rule as a gate that could not
    start, which is reported ABSENT rather than red.
    """
    needs = _SCRATCH_NEEDS.get(eco)
    if not needs:
        return None
    if eco is PYTHON and probe_path.endswith(".rs"):
        return STALE, (
            f"probe path {probe_path!r} is Rust compiled into the prepared "
            f"`_core.abi3.so`. The scratch tree carries that binary rather than rebuilding "
            f"it, so a weakening of its sources cannot be measured here: the battery would "
            f"run the OLD native code against the NEW declaration"
        )
    for wanted, candidates in needs.items():
        sources = _first_present(REPO_ROOT / package, wanted, candidates)
        if not sources:
            return UNPREPARED, (
                f"{eco.name} battery needs {package}/{wanted}, which this workspace does "
                f"not have. Prepared by `{_MATRIX_SCRIPT[eco]}`; a lane that ran without it "
                f"would report the resulting import failure as a red battery"
            )
        for source, relative in sources:
            target = tree / package / relative
            if target.exists():
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            if source.is_dir():
                target.symlink_to(source)
            else:
                shutil.copy2(source, target)
    return None


def _first_present(root: Path, wanted: str, candidates) -> list[tuple[Path, str]]:
    """The first candidate spelling that exists, as `(source, path under root)` pairs.

    ORDER IS AUTHORITY: the source tree first, then a prepared environment. Both spellings
    name the same built artefact, and where it lands depends on which preparation ran -- a
    developer's `maturin develop` or the matrix script CI uses.

    `wanted` is where it is INSTALLED in the scratch tree, and it is the key the battery
    imports from -- never the spelling it happened to be found at. So a probe measures one
    layout whichever preparation built the artefact.
    """
    for candidate in candidates:
        if "*" in candidate:
            # The spelling may glob in any segment (`.venv-cp*/lib/python*/...`), so the
            # whole thing is walked rather than only its last one.
            found = sorted(root.glob(candidate))
        else:
            source = root / candidate
            found = [source] if source.exists() else []
        if not found:
            continue
        install_parent = wanted.rpartition("/")[0]
        return [
            (
                source,
                f"{install_parent}/{source.name}" if install_parent else source.name,
            )
            for source in found
        ]
    return []


def run_battery(
    tree: Path,
    package: str,
    grouped: dict[str, list[str]],
    target_dir: Path,
    features: list[str],
    eco=CARGO,
    runtime: str | None = None,
):
    """Every declared member's reported result, across the unit's targets.

    Returns (ran, results). `ran` is False when the weakened tree failed to BUILD -- see
    `_DID_NOT_BUILD`, which is what keeps a broken tree from reading as a satisfied probe.

    THE COMMAND AND THE REPORT SYNTAX ARE THE ECOSYSTEM'S; the rule applied to the result
    is this lane's. `verify-tests` already resolves both through `_ecosystems`, so a probe
    over a Python or TypeScript unit runs the SAME selection, parsed by the SAME reader, as
    the test lane that registered those controls in the first place. Anything else would
    let a control be green in one lane and unrunnable in the other while both reported
    about the same declared symbol.

    ONE RUNTIME, and the caller records which. `verify-tests` runs a unit's battery once
    per pinned runtime because the unit CLAIMS something about that whole set. A probe asks
    a different question -- can this control go red at all -- and one interpreter answers
    it. Running the matrix here would multiply every probe by the pinned runtimes to
    re-establish something the test lane already establishes.
    """
    results: dict[str, str] = {}
    for target in sorted(grouped):
        if eco is CARGO:
            # THROUGH THE SEAM, like every other ecosystem below. This branch used to build
            # the argv itself, and its own `target_argv` knew only `lib` and `tests/<name>`
            # -- so a `bin/<name>` battery became `--test -re-client`, which cargo refuses
            # with a message that is not a build failure. The lane then reported a
            # MEASUREMENT FAILURE for a probe whose weakening works, blaming the probe for
            # the lane's blind spot. `_ecosystems.test_argv` is where the four Cargo target
            # shapes are declared, and a second implementation of them is how the two lanes
            # come to disagree about one declared symbol.
            argv = test_argv(eco, package, target, grouped[target], features, runtime)
            cwd = tree
            env = {**_env(), "CARGO_TARGET_DIR": str(target_dir)}
        else:
            argv = test_argv(eco, package, target, grouped[target], features, runtime)
            # THE RUNTIME IS THE REAL PREPARED ONE; only the SOURCE is weakened. Both SDK
            # adapters name their runner by a path relative to the project -- a prepared
            # venv's interpreter, a pinned Node's vitest entry point -- and the scratch tree
            # holds neither, because both are untracked. Resolving argv[0] against the
            # WORKSPACE project is what makes the run possible at all, and it is also the
            # honest arrangement: the pinned interpreter is the thing the claim is about, so
            # substituting a copy of it would change what was measured. What the weakening
            # has to reach is the source, and that is handled below.
            runner = REPO_ROOT / package / argv[0]
            if runner.exists():
                argv = [str(runner), *argv[1:]]
            # Cargo is driven from the workspace root with `-p`; a pytest or vitest
            # selection is relative to its own project, which is where its configuration
            # lives. Same rule as `verify-tests.run_selection`, against the SCRATCH tree.
            cwd = tree / package
            env = _env()
            if eco is PYTHON:
                # THE WEAKENED SOURCE MUST WIN OVER THE INSTALLED WHEEL, and without this
                # the probe measures nothing. `prepare_python_matrix.sh` installs the SDK as
                # a BUILT WHEEL -- site-packages holds a real copy of `mcp_re_sdk/`, not a
                # link to the tree -- so `python -m pytest` in that environment imports the
                # wheel's `mtls.py` whatever the scratch tree says. Every control would pass
                # under every weakening, and the lane would report each probe as a control
                # that refused to go red: not a false green, but permanently unmeasurable.
                # Putting the scratch package root first makes the import resolve to the
                # file the probe edited, and the carried `_core.abi3.so` keeps the native
                # submodule importable from there.
                env = {**env, "PYTHONPATH": str(tree / package / "python")}
        proc = subprocess.run(
            argv, cwd=cwd, capture_output=True, text=True, env=env
        )
        combined = proc.stdout + proc.stderr
        if _did_not_build(eco, combined):
            return False, results
        if eco is TYPESCRIPT:
            # THE RESULTS ARE IN THE FILE THE RUNNER WAS TOLD TO WRITE, not in stdout.
            # vitest 5's json reporter writes `--outputFile` and logs only the path, so a
            # lane reading stdout sees a sentence about where the report went and parses
            # zero controls from it. `verify-tests` learned this from a CI failure and
            # states the location rather than scanning for it; reading anywhere else here
            # would make the two lanes disagree about the same declared symbols.
            report = vitest_report_path(runtime, target)
            combined = report.read_text() if report.exists() else combined
        if eco is CARGO:
            for line in proc.stdout.splitlines():
                if not line.startswith("test "):
                    continue
                body = line[5:]
                name, _, outcome = body.partition(" ... ")
                if outcome:
                    # Keyed by TARGET plus symbol. libtest reports the symbol alone, and two
                    # targets may hold a test of the same name — flattening them here would
                    # let one target's failure answer for another's.
                    results[f"{target}#{name.strip()}"] = outcome.strip()
            continue
        try:
            observed = parse_results(eco, combined)
        except ReportUnreadable:
            # The runner collected cases and this lane understood none of them. That is the
            # lane failing to read a report, NOT a battery that went red, and reporting it
            # as red would satisfy the probe with the lane's own blindness. Treated exactly
            # as a tree that did not build: nothing was measured.
            return False, results
        for name, status in observed.items():
            results[f"{target}#{name}"] = status
    return True, results


def run_gates(tree: Path, gates: list[str]) -> dict[str, str]:
    """Each declared gate control's result, run over the WEAKENED copy.

    Reported in the same vocabulary as a libtest line — `FAILED` or `ok` — because the
    adjudicator asks one question of every control and must not learn where it came from.

    Run unconditionally, and NOT behind the cargo compile check. A source-text gate reads
    the tree; it neither needs nor waits for a build, and a weakening that happens to break
    compilation must not silently take the gate's verdict with it. A gate that cannot start
    at all is left ABSENT rather than recorded green, which the adjudicator already treats
    as a measurement failure — the one thing a control must never do is report a verdict it
    did not reach.
    """
    results: dict[str, str] = {}
    for control in gates:
        if not (tree / control).is_file():
            # NOT red. A probe whose weakening deleted or renamed the gate would otherwise
            # be satisfied by the control's disappearance — the sharpest false positive this
            # kind of control makes possible, and the mirror of the false green the
            # adjudicator was already built to refuse.
            continue
        try:
            proc = subprocess.run(
                [sys.executable, control],
                cwd=tree,
                capture_output=True,
                text=True,
                env=_env(),
            )
        except OSError:
            continue
        if "Traceback (most recent call last)" in proc.stderr:
            # The gate CRASHED rather than refusing. A non-zero exit means "this tree
            # violates the rule" only when the gate reached a verdict; a weakening that
            # breaks the gate's own parse produces the same status and proves nothing about
            # the production check. Left absent, which reads as a measurement failure.
            continue
        results[f"gate#{control}"] = "FAILED" if proc.returncode != 0 else "ok"
    return results


def _env() -> dict:
    import os

    return dict(os.environ)


def apply(tree: Path, probe: dict, where: str) -> dict[str, str]:
    """Write every weakened file into the COPY, returning each original text.

    Each anchor must identify exactly one site. Two matches is as much a failure as none:
    the lane could not say which check it broke, so whatever went red proves nothing about
    the conjunct named.

    ALL OR NOTHING. A probe carrying `also` sites names a proposition that several sites each
    enforce completely, so a partial application would leave a surviving carrier holding the
    property and the battery would stay green over a weakening that was never finished. Every
    site is validated BEFORE any file is written, and the caller reverts whatever this returns.
    """
    sites = [(probe["path"], probe["anchor"], probe["weakening"])] + [
        (also["path"], also["anchor"], also["weakening"]) for also in probe.get("also", [])
    ]
    originals: dict[str, str] = {}
    weakened: dict[str, str] = {}
    for path, anchor, weakening in sites:
        target = tree / path
        if not target.is_file():
            raise ManifestError(f"{where}: STALE — {path} does not exist")
        if path not in originals:
            originals[path] = target.read_text()
            weakened[path] = originals[path]
        # AGAINST THE TEXT AS ALREADY WEAKENED, not against the original: two sites of one
        # carrying set routinely live in ONE file, and applying each to a fresh copy of the
        # original would keep only the last -- a compound probe that silently weakened one
        # site while reporting that it had removed the set.
        hits = weakened[path].count(anchor)
        if hits != 1:
            raise ManifestError(
                f"{where}: STALE — an anchor matches {hits} site(s) in {path}, "
                f"expected exactly 1. Re-adjudicate this probe against the current "
                f"implementation; do NOT restore the old code to make it match."
            )
        weakened[path] = weakened[path].replace(anchor, weakening, 1)
    for path, text in weakened.items():
        (tree / path).write_text(text)
    return originals


#: The blueprint section that reproduces this registry's result for a reviewer.
MATRIX_DOC = REPO_ROOT / "docs" / "architecture" / "components" / "evidence-verification.md"
_MATRIX_COUNT = re.compile(r"\*\*(\d+) mutations, each turning at least one declared member")


#: The units whose probe suite MATRIX_DOC reproduces. Other units' probes are registered here
#: too and are not part of that section's count.
#:
#: A SET since the ADR-MCPRE-068 Phase-1 split. The section documents the VERIFIER's matrix,
#: and the verifier's propositions became ten units — so a single id would have made the
#: document's count drift to zero the moment the split landed, which is the one thing this
#: check exists to catch. What the document reproduces is the suite, not the unit that used to
#: hold it.
MATRIX_UNITS = frozenset({
    "http_profile.request_floor_result",
    "http_profile.request_full_result",
    "http_profile.bound_response_shared_facts",
    "http_profile.bound_response_seam_result",
    "http_profile.unbound_response_shared_facts",
    "http_profile.unbound_response_seam_result",
    "http_profile.bound_response_full_result",
    "http_profile.delegated_bound_result",
    "http_profile.delegated_unbound_result",
    "http_profile.delegated_credential_chain",
})


def check_matrix_count(probes: list[dict]) -> str | None:
    """The blueprint's stated probe count must equal the registry's, FOR THE UNIT IT DOCUMENTS.

    Prose is a CLAIM, not evidence. The count drifted from 26 to 27 the first time this
    matrix was written by hand, and a reviewer reading "27 mutations" has no way to notice.
    Deriving the agreement is cheap; the registry is the authority and the document is
    checked against it.
    """
    if not MATRIX_DOC.is_file():
        return f"{MATRIX_DOC} is missing — the matrix a reviewer reads must exist"
    match = _MATRIX_COUNT.search(MATRIX_DOC.read_text())
    if match is None:
        return (
            f"{MATRIX_DOC.name} no longer states a probe count in the expected form; the "
            f"registry's count can no longer be checked against the document."
        )
    stated = int(match.group(1))
    documented = sum(1 for probe in probes if probe.get("unit") in MATRIX_UNITS)
    if stated != documented:
        return (
            f"{MATRIX_DOC.name} states {stated} mutations for the verifier's ten propositions, the registry "
            f"holds {documented}. The registry is the authority."
        )
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--probe", action="append", default=[], help="only these probe ids")
    parser.add_argument(
        "--keep-tree", action="store_true", help="leave the scratch copy for inspection"
    )
    parser.add_argument(
        "--skip-unprepared",
        action="store_true",
        help=(
            "report a probe whose SDK matrix this environment never built as UNAVAILABLE "
            "rather than FAILED, and name it in the verdict. For a lane that deliberately "
            "prepares no matrix; never for the umbrella run, where an absent matrix is a "
            "defect in the environment the run is supposed to have"
        ),
    )
    args = parser.parse_args()

    try:
        probes = load_probes()
        doc = load_verification()
        toolchains = load_toolchains()
        assumptions = load_assumptions()
        units = {unit["id"]: unit for unit in doc.get("unit", [])}
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        print("VERDICT: FAIL")
        return 1

    orphaned = sorted(
        unit_id
        for unit_id, unit in units.items()
        if claims_mutation_evidence(unit)
        and not any(probe["unit"] == unit_id for probe in probes)
    )
    if orphaned:
        print(
            f"FAIL: unit(s) {orphaned} declare mutation:// evidence but no probe is "
            f"registered for them. A declared evidence class nothing measures is "
            f"unmeasured evidence.",
            file=sys.stderr,
        )
        print("VERDICT: FAIL")
        return 1

    drift = check_matrix_count(probes)
    if drift is not None:
        print(f"FAIL: {drift}", file=sys.stderr)
        print("VERDICT: FAIL")
        return 1

    if args.probe:
        wanted = set(args.probe)
        probes = [p for p in probes if p["id"] in wanted]
        if not probes:
            # ZERO EXECUTION IS NOT A QUIET STATE. `--probe M25` selects nothing, because
            # every id here is `M25-<what-it-weakens>`; this used to report NOT_REQUIRED
            # and exit 0, so a mistyped selector read exactly like a tree with no probes to
            # apply. Same rule the ADR-MCPRE-068 lanes are ratified under: a lane that
            # measured nothing may not report a pass.
            print(
                f"FAIL: --probe {sorted(wanted)} selected NO registered probe. A selector "
                f"that matches nothing has measured nothing, and an empty selection is not "
                f"the same fact as an empty registry.",
                file=sys.stderr,
            )
            print("VERDICT: FAIL")
            return 1
    if not probes:
        print("verify-mutations: NOT_REQUIRED — no probe registered")
        print("VERDICT: NOT_REQUIRED")
        return 0

    scratch = Path(tempfile.mkdtemp(prefix="mcp-re-mutation-"))
    tree = scratch / "tree"
    target_dir = scratch / "target"
    try:
        copy_tracked_tree(tree)
    except (subprocess.CalledProcessError, OSError) as exc:
        print(f"UNAVAILABLE: could not copy the tree: {exc}", file=sys.stderr)
        print("VERDICT: UNAVAILABLE")
        return 1

    failures: list[str] = []
    unavailable: list[str] = []
    probed_units = sorted({probe["unit"] for probe in probes})
    try:
        for index, probe in enumerate(probes):
            where = f"probe {probe['id']}"
            try:
                package, grouped, features, gates, eco = declared_battery(
                    units, probe, where
                )
                original = apply(tree, probe, where)
            except ManifestError as exc:
                print(f"  FAIL {probe['id']}: {exc}", file=sys.stderr)
                failures.append(probe["id"])
                continue
            try:
                runtime, refusal = probe_runtime(eco, toolchains)
                if refusal is not None:
                    print(f"  FAIL {probe['id']}: {refusal}", file=sys.stderr)
                    failures.append(probe["id"])
                    continue
                if grouped:
                    prepared = prepare_scratch(eco, tree, package, probe["path"])
                    if prepared is not None:
                        cause, detail = prepared
                        if cause == UNPREPARED and args.skip_unprepared:
                            # NAMED, never silent. The caller has said this environment
                            # builds no SDK matrix; the probe is then unmeasured here and
                            # the run says so in the verdict line, so "green" cannot be
                            # read as "every probe was applied".
                            print(f"  UNAVAILABLE {probe['id']}: {detail}")
                            unavailable.append(probe["id"])
                            continue
                        print(f"  FAIL {probe['id']}: {detail}", file=sys.stderr)
                        failures.append(probe["id"])
                        continue
                if grouped:
                    ran, results = run_battery(
                        tree, package, grouped, target_dir, features, eco, runtime
                    )
                else:
                    # Nothing to build, so nothing can fail to build. `ran` is about the
                    # test battery; a gate reads the tree and reports for itself.
                    ran, results = True, {}
                results.update(run_gates(tree, gates))
            finally:
                for path, text in original.items():
                    (tree / path).write_text(text)
            if not ran:
                print(
                    f"  FAIL {probe['id']}: the weakened tree did not COMPILE, so nothing "
                    f"was measured. Re-adjudicate the weakening.",
                    file=sys.stderr,
                )
                failures.append(probe["id"])
                continue
            missing, red = adjudicate(probe, results)
            if missing:
                print(
                    f"  FAIL {probe['id']}: MEASUREMENT FAILURE — expected control(s) "
                    f"{sorted(missing)} were never reported by the run. The lane cannot "
                    f"say the weakening broke a test it did not watch execute; absence is "
                    f"not a red result.",
                    file=sys.stderr,
                )
                failures.append(probe["id"])
                continue
            red = sorted(red)
            if not red:
                print(
                    f"  FAIL {probe['id']}: {probe.get('theorem', probe['unit'])} claims "
                    f"\"{probe['conjunct']}\", "
                    f"but removing the check left every expected control green. The conjunct "
                    f"is NOT load-bearing in the declared battery — write a control, do not "
                    f"soften the statement.",
                    file=sys.stderr,
                )
                failures.append(probe["id"])
                continue
            print(f"  ok   {probe['id']}  {probe.get('theorem', probe['unit'])}  red: {', '.join(red)}")
    finally:
        if args.keep_tree:
            print(f"  scratch tree kept at {scratch}")
        else:
            shutil.rmtree(scratch, ignore_errors=True)

    # Phase 3 of the evidence pipeline, exactly as the other lanes do it: the result
    # becomes a machine record BOUND TO THE FINGERPRINT it was measured at, and `attest`
    # refuses a unit whose mutation record does not match the tree it is stamping.
    #
    # Written only for a complete run. A `--probe` subset measured part of the battery, and
    # a record from it would let "three probes passed" stand in for "the suite passed" —
    # the same shape as a filter that selects nothing.
    if not args.probe:
        for unit_id in probed_units:
            unit = units.get(unit_id)
            if unit is None or not claims_mutation_evidence(unit):
                continue
            unit_failures = [
                p["id"] for p in probes if p["unit"] == unit_id and p["id"] in failures
            ]
            count = sum(1 for p in probes if p["unit"] == unit_id)
            write_record(
                EVIDENCE_STORE,
                EvidenceRecord(
                    unit_id=unit_id,
                    lane="mutation",
                    result="fail" if unit_failures else "pass",
                    fingerprint=fingerprint_unit(unit, doc, toolchains, assumptions)[
                        "fingerprint"
                    ],
                    detail=(
                        f"{count} probe(s); failed: {', '.join(unit_failures)}"
                        if unit_failures
                        else f"{count} probe(s), each turning a declared control red"
                    ),
                ),
            )

    if failures:
        print(
            f"\nFAIL: {len(failures)} of {len(probes)} probe(s) did not demonstrate a "
            f"load-bearing check: {', '.join(failures)}",
            file=sys.stderr,
        )
        print("VERDICT: FAIL")
        return 1
    measured = len(probes) - len(unavailable)
    if unavailable and measured == 0:
        # A LANE THAT MEASURED NOTHING MAY NOT REPORT A PASS. This is the ratified rule the
        # whole ADR-MCPRE-068 lane set is held to, and `--skip-unprepared` reintroduced the
        # exact shape it forbids: every probe skipped, nothing weakened, nothing observed,
        # and a green verdict. Found by hiding `node_modules` and running the flag.
        print(
            f"\nverify-mutations: UNAVAILABLE — all {len(unavailable)} selected probe(s) "
            f"need an SDK matrix this environment never built "
            f"({', '.join(unavailable)}). Nothing was weakened, so nothing was measured."
        )
        print("VERDICT: UNAVAILABLE")
        return 1
    if unavailable:
        # THE VERDICT LINE CARRIES THE SHORTFALL, so a reader cannot take this run for a
        # complete one. Same rule the lean lane is reported under: an absent environment is
        # a missing measurement, stated, rather than a quiet pass over it.
        print(
            f"\nverify-mutations: PASS — {measured} probe(s), each turning a declared "
            f"control red; {len(unavailable)} UNAVAILABLE in this environment "
            f"({', '.join(unavailable)}). The umbrella run measures those."
        )
        print("VERDICT: PASS")
        return 0
    print(f"\nverify-mutations: PASS — {len(probes)} probe(s), each turning a declared control red")
    print("VERDICT: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
