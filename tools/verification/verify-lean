#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""The authoritative Aeneas/Lean lane — ADR-MCPRE-059 §8, §16.

Builds the Lean package and checks the handwritten theorems against the model extracted
from real MCP-RE Rust through the pinned Charon → LLBC → Aeneas pipeline.

The lane refuses while any of Charon, Aeneas, Lean, or the Aeneas Lean backend is
unpinned, and it refuses while `verification/lean/lean-toolchain` is absent. Those files
are deliberately missing rather than empty: an empty `lean-toolchain` reads as "pinned" to
a tool that will then resolve whatever it finds, which is worse than no pin at all.

# What a PASS here means, and the four ways it could have meant nothing

A green `lake build` says the files elaborated. On its own that is compatible with the
theorem being absent, being about a stale model, being about a model somebody edited, and
being proved by `sorry`. Each of those is asked separately:

* **absent** — the unit names its `lean_theorems`, and a name the prover cannot resolve is
  a failure rather than a theorem with no axioms. `#print axioms` says *nothing at all*
  about an unknown constant, so silence must never read as cleanliness;
* **stale / edited** — `_lean_model` compares the regeneration stamp against the sources
  and the bytes on disk, so the model this lane proves against is the pinned pipeline's
  output for this tree or the lane refuses;
* **`sorry`** — discovered as `sorryAx` in the axiom closure, not by grepping for a token,
  and never registrable as an assumption;
* **an unaccounted premise** — every axiom outside the declared kernel baseline must be an
  `ASM-NNNN` scoped to this unit.

The kernel baseline is read from `[lean].kernel_axioms` in the toolchain lock, against the
pinned toolchain. It is a property of the prover, so the prover's identity is what it is
recorded against, and a lock that declares none is a refusal rather than a default: a
hard-coded baseline here would keep reading as correct across a Lean bump that changed it.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _evidence import EvidenceRecord, write_record  # noqa: E402
from _extraction_identity import definition_drift  # noqa: E402
from _fingerprint import fingerprint_unit  # noqa: E402
from _lean_axioms import (  # noqa: E402
    AxiomReport,
    classify,
    parse_print_axioms,
    print_axioms_source,
    registered_axioms,
    sorry_registrations,
    unused_registrations,
)
from _lean_model import (  # noqa: E402
    AENEAS_LEAN,
    extraction_environment,
    lakefile_roots,
    read_stamp,
    selection,
    stamp_defects,
)
from _lean_probe import run as run_activation_probe  # noqa: E402
from _lean_query import LEAN_DIR, elaborate, lake  # noqa: E402
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    load_assumptions,
    load_toolchains,
    load_verification,
    unpinned_identities,
)

REQUIRED = {"charon", "aeneas", "lean", "aeneas_lean_backend", "extraction_container"}
EVIDENCE_STORE = REPO_ROOT / ".verification" / "evidence"

def kernel_baseline(toolchains: dict) -> tuple[frozenset[str], str | None]:
    """The declared kernel axioms, or the reason there are none to compare against."""
    declared = toolchains.get("lean", {}).get("kernel_axioms")
    if not isinstance(declared, list) or not declared:
        return frozenset(), (
            "the lock declares no [lean].kernel_axioms, so there is no baseline to "
            "measure an axiom closure against. Which axioms are the prover's logic rather "
            "than this repository's premises is a property of the pinned Lean and must be "
            "recorded against it."
        )
    return frozenset(str(name) for name in declared), None


def axiom_reports(imports: list[str], theorems: list[str]) -> dict[str, tuple[str, ...]]:
    """Ask the prover for each theorem's axiom closure."""
    code, output = elaborate(
        print_axioms_source(imports, theorems), "axiom discovery"
    )
    if code != 0:
        # Not fatal on its own: `#print axioms` over an unresolvable constant is an error
        # AND the diagnostic this lane needs. The caller decides, from the reports.
        print(output.strip())
    return parse_print_axioms(output)


def refuse(message: str) -> int:
    print(f"FAIL: {message}", file=sys.stderr)
    print("VERDICT: FAIL")
    return 1


def not_required(missing: list[str], drift: str | None, absent: list[str]) -> int:
    """The honest verdict while no unit asks this lane for evidence.

    NOT_REQUIRED, not SKIPPED or UNAVAILABLE: the manifest declares no V2/V3 unit, so this
    lane is not being asked for evidence at all. Once a V2 unit exists and the pipeline is
    absent on this host, the UNAVAILABLE branch below holds the aggregate at INCOMPLETE — a
    lane that cannot run is never a lane that passed.
    """
    if missing:
        state = "not pinned"
    elif drift:
        state = "pinned, but the pin is not a build of the declared definition"
    elif absent:
        state = "pinned, Lean package not established"
    else:
        state = "pinned, no unit asking"
    print(f"verify-lean: NOT_REQUIRED — no V2/V3 unit declared ({state})")
    print("VERDICT: NOT_REQUIRED")
    if missing:
        print(f"  unresolved pins: {', '.join(missing)}")
    # Printed even here, where it is not fatal. The whole failure it describes is a fact
    # that nothing said out loud, and a lane that knows it and stays quiet until somebody
    # declares a V2 unit would be repeating that.
    if drift:
        print(f"  pin currency:    {drift}")
    if absent:
        print(f"  absent files:    {', '.join(absent)} (created by toolchain setup)")
    return 0


def check_unit(
    unit: dict,
    reports: dict[str, tuple[str, ...]],
    baseline: frozenset[str],
    assumptions: list[dict],
) -> tuple[bool, str]:
    """Whether this unit's declared theorems stand, and the detail either way."""
    registered = registered_axioms(assumptions, unit["id"])
    declared = [str(name) for name in unit["lean_theorems"]]
    absent = [name for name in declared if name not in reports]
    if absent:
        return False, (
            f"the prover resolved no constant named {', '.join(absent)}. A theorem the "
            f"prover cannot find is not a theorem with no axioms."
        )
    measured = [AxiomReport(name, reports[name]) for name in declared]
    defects = [d for report in measured for d in classify(report, baseline, registered)]
    for note in unused_registrations(measured, registered):
        print(f"  note: {note}")
    if defects:
        return False, " | ".join(defects)
    premises = sorted({a for r in measured for a in r.axioms} - baseline)
    return True, (
        f"{len(declared)} theorem(s) established; axiom closure is the declared kernel "
        f"baseline"
        + (f" plus registered {', '.join(premises)}" if premises else "")
    )


def activation_probe() -> int:
    """Make the prover produce what the lane must refuse, and fail if it does not.

    Separate from the lane's own run and never part of it. A lane that probed itself inside
    the run it reports would be reporting on an environment it had just modified, and the
    thing under test here is the lane's refusal, not any unit's evidence.
    """
    try:
        toolchains = load_toolchains()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1
    baseline, why = kernel_baseline(toolchains)
    if why:
        return refuse(why)
    if not (LEAN_DIR / "lakefile.toml").exists() or not extraction_environment():
        print(
            "UNAVAILABLE: the Lean package or the Aeneas library is absent, so the probe "
            "cannot elaborate anything. An absent toolchain is a missing measurement, not "
            "a passing one.",
            file=sys.stderr,
        )
        print("VERDICT: UNAVAILABLE")
        return 1
    code, output = lake(["lake", "build"], "elaborating the package for the probe")
    if code != 0:
        print(output.strip()[-4000:], file=sys.stderr)
        return refuse(f"lake build exited {code}; the probe has nothing to elaborate into")
    defects = run_activation_probe(lakefile_roots(), baseline)
    if defects:
        for defect in defects:
            print(f"FAIL: {defect}", file=sys.stderr)
        print("VERDICT: FAIL")
        return 1
    print(
        "verify-lean --activation-probe: PASS — `sorry`, an unregistered axiom, and an "
        "unresolvable theorem name are each still refused"
    )
    print("VERDICT: PASS")
    return 0


def main() -> int:
    if "--activation-probe" in sys.argv[1:]:
        return activation_probe()
    try:
        toolchains = load_toolchains()
        doc = load_verification()
        assumptions = load_assumptions()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    unpinned = unpinned_identities(toolchains, REQUIRED)
    missing = sorted(unpinned)
    drift = definition_drift(toolchains)
    absent = [
        name
        for name in ("lean-toolchain", "lakefile.toml")
        if not (LEAN_DIR / name).exists()
    ]
    units = [unit for unit in doc.get("unit", []) if unit["class"] in {"V2", "V3"}]

    if not units:
        return not_required(missing, drift, absent)

    if drift:
        # Fatal HERE, and only here: a unit is asking this lane for evidence, and the image
        # that would produce it is not a build of the toolchain the tree declares. Evidence
        # from an undeclared instrument is not evidence about the declared one.
        return refuse(drift)
    if missing or absent:
        return refuse(
            "units are declared V2/V3 but the Lean pipeline is not pinned.\n"
            f"  unresolved pins: {', '.join(missing) or 'none'}\n"
            f"  absent files:    {', '.join(absent) or 'none'}\n"
            "A unit cannot claim an extracted-model theorem that no pinned pipeline "
            "produced."
        )

    baseline, why = kernel_baseline(toolchains)
    if why:
        return refuse(why)

    forged = sorry_registrations(assumptions)
    if forged:
        return refuse(
            f"{', '.join(forged)} register `sorry` as a trusted premise. `sorry` is the "
            "absence of a proof, not a premise, and a registry row asserting otherwise is "
            "a defect wherever it is scoped."
        )

    # BEFORE the model's freshness. A macOS host cannot regenerate — Charon links the
    # private rustc crates and does not build there — so "no regeneration stamp" would be a
    # false instruction, and FAIL would say *something is here and it is wrong* about a
    # measurement that is simply absent.
    if not extraction_environment():
        print(
            f"UNAVAILABLE: the Aeneas Lean library is not at {AENEAS_LEAN}, so this is not "
            "the extraction environment. The lane runs inside the image pinned as "
            "[extraction_container] and nowhere else.\n"
            "Not a FAIL — an absent toolchain is a missing measurement, not a failed one —\n"
            "and not a PASS, because nothing was elaborated.",
            file=sys.stderr,
        )
        print("VERDICT: UNAVAILABLE")
        return 1

    model = stamp_defects(read_stamp(), toolchains, selection(doc))
    if model:
        for defect in model:
            print(f"FAIL: {defect}", file=sys.stderr)
        print("VERDICT: FAIL")
        return 1

    fingerprints = {
        unit["id"]: fingerprint_unit(unit, doc, toolchains, assumptions)["fingerprint"]
        for unit in units
    }

    def record(unit_id: str, result: str, detail: str) -> None:
        write_record(
            EVIDENCE_STORE,
            EvidenceRecord(
                unit_id=unit_id,
                lane="lean",
                result=result,
                fingerprint=fingerprints[unit_id],
                detail=detail,
                prover={
                    "lean": str(toolchains["lean"]["toolchain"]),
                    "aeneas": str(toolchains["aeneas"]["commit"]),
                    "charon": str(toolchains["charon"]["commit"]),
                    "extraction_artifact": str(toolchains["extraction_container"]["artifact_digest"]),
                },
            ),
        )

    code, output = lake(["lake", "build"], "elaborating the model and the theorems")
    if code != 0:
        print(output.strip()[-6000:], file=sys.stderr)
        for unit in units:
            record(unit["id"], "fail", f"lake build exited {code}")
        return refuse(f"lake build exited {code}; nothing elaborated, so nothing is proved")

    theorems = sorted({str(name) for unit in units for name in unit["lean_theorems"]})
    reports = axiom_reports(lakefile_roots(), theorems)

    failures = 0
    for unit in units:
        ok, detail = check_unit(unit, reports, baseline, assumptions)
        if ok:
            print(f"  PASS {unit['id']}: {detail}")
            record(unit["id"], "pass", detail)
        else:
            print(f"  FAIL {unit['id']}: {detail}", file=sys.stderr)
            record(unit["id"], "fail", detail)
            failures += 1

    if failures:
        return refuse(f"{failures} of {len(units)} extracted-model unit(s) did not stand")
    print(f"\nverify-lean: PASS — {len(units)} unit(s) established")
    print("VERDICT: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
