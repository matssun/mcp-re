#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Generated-artifact drift gate — ADR-MCPRE-059, "Threat: generated model is stale".

Two generated artifacts, one gate, because staleness enforcement has a single owner (§16):

  * the extracted Lean model under `verification/lean/generated/`;
  * the human assurance views under `verification/generated/` (Phase T3).

Both are compared against what is checked in, and a mismatch means the artifact no longer
corresponds to the source it claims to describe — a theorem proved against a stale model
constrains nothing, and a view that disagrees with the catalogues states something no
authority states.

This is also the control that makes hand-editing detectable: an edit survives review by
looking like ordinary Lean or ordinary Markdown, and is caught here by not surviving
regeneration.

WHO REGENERATES DIFFERS, and it decides the shape of each half. The views are cheap and
pure, so this script renders them itself. The Lean model is not: producing it means running
Charon inside the pinned Linux container, which is `regenerate-lean`'s job and the reason
the extraction lane runs that first and this second. So for the model, this script reads
the STAMP that run left — what it extracted from, under which pinned pipeline, and what it
wrote — and then asks git whether the regenerated tree still equals the committed one. A
stamp is therefore mandatory: with none, a regeneration never happened, and comparing the
checked-in model against itself passes for every model, a hand-written one included.

Verdict semantics are unchanged and deliberate. Current views are a PRECONDITION for
trusting the documents, never evidence about code, so a repository whose views are current
and whose Lean model does not exist still reports `NOT_REQUIRED`. Letting view freshness
report `PASS` would let a formal lane's aggregate rest on a Markdown comparison.
"""

from __future__ import annotations

import importlib.util
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _lean_model import (  # noqa: E402
    AENEAS_LEAN,
    extraction_environment,
    read_stamp,
    stamp_defects,
)
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    load_toolchains,
    load_verification,
    unresolved_pins,
)

_generator = SourceFileLoader("generate_views", str(Path(__file__).resolve().parent / "generate-views"))
_spec = importlib.util.spec_from_loader("generate_views", _generator)
generate_views = importlib.util.module_from_spec(_spec)
_generator.exec_module(generate_views)

GENERATED = REPO_ROOT / "verification" / "lean" / "generated"
REQUIRED = {"charon", "aeneas", "lean", "aeneas_lean_backend"}


def generated_files() -> list[Path]:
    if not GENERATED.exists():
        return []
    return [
        path
        for path in sorted(GENERATED.rglob("*"))
        if path.is_file() and path.name != ".gitkeep"
    ]


def committed_drift() -> list[str]:
    """The generated tree's difference from what is committed, as git reports it.

    This is the comparison that catches a hand-edit, and it works because it runs AFTER a
    regeneration has overwritten the tree: whatever a person put in the repository has by
    then been replaced by what the machine produced, so a dirty path IS the edit. It is
    also the staleness check for anything the stamp's source set does not reach — the
    regenerated bytes simply differ from the committed ones.

    Untracked files are included. A model that grew a file nobody committed is drift in
    the direction a `git diff` alone would not see.
    """
    proc = subprocess.run(
        ["git", "status", "--porcelain", "--", "verification/lean/generated"],
        cwd=REPO_ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        return [f"git could not report on the generated tree: {proc.stderr.strip()}"]
    return [line for line in proc.stdout.splitlines() if line.strip()]


def selection(doc: dict) -> dict[str, dict]:
    """The extraction selection the manifest declares, in the stamp's own shape."""
    return {
        unit["id"]: {
            "crate": sorted(
                {
                    path.split("/", 1)[0]
                    for path in unit["paths"]
                    if "/" in path
                    and (REPO_ROOT / path.split("/", 1)[0] / "Cargo.toml").is_file()
                }
            )[0],
            "start_from": sorted(str(s) for s in unit["extracted_symbols"]),
        }
        for unit in doc.get("unit", [])
        if unit["class"] in {"V2", "V3"}
    }


def main() -> int:
    try:
        toolchains = load_toolchains()
        doc = load_verification()
        views = generate_views.rendered()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    # The views first: they are cheap, they need no toolchain, and a stale view is a
    # document a reviewer may already have read.
    drift = generate_views.differences(views)
    if drift:
        for entry in drift:
            print(f"FAIL: {entry}", file=sys.stderr)
        print(
            "Regenerate with tools/verification/generate-views.", file=sys.stderr
        )
        return 1
    print(f"check-generated: {len(views)} assurance view(s) current")

    missing = sorted(REQUIRED & set(unresolved_pins(toolchains)))
    present = generated_files()

    if present and missing:
        print(
            f"FAIL: {len(present)} generated file(s) exist but the extraction pipeline is "
            f"unpinned ({', '.join(missing)}).\n"
            "Their provenance cannot be established, and unknown provenance is dirty — "
            "never fresh.",
            file=sys.stderr,
        )
        return 1

    wanted = selection(doc)

    if not wanted:
        if present:
            # A model no unit declares is an artifact nothing attributes. It cannot be
            # checked for staleness — there is no declared selection to regenerate it
            # from — and leaving it in the tree lets a later unit inherit a model whose
            # provenance nobody established.
            print(
                f"FAIL: {len(present)} generated file(s) exist and no V2/V3 unit declares "
                "an extraction. An unattributed model has no source to be stale against.",
                file=sys.stderr,
            )
            return 1
        print("check-generated: no generated model — nothing to drift")
        print("VERDICT: NOT_REQUIRED")
        return 0

    # The same environment question `verify-lean` asks, and before the same check. Only the
    # extraction container can produce the model, so on any other host the drift comparison
    # has no input rather than a failing one.
    if not extraction_environment():
        print(
            f"UNAVAILABLE: the Aeneas Lean library is not at {AENEAS_LEAN}, so this is not "
            "the extraction environment and nothing here can regenerate the model.",
            file=sys.stderr,
        )
        print("VERDICT: UNAVAILABLE")
        return 1

    defects = stamp_defects(read_stamp(), toolchains, wanted)
    if defects:
        for defect in defects:
            print(f"FAIL: {defect}", file=sys.stderr)
        return 1

    drifted = committed_drift()
    if drifted:
        print(
            "FAIL: the regenerated model differs from what is committed:", file=sys.stderr
        )
        for line in drifted:
            print(f"  {line}", file=sys.stderr)
        print(
            "The pipeline just rewrote this tree, so a difference here is either a "
            "hand-edit that\ndid not survive regeneration or a model that was never "
            "regenerated after its source moved.\nCommit the regenerated output; never "
            "edit it.",
            file=sys.stderr,
        )
        return 1

    print(
        f"check-generated: {len(present)} generated file(s) reproduce from the pinned "
        f"pipeline over {len(wanted)} unit(s)"
    )
    print("VERDICT: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
