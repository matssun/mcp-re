#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Extracted-model drift gate — ADR-MCPRE-059, "Threat: generated model is stale".

ONE generated artifact: the extracted Lean model under `verification/lean/generated/`. It is
compared against what is checked in, and a mismatch means the model no longer corresponds to
the source it claims to describe — a theorem proved against a stale model constrains nothing.

This is also the control that makes hand-editing detectable: an edit survives review by
looking like ordinary Lean, and is caught here by not surviving regeneration.

PRODUCING THE MODEL IS SOMEONE ELSE'S JOB, and that decides this file's shape. It means
running Charon inside the pinned Linux container, which is `regenerate-lean`'s, and the
reason the extraction lane runs that first and this second. So this script reads the STAMP
that run left — what it extracted from, under which pinned pipeline, and what it wrote — and
then asks git whether the regenerated tree still equals the committed one. A stamp is
mandatory: with none, a regeneration never happened, and comparing the checked-in model
against itself passes for every model, a hand-written one included.

THE ASSURANCE VIEWS LEFT THIS GATE, and the reason is a property of their preconditions
rather than of their owner. §16 gives staleness enforcement a single OWNER; that is a good
reason for one owner and a bad reason for one EXECUTABLE. This half cannot run outside the
pinned container, so it belongs to `PHASES["extraction"]` and to a workflow step conditional
on `image.outputs.resolved && required` — and while the views rode along, six cheap, pure
Markdown comparisons inherited every one of those preconditions and were checked by nothing
whenever the container was unresolved. They are now `tools/verification/check-views`, which
states that argument in full and runs unconditionally.

Verdict semantics are unchanged and deliberate: a repository whose Lean model does not exist
reports `NOT_REQUIRED` rather than `PASS`.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _lean_model import (  # noqa: E402
    AENEAS_LEAN,
    STAMP_FAIL,
    STAMP_UNAVAILABLE,
    extraction_environment,
    selection,
    read_stamp,
    stamp_defects,
    stamp_verdict,
)
from _evidence import EvidenceRecord, evidence_store, write_record  # noqa: E402
from _fingerprint import fingerprint_unit  # noqa: E402
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    load_assumptions,
    load_toolchains,
    load_verification,
    unresolved_pins,
)

GENERATED = REPO_ROOT / "verification" / "lean" / "generated"
REQUIRED = {"charon", "aeneas", "lean", "aeneas_lean_backend"}


def generated_files() -> list[Path]:
    if not GENERATED.exists():
        return []
    return [
        path
        for path in sorted(GENERATED.rglob("*"))
        if path.is_file() and path.name != ".gitkeep"
    ]


def committed_drift() -> list[str]:
    """The generated tree's difference from what is committed, as git reports it.

    This is the comparison that catches a hand-edit, and it works because it runs AFTER a
    regeneration has overwritten the tree: whatever a person put in the repository has by
    then been replaced by what the machine produced, so a dirty path IS the edit. It is
    also the staleness check for anything the stamp's source set does not reach — the
    regenerated bytes simply differ from the committed ones.

    Untracked files are included. A model that grew a file nobody committed is drift in
    the direction a `git diff` alone would not see.
    """
    proc = subprocess.run(
        ["git", "status", "--porcelain", "--", "verification/lean/generated"],
        cwd=REPO_ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        return [f"git could not report on the generated tree: {proc.stderr.strip()}"]
    return [line for line in proc.stdout.splitlines() if line.strip()]


def record_units(doc: dict, toolchains: dict, result: str, detail: str) -> None:
    """Write one record per unit whose model this lane just judged.

    A FORMAL lane's verdict is per-unit evidence, and the aggregate composes per-unit
    records — so a lane that only printed a line would be a lane whose result nothing can
    compose. `fail` is recorded exactly as `pass` is: "the model was stale at this
    fingerprint" is the fact the graph must propagate, and refusing to write it would leave
    an earlier passing record in place for the aggregate to read.
    """
    try:
        assumptions = load_assumptions()
    except ManifestError:
        # The manifests were already loaded successfully by the caller; if the assumption
        # registry is unreadable HERE the fingerprint cannot be computed, and a record with
        # no fingerprint is worse than none — the aggregate would have to guess.
        return
    store = evidence_store()
    for unit in doc.get("unit", []):
        # The units the aggregate will ASK for a generated-model record, spelled the same
        # way it spells it: a declared `lean://` entry, whose freshness precondition this
        # lane is. Recording by class instead would write records for units the composer
        # does not require and miss any it does.
        if not any(
            str(entry).startswith("lean://") for entry in unit.get("evidence", [])
        ):
            continue
        write_record(
            store,
            EvidenceRecord(
                unit_id=unit["id"],
                lane="generated-model",
                result=result,
                fingerprint=fingerprint_unit(unit, doc, toolchains, assumptions)[
                    "fingerprint"
                ],
                detail=detail,
                prover={
                    "extraction_artifact": str(
                        toolchains.get("extraction_container", {}).get(
                            "artifact_digest", ""
                        )
                    ),
                    "extraction_archive": str(
                        toolchains.get("extraction_container", {}).get(
                            "archive_digest", ""
                        )
                    ),
                },
            ),
        )


def main() -> int:
    try:
        toolchains = load_toolchains()
        doc = load_verification()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    missing = sorted(REQUIRED & set(unresolved_pins(toolchains)))
    present = generated_files()

    if present and missing:
        print(
            f"FAIL: {len(present)} generated file(s) exist but the extraction pipeline is "
            f"unpinned ({', '.join(missing)}).\n"
            "Their provenance cannot be established, and unknown provenance is dirty — "
            "never fresh.",
            file=sys.stderr,
        )
        return 1

    wanted = selection(doc)

    if not wanted:
        if present:
            # A model no unit declares is an artifact nothing attributes. It cannot be
            # checked for staleness — there is no declared selection to regenerate it
            # from — and leaving it in the tree lets a later unit inherit a model whose
            # provenance nobody established.
            print(
                f"FAIL: {len(present)} generated file(s) exist and no V2/V3 unit declares "
                "an extraction. An unattributed model has no source to be stale against.",
                file=sys.stderr,
            )
            return 1
        print("check-generated: no generated model — nothing to drift")
        print("VERDICT: NOT_REQUIRED")
        return 0

    # A STAMP, NOT A TOOLCHAIN, is what this half needs. Comparing bytes requires neither
    # Charon nor Lean, and the extraction lane relies on that: the container regenerates,
    # and this runs on the host immediately afterwards over the same mounted workspace.
    #
    # So the environment question is asked only when there is nothing to compare. With no
    # stamp, a host that COULD have regenerated and did not is a failure — and one that
    # never could is a missing measurement, which is a different verdict with a different
    # remedy. Telling a macOS host to "run regenerate-lean inside the pinned extraction
    # container" is an instruction it cannot follow.
    stamp = read_stamp()
    if stamp is None and not extraction_environment():
        print(
            f"UNAVAILABLE: no regeneration stamp, and the Aeneas Lean library is not at "
            f"{AENEAS_LEAN}, so this is not the extraction environment and nothing here "
            "could have produced one.",
            file=sys.stderr,
        )
        print("VERDICT: UNAVAILABLE")
        return 1

    defects = stamp_defects(stamp, toolchains, wanted)
    verdict = stamp_verdict(defects, extraction_environment())
    if verdict == STAMP_UNAVAILABLE:
        # THE SAME DISTINCTION THE MISSING-STAMP CASE ALREADY MAKES, applied to the STALE
        # one. `extraction_environment` exists because "no regeneration stamp" is FAIL for
        # somebody who could have regenerated and UNAVAILABLE for a host that never could.
        # A stamp whose recorded source digests no longer match is the same question one
        # step along: outside the container this process cannot regenerate, so it cannot
        # tell a committed model that is genuinely wrong from a stamp left by an earlier run
        # over a different tree — and it was reporting the second as the first.
        #
        # THAT HAS PRODUCED A FALSE FINDING TWICE. Once as `ids.rs changed after
        # extraction`, which was a branch switch; once as `crypto.rs, lib.rs changed after
        # extraction`, recorded as a defect introduced by RA-0050 — while CI's
        # `[generated-model] PASS` at a head containing that very commit says the committed
        # model reproduces from current source.
        #
        # No record is written. A `fail` record here would propagate a claim about the
        # repository that was measured about a machine; a MISSING record is INCOMPLETE,
        # which is what the aggregate should conclude from a lane that could not run.
        for defect in defects:
            print(f"UNAVAILABLE: {defect}", file=sys.stderr)
        print(
            f"The Aeneas Lean library is not at {AENEAS_LEAN}, so nothing here can "
            "regenerate. What was compared is the LOCAL regeneration stamp, which records "
            "what this machine last extracted from — not whether the committed model "
            "corresponds to this tree. Only a run inside the pinned extraction container "
            "answers that.",
            file=sys.stderr,
        )
        print("VERDICT: UNAVAILABLE")
        return 1
    if verdict == STAMP_FAIL:
        # IN the extraction environment, the observations ARE a verdict: this process could
        # have regenerated, so a stamp that does not correspond to the tree means the model
        # does not either. That is the consequence `stamp_defects` deliberately no longer
        # states on its own.
        for defect in defects:
            print(f"FAIL: {defect}", file=sys.stderr)
        print(
            "This process COULD have regenerated, so nothing above is about a missing "
            "capability: what is missing is a regeneration OF this tree, and a theorem "
            "proved against a model nothing has re-derived constrains whatever source "
            "that model was built from. Run tools/verification/regenerate-lean and "
            "commit its output.",
            file=sys.stderr,
        )
        record_units(doc, toolchains, "fail", "; ".join(defects)[:400])
        print("VERDICT: FAIL")
        return 1

    drifted = committed_drift()
    if drifted:
        print(
            "FAIL: the regenerated model differs from what is committed:", file=sys.stderr
        )
        for line in drifted:
            print(f"  {line}", file=sys.stderr)
        print(
            "The pipeline just rewrote this tree, so a difference here is either a "
            "hand-edit that\ndid not survive regeneration or a model that was never "
            "regenerated after its source moved.\nCommit the regenerated output; never "
            "edit it.",
            file=sys.stderr,
        )
        record_units(
            doc, toolchains, "fail", "the regenerated model differs from what is committed"
        )
        print("VERDICT: FAIL")
        return 1

    detail = (
        f"{len(present)} generated file(s) reproduce from the pinned pipeline over "
        f"{len(wanted)} unit(s)"
    )
    record_units(doc, toolchains, "pass", detail)
    print(f"check-generated: {detail}")
    print("VERDICT: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
