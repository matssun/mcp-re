#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""CLI over `_fingerprint.fingerprint_unit` — ADR-MCPRE-059 §2.

The encoding lives in `_fingerprint` so the graph engine and the frontier can import it;
this file is the command.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _fingerprint import fingerprint_unit  # noqa: E402
from _manifest import (  # noqa: E402
    ManifestError,
    load_assumptions,
    load_toolchains,
    load_verification,
)

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--unit", help="only this unit id; default is every unit")
    parser.add_argument(
        "--components",
        action="store_true",
        help="emit the full component set, not just the digest",
    )
    args = parser.parse_args()

    try:
        doc = load_verification()
        toolchains = load_toolchains()
        assumptions = load_assumptions()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    units = doc.get("unit", [])
    if args.unit:
        units = [unit for unit in units if unit["id"] == args.unit]
        if not units:
            print(f"FAIL: no unit {args.unit!r} declared", file=sys.stderr)
            return 1

    results = [
        fingerprint_unit(unit, doc, toolchains, assumptions) for unit in units
    ]
    if not args.components:
        for result in results:
            result.pop("components")
    print(json.dumps(results, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
