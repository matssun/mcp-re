#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Theorem assurance: fingerprints, review state, and the conjunction — §14.1, §14.7.

Shows, per declared theorem, the four axes that must hold together before a claim may be
called established:

    structural support     a unit supports it (T1, `_theorems`)
    unit evidence          every supporting unit derives FRESH (`_graph`)
    dependencies           every premise is itself established
    specification review   the owner's review covers the CURRENT theorem fingerprint

and, separately, ROOT COMPLETENESS (§28.8): whether every claim the owner declared a system
promise in `root_theorems` is established. That is a different question from freshness and is
printed under its own heading for that reason. It is report-only by default — an honest
unresolved GAP must not fail ordinary CI — and binding under `--require-root-complete`, the
mode T6 and release assurance use.

This command DERIVES and DISPLAYS. It never writes a review, and it must never grow a flag
that does: an approval is a human act recorded as a commit under `verification/reviews/`,
and a tool that could mint one on request would be the single-command self-approval §14.7
exists to prevent. `--fingerprint` prints the digest a reviewer must name in that record,
which is the only assistance a tool should offer here.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import tomllib  # noqa: E402

from _assurance_graph import (  # noqa: E402
    UNIT,
    key as graph_key,
    root_reachable,
    severities,
    unmet_obligations,
)
from _evidence_class import SEVERITIES  # noqa: E402
from _fingerprint import fingerprint_theorem, fingerprint_unit  # noqa: E402
from _graph import evaluate, load_attestations  # noqa: E402
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    load_assumptions,
    load_toolchains,
    load_verification,
)
from _review import (  # noqa: E402
    UNDECLARED,
    closure_satisfied,
    load_reviews,
    review_root,
    root_completeness,
    theorem_assurance,
)
from _premise import (  # noqa: E402
    PREMISE_CLASSES,
    open_obligations,
    roots_reaching_premises,
)
from _theorems import load_theorems  # noqa: E402


def _print_roots(roots: dict) -> None:
    """The root-completeness section — ADR-MCPRE-059 §28.8.

    Printed as its own block, under its own heading, precisely so it cannot be read as the
    freshness verdict above it. The two answer different questions and a reader who conflates
    them concludes that a fresh registry is a closed argument.
    """
    print(f"\nROOT COMPLETENESS: {roots['verdict']}")
    if roots["verdict"] == UNDECLARED:
        print(
            "  no system root is declared in theorems.toml `root_theorems`.\n"
            "  Nothing is claimed at the system boundary, so nothing about the system is\n"
            "  established — this is not a pass, and it is never reported as one."
        )
        return
    print(
        f"  {len(roots['established_roots'])} of {len(roots['roots'])} declared "
        f"system root(s) established"
    )
    for root, blocking in sorted(roots["blocking"].items()):
        print(f"\n  {root} → not established")
        for row in blocking:
            print(f"    {row['theorem']}  {row['cause']}")


def _print_premises(theorems: dict, doc: dict, assumptions: dict) -> None:
    """The typed-premise section — ADR-MCPRE-068 §7 N5, Phase 0C.

    Two facts, printed together because separately they are the state this phase ended.
    Which premises each declared root ultimately rests on, BY CLASS: an external-boundary
    premise under a root is a supply-chain statement, an open review obligation under the
    same root is a DEBT, and while all 47 records had one shape those read alike. And the
    open obligations themselves, each with the event that would discharge it, because an
    obligation nobody can see is one nobody discharges.

    Report-only, like root completeness above it and for the same §28.8 reason: a gate that
    punishes recording an obligation teaches people not to record it. What IS merge-fatal is
    a malformed declaration (the loader) and an observable event that has already come true
    (`check-assumptions`, C4).

    The severity qualifier N5 asks for — *a Critical or High root whose closure reaches one
    states that in its own row* — needs `effective_severity`, which Phase 0E derives. Until
    then every root's row is printed rather than the Medium-and-above subset, which is the
    wider report, not a narrower one.
    """
    reach = roots_reaching_premises(theorems, doc, assumptions)
    print("\nTYPED PREMISES (ADR-MCPRE-068 §7)")
    for root, rows in sorted(reach.items()):
        summary = ", ".join(
            f"{name} {len(rows[name])}" for name in PREMISE_CLASSES if rows[name]
        )
        print(f"  {root:<10} rests on {summary or 'no registered premise'}")
    obligations = open_obligations(assumptions)
    print(f"\n  {len(obligations)} open review obligation(s) — visible unresolved assurance debt")
    for entry in obligations:
        event = entry["discharging_event"]
        detail = (
            event.get("statement")
            if event["kind"] == "owner-event"
            else " ".join(f"{k}={v}" for k, v in sorted(event.items()) if k != "kind")
        )
        print(f"    {entry['id']}  [{event['kind']}] {detail}")


#: The pre-existing N1 obligations, as unit ids. See `tools/verification/verify` for why
#: this is read here rather than imported from the ratchet that governs the file.
OBLIGATION_DEBT = Path(__file__).resolve().parents[2] / "config" / "assurance-obligation-debt.toml"


def registered_obligations() -> set[str]:
    """Unit ids with a pre-existing, still-open N1 obligation row; empty when absent."""
    if not OBLIGATION_DEBT.is_file():
        return set()
    with OBLIGATION_DEBT.open("rb") as handle:
        doc = tomllib.load(handle)
    return {str(row["unit"]) for row in doc.get("obligation", [])}


def print_assurance_graph(theorems: dict, doc: dict) -> None:
    """N3's derived severities, N1's open obligations, and S5's reachability fact.

    THREE FACTS THAT ARE OFTEN CONFUSED, printed apart so a reader cannot merge them:

      * `effective_severity` is DERIVED, never stored, and is a maximum — so a proposition
        can owe more than its own label says, and never less;
      * an open N1 obligation is INCOMPLETE. A row in the migration registry bounds the
        population and records what closing it would mean; it never subtracts from the
        obligation and never adds to the assurance;
      * NOT-ROOT-REACHABLE means ONLY that no currently declared system root transitively
        depends on the proposition. The ratification is explicit that it is not low
        importance, not complete assurance, and not permission to omit evidence — which is
        why these propositions appear in the obligation counts exactly like the rest.
    """
    units = doc.get("unit", [])
    derived = severities(theorems, doc)
    reachable = root_reachable(theorems, doc, theorems.get("root_theorems", []))
    unmet = unmet_obligations(theorems, doc)
    registered = registered_obligations()

    print("\nDERIVED SEVERITY AND OPEN OBLIGATIONS (ADR-MCPRE-068 N1, N3, S5)")
    raised = [
        unit["id"]
        for unit in units
        if (row := derived[graph_key(UNIT, unit["id"])])["direct"] != row["effective"]
    ]
    print(
        f"  {len(units)} unit(s), {len(theorems.get('theorem', []))} theorem(s); "
        f"{len(raised)} proposition(s) owe MORE than their own label because a dependent "
        f"declares more (N3 — inherited severity is derived, never stored)"
    )

    unreached = sorted(
        unit["id"] for unit in units if graph_key(UNIT, unit["id"]) not in reachable
    )
    print(
        f"  {len(unreached)} unit(s) NOT-ROOT-REACHABLE — no declared root transitively "
        f"depends on them. That is a graph fact and NOT a lower obligation: "
        f"{sum(1 for uid in unreached if uid in unmet)} of them owe a falsifier."
    )

    new_debt = sorted(set(unmet) - registered)
    print(
        f"  {len(unmet)} open N1 obligation(s) — `tested`, effective Medium or higher, no "
        f"registered falsifier. Each is INCOMPLETE and does not satisfy a root assurance "
        f"dependency."
    )
    by_severity: dict[str, int] = {}
    for row in unmet.values():
        by_severity[row["effective_severity"]] = by_severity.get(row["effective_severity"], 0) + 1
    for name in reversed(SEVERITIES):
        if by_severity.get(name):
            print(f"    {name:<9} {by_severity[name]}")
    if new_debt:
        print(
            f"    {len(new_debt)} of them are NOT in the migration registry, which is closed "
            f"to new work: {new_debt}"
        )


def _root_ok(roots: dict, require: bool) -> bool:
    """Report-only unless closure mode was asked for.

    An honest unresolved GAP must not fail ordinary CI (§28.8): a gate that punishes
    recording an obligation is a gate that teaches people not to record it. Closure mode is
    where the obligation becomes binding — and `UNDECLARED` fails there too, because a
    release that declares no system promise has not proved one.
    """
    if not require:
        return True
    if closure_satisfied(roots):
        return True
    print(
        f"\nFAIL: --require-root-complete, and root completeness is {roots['verdict']}.",
        file=sys.stderr,
    )
    return False


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument(
        "--fingerprint",
        metavar="THM-NNNN",
        help="print one theorem's current fingerprint and components, for a review record",
    )
    parser.add_argument(
        "--root-completeness",
        action="store_true",
        help="print only the root-completeness section; report-only, always exits 0",
    )
    parser.add_argument(
        "--require-root-complete",
        action="store_true",
        help=(
            "closure mode: fail unless every declared system root is established. "
            "For T6 and release assurance; ordinary CI stays report-only (§28.8)"
        ),
    )
    parser.add_argument(
        "--attestations",
        type=Path,
        default=REPO_ROOT / ".verification" / "attestations",
    )
    args = parser.parse_args()

    try:
        doc = load_verification()
        assumptions = load_assumptions()
        toolchains = load_toolchains()
        theorems = load_theorems(
            {unit["id"] for unit in doc.get("unit", [])},
            [e for e in doc.get("edge", []) if e.get("kind") == "PROOF_DEPENDENCY"],
        )
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    entries = theorems.get("theorem", [])
    fingerprints = {row["id"]: fingerprint_theorem(row, theorems) for row in entries}

    if args.fingerprint:
        if args.fingerprint not in fingerprints:
            print(f"FAIL: no theorem {args.fingerprint!r} declared", file=sys.stderr)
            return 1
        print(json.dumps(fingerprints[args.fingerprint], indent=2, sort_keys=True))
        return 0

    units = doc.get("unit", [])
    current = {
        unit["id"]: fingerprint_unit(unit, doc, toolchains, assumptions) for unit in units
    }
    derived = evaluate(
        units, doc.get("edge", []), current, load_attestations(args.attestations)
    )
    assurance = theorem_assurance(
        theorems,
        fingerprints,
        load_reviews(review_root(REPO_ROOT)),
        derived["states"],
    )

    roots = root_completeness(theorems, assurance)

    if args.json:
        print(
            json.dumps(
                {"theorems": assurance, "root_completeness": roots},
                indent=2,
                sort_keys=True,
                default=list,
            )
        )
        return 0 if _root_ok(roots, args.require_root_complete) else 1

    if args.root_completeness:
        _print_roots(roots)
        return 0 if _root_ok(roots, args.require_root_complete) else 1

    if not entries:
        # Said in full rather than printed as an empty table: "no theorems are declared" and
        # "every theorem holds" are different facts, and only one of them is good news.
        print("no theorems declared in verification/policy/theorems.toml")
        print("(nothing is established, because nothing is claimed)")
        _print_roots(roots)
        return 0 if _root_ok(roots, args.require_root_complete) else 1

    print(f"theorem assurance @ policy {doc['policy_revision']}")
    for row in entries:
        state = assurance[row["id"]]
        spec_state, spec_reason = state["specification_review"]
        mark = "ESTABLISHED" if state["established"] else "not established"
        print(f"\n  {row['id']}  {row['title']}")
        print(f"    {mark}{'  (deprecated)' if state['deprecated'] else ''}")
        print(f"    specification review   {spec_state}: {spec_reason}")
        for unit_id, unit_state in sorted(state["unit_states"].items()):
            print(f"    unit://{unit_id:<28} {unit_state}")
        if not state["supporting_units"]:
            print("    no supporting unit — a stated claim awaiting evidence")
        deps = row.get("depends_on", [])
        if deps:
            print(f"    depends on             {', '.join(deps)}")
    established = sum(1 for state in assurance.values() if state["established"])
    print(f"\n  {established} of {len(entries)} theorem(s) established")
    _print_roots(roots)
    _print_premises(theorems, doc, assumptions)
    print_assurance_graph(theorems, doc)
    return 0 if _root_ok(roots, args.require_root_complete) else 1


if __name__ == "__main__":
    raise SystemExit(main())
