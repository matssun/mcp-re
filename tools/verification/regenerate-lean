#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Regenerate `verification/lean/generated/` from Rust — ADR-MCPRE-059 §8.

    Rust source → Charon → LLBC → Aeneas → generated Lean model

Generated output is machine-owned. It is never hand-edited, and a hand-edit that makes a
proof pass is a forged artifact rather than weak evidence (Operational Rule 6). This
script is the only writer of that directory; `check-generated` is the reader that proves
nothing else wrote to it.

Refuses while the pipeline is unpinned. Extraction by an unpinned Charon or Aeneas
produces a model whose relationship to the Rust is unknown, and a theorem proved against
an unknown model constrains nothing.

The pipeline runs inside the pinned Linux container (ADR-MCPRE-059 §19); Charon does not
build on macOS. The container digest is therefore one of the required pins, because the
pair (tool commit, image digest) is what identifies the extraction, not the commit alone.

Each tool's exit status is checked directly rather than through a shell pipeline. A
pipeline reports its last stage, so a failed extraction can exit 0 — and a regeneration
that silently did nothing leaves the previous model in place, which `check-generated`
would then read as fresh.

# What decides WHAT is extracted

The manifest, and only the manifest. Each V2/V3 unit names `extracted_symbols`, and those
become Charon's `--start-from` set, passed to the crate's `charon_llbc` target as
`--//bazel/charon:start_from`. Starting from the crate instead would drag in
`ed25519-dalek`, `sha2` and `serde`; starting from a list kept here would be a second
place deciding what a unit's evidence is about.

# What builds what Charon reads

Bazel. The crate's `charon_llbc` target (//bazel/charon) runs Charon over the crate Bazel
builds, with its dependencies built on the nightly Charon's driver is compiled against
(`--config=charon`) and read against the distributed standard library — Charon's own
default would build a full-MIR sysroot by running Cargo, and this lane runs none. The
launcher is pinned as `[bazelisk]` and provisioned into the machine-local `.verification/`;
the Bazel output root is the container's own, so a regeneration leaves no build tree in the
bind-mounted checkout.

`--preset=aeneas` is not optional and is not a default worth relying on: without it Aeneas
refuses the LLBC outright — *"the serialized crate was generated by Charon without the
`--preset=aeneas` option"* — after Charon has spent several minutes producing it.
"""

from __future__ import annotations

import hashlib
import os
import platform
import shutil
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _extraction_identity import definition_drift  # noqa: E402
import _rust_targets  # noqa: E402
from _lean_model import (  # noqa: E402
    GENERATED,
    build_nightly_drift,
    lakefile_roots,
    produced_roots,
    selection,
    unwritable,
    unit_crate,
    Stamp,
    current_written,
    digest,
    extraction_identity,
    write_stamp,
)
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    load_toolchains,
    load_verification,
    unpinned_identities,
)

REQUIRED = {"charon", "aeneas", "lean", "aeneas_lean_backend", "extraction_container", "bazelisk"}

#: Machine-local and gitignored: the provisioned launcher, the Bazel releases it fetches, and
#: the content-addressed download cache, kept across runs of the ephemeral container.
LOCAL = REPO_ROOT / ".verification"
#: The container's own filesystem: the build tree goes away with the container.
OUTPUT_ROOT = "/tmp/mcp-re-extraction-bazel"


def crate_sources(crate: str) -> dict[str, str]:
    """Every input a change to which can change this crate's extracted model.

    A SUPERSET of what Charon actually read, deliberately. `--start-from` pulls in whatever
    the named items call, so the true read-set is decided inside the tool and is not
    reported by it. Over-recording invalidates a model that did not need regenerating;
    under-recording lets an edit to a called function leave a stale model reading as fresh.
    Only one of those two errors can produce a false green.
    """
    # What Bazel compiles: the sources of the crate's libraries and of the first-party
    # libraries they depend on, each package's BUILD file, and what decides the crates it is
    # compiled against — the module (the nightly the dependencies are built on), the crate
    # lock, and the rule that invokes Charon.
    table = _rust_targets.table()
    packages = _rust_targets.dependency_closure(crate)
    files = {
        REPO_ROOT / src
        for row in table.values()
        if row["kind"] == "rust_library" and row["package"] in packages
        for src in row["srcs"]
    }
    files |= {REPO_ROOT / package / "BUILD.bazel" for package in packages}
    files |= {
        REPO_ROOT / "MODULE.bazel",
        REPO_ROOT / "bazel" / "crates.lock",
        REPO_ROOT / "bazel" / "charon" / "defs.bzl",
    }
    return {str(path.relative_to(REPO_ROOT)): digest(path) for path in sorted(files) if path.is_file()}


def run(argv: list[str], cwd: Path, what: str, env: dict[str, str] | None = None) -> None:
    """Run one pipeline stage, and fail on ITS status.

    Streams are merged and printed whole on failure: the previous form of this pipeline
    exited 101 with no captured diagnostic, which says an extraction stopped without
    saying why.
    """
    print(f"regenerate-lean: {what}\n  $ {' '.join(argv)}")
    proc = subprocess.run(
        argv,
        cwd=cwd,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        print(proc.stdout.strip(), file=sys.stderr)
        print(f"FAIL: {what} exited {proc.returncode}", file=sys.stderr)
        raise SystemExit(1)


def bazel_launcher(toolchains: dict) -> Path:
    """The pinned Bazel launcher, provisioned if absent and checked either way.

    Machine-local rather than in the image: the launcher is pinned by digest in the lock,
    and a file whose bytes are not those is refused before anything runs through it.
    """
    if platform.system() != "Linux" or platform.machine() not in ("aarch64", "arm64"):
        raise SystemExit(f"FAIL: the extraction lane runs on linux/arm64, not {platform.system()}/{platform.machine()}")
    pin = toolchains["bazelisk"]
    digest = str(pin["linux_arm64_sha256"]).removeprefix("sha256:")
    path = LOCAL / "tools" / f"bazelisk-{digest[:16]}"
    if not path.is_file():
        path.parent.mkdir(parents=True, exist_ok=True)
        staged = path.with_suffix(".download")
        with urllib.request.urlopen(str(pin["linux_arm64_url"]), timeout=120) as resp:
            staged.write_bytes(resp.read())
        staged.chmod(0o755)
        staged.replace(path)
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise SystemExit(f"FAIL: {path} is not the pinned launcher (the lock records sha256:{digest})")
    return path


def bazel_argv(launcher: Path, command: str, *args: str) -> list[str]:
    return [
        str(launcher),
        f"--output_user_root={OUTPUT_ROOT}",
        command,
        "--lockfile_mode=off",
        "--symlink_prefix=/",
        "--noshow_progress",
        f"--repository_cache={LOCAL / 'bazel-repository-cache'}",
        # The contents cache holds extracted repositories and would sit inside the checkout,
        # which Bazel refuses; the download cache above is what survives the container.
        "--repo_contents_cache=",
        "--config=charon",
        *args,
    ]


def llbc_target(crate: str) -> str:
    """The `charon_llbc` target of the crate a unit's paths name."""
    found = [
        label
        for label, row in _rust_targets.table().items()
        if row["kind"] == "charon_llbc" and row["package"] == crate
    ]
    if len(found) != 1:
        raise SystemExit(f"FAIL: {crate} has {len(found)} charon_llbc target(s); extraction needs exactly one")
    return found[0]


def extract(unit: dict, crate: str, launcher: Path, aeneas: str, into: Path) -> None:
    """One unit's Rust → LLBC → Lean, into `into`.

    THE LLBC'S BASENAME DECIDES THE LEAN MODULE NAME. Measured: `m.llbc` produces `M.lean`
    and `mcp_re_core.llbc` produces `McpReCore.lean`. The `charon_llbc` target names it
    after the CRATE, which is what `lakefile.toml`'s `Generated` roots declare.

    Two units extracting the same crate would write the same file, which is why the caller
    compares what was produced against those declared roots rather than trusting this.
    """
    label = llbc_target(crate)
    start_from = f"--//bazel/charon:start_from={','.join(str(s) for s in unit['extracted_symbols'])}"
    env = {**os.environ, "BAZELISK_HOME": str(LOCAL / "bazelisk")}
    run(bazel_argv(launcher, "build", start_from, label), REPO_ROOT, f"{unit['id']}: Charon over {crate}", env)
    listed = subprocess.run(
        bazel_argv(launcher, "cquery", start_from, "--output=files", label),
        cwd=REPO_ROOT, env=env, capture_output=True, text=True, check=False,
    ).stdout.split()
    exec_root = subprocess.run(
        bazel_argv(launcher, "info", start_from, "execution_root"),
        cwd=REPO_ROOT, env=env, capture_output=True, text=True, check=False,
    ).stdout.strip()
    llbc = Path(exec_root) / listed[0] if listed and exec_root else None
    if llbc is None or not llbc.is_file():
        print(
            f"FAIL: {label} reported success but left no LLBC. A regeneration that produced "
            "nothing leaves the previous model in place, which reads as fresh.",
            file=sys.stderr,
        )
        raise SystemExit(1)
    run(
        [aeneas, "-backend", "lean", "-dest", str(into), str(llbc)],
        REPO_ROOT,
        f"{unit['id']}: Aeneas to Lean",
        env,
    )


def replace_generated(staged: Path) -> None:
    """Swap the staged model in, whole.

    Wholesale rather than file-by-file: an extraction that stops emitting a file must
    REMOVE it, and a merge would leave the orphan behind for a theorem to keep importing.
    """
    if GENERATED.is_dir():
        for path in sorted(GENERATED.iterdir()):
            if path.name == ".gitkeep":
                continue
            shutil.rmtree(path) if path.is_dir() else path.unlink()
    GENERATED.mkdir(parents=True, exist_ok=True)
    for path in sorted(staged.iterdir()):
        target = GENERATED / path.name
        shutil.copytree(path, target) if path.is_dir() else shutil.copy2(path, target)


def main() -> int:
    try:
        toolchains = load_toolchains()
        doc = load_verification()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    # ASKED FIRST, before anything about the toolchain. With no unit declaring extracted
    # evidence there is nothing to regenerate, and reporting an unpinned or stale pipeline
    # would be answering a question nobody asked with a failure.
    units = [unit for unit in doc.get("unit", []) if unit["class"] in {"V2", "V3"}]
    if not units:
        print("regenerate-lean: NOT_REQUIRED — no V2/V3 unit declares extracted evidence")
        print("VERDICT: NOT_REQUIRED")
        return 0

    unpinned = unpinned_identities(toolchains, REQUIRED)
    if unpinned:
        print(
            "FAIL: cannot regenerate — the extraction pipeline is unpinned "
            f"({', '.join(f'{k} ({v})' for k, v in unpinned.items())}).\n"
            "Pin Charon, Aeneas, Lean, the Aeneas Lean backend, and the extraction\n"
            "container in verification/policy/toolchains.lock.toml first.",
            file=sys.stderr,
        )
        return 1

    # A pin can be resolved and still not name a build of the definition this tree
    # declares. Regenerating under one would write a model that no declared instrument
    # produced — and unlike the verify lane, this one WRITES, so the mismatch would be
    # baked into the repository rather than reported.
    drift = definition_drift(toolchains) or build_nightly_drift(toolchains)
    if drift:
        print(f"FAIL: {drift}", file=sys.stderr)
        return 1

    # ASKED BEFORE THE EXTRACTION, not after it. This script's whole output is a write into
    # the mounted workspace, and a container mount that is read-only — the default in some
    # colima configurations, and dev1's Docker is colima — would let Charon and Aeneas run
    # for twenty minutes and then fail in `replace_generated` with a traceback some distance
    # from its cause.
    why = unwritable(GENERATED)
    if why is not None:
        print(
            f"FAIL: cannot write to {GENERATED} ({why}). This script's only output is a "
            "write into the mounted workspace, so a read-only mount means it can produce "
            "nothing.\nCheck how the workspace is mounted into the container.",
            file=sys.stderr,
        )
        return 1

    # CHARON_EXE is read by the `charon_install` repository, which links the container's
    # Charon into the build; AENEAS_EXE is run here.
    aeneas = os.environ.get("AENEAS_EXE", "")
    if not (os.environ.get("CHARON_EXE") and aeneas):
        print(
            "FAIL: CHARON_EXE and AENEAS_EXE are unset, so this is not the pinned "
            "extraction container.\nCharon links the private rustc crates and does not "
            "build on macOS; run this inside the\nimage pinned as [extraction_container].",
            file=sys.stderr,
        )
        return 1

    launcher = bazel_launcher(toolchains)
    sources: dict[str, str] = {}
    with tempfile.TemporaryDirectory() as tmp:
        staged = Path(tmp) / "lean"
        staged.mkdir()
        for unit in units:
            crate = unit_crate(unit)
            if crate is None:
                print(
                    f"FAIL: unit {unit['id']} is class {unit['class']} but its paths name "
                    "no single crate to extract from.",
                    file=sys.stderr,
                )
                return 1
            sources.update(crate_sources(crate))
            extract(unit, crate, launcher, aeneas, staged)

        # EVERY check runs against the STAGED output, before the repository's model is
        # touched. A regeneration that fails must not have destroyed the model it was going
        # to replace: the previous one is the only thing a reader still has, and a tree left
        # holding a rejected extraction is worse than one holding a stale accepted model.
        names = [
            str(path.relative_to(staged))
            for path in sorted(staged.rglob("*"))
            if path.is_file()
        ]
        if not names:
            print(
                "FAIL: the pipeline reported success and produced no model. A regeneration "
                "that writes nothing is not a regeneration.",
                file=sys.stderr,
            )
            return 1

        # The extraction and the build definition must agree about which modules exist. They
        # are two places holding one fact — Aeneas decides it from the llbc basename,
        # `lakefile.toml` declares it — and the direction they drift in is silent: a module
        # the package does not build elaborates for nobody, and `verify-lean` would then
        # report a theorem it could not find rather than the reason it could not find it.
        produced = produced_roots(names)
        declared = lakefile_roots("generated")
        if produced != declared:
            print(
                f"FAIL: the extraction produced {produced or '[]'} and verification/lean/"
                f"lakefile.toml's generated library declares roots {declared}. A module the "
                "package does not build is a model nothing elaborates against.",
                file=sys.stderr,
            )
            return 1

        replace_generated(staged)

    written = current_written()
    write_stamp(
        Stamp(
            identity=extraction_identity(toolchains),
            selection=selection(doc),
            sources=sources,
            written=written,
        )
    )
    print(f"\nregenerate-lean: {len(written)} file(s) from {len(units)} unit(s)")
    for name in sorted(written):
        print(f"  {name}")
    print("VERDICT: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
