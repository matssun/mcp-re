#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Regenerate `verification/lean/generated/` from Rust — ADR-MCPRE-059 §8.

    Rust source → Charon → LLBC → Aeneas → generated Lean model

Generated output is machine-owned. It is never hand-edited, and a hand-edit that makes a
proof pass is a forged artifact rather than weak evidence (Operational Rule 6). This
script is the only writer of that directory; `check-generated` is the reader that proves
nothing else wrote to it.

Refuses while the pipeline is unpinned. Extraction by an unpinned Charon or Aeneas
produces a model whose relationship to the Rust is unknown, and a theorem proved against
an unknown model constrains nothing.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _manifest import ManifestError, load_toolchains, unresolved_pins  # noqa: E402

REQUIRED = {"charon", "aeneas", "lean", "aeneas_lean_backend"}


def main() -> int:
    try:
        toolchains = load_toolchains()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    missing = sorted(REQUIRED & set(unresolved_pins(toolchains)))
    if missing:
        print(
            "FAIL: cannot regenerate — the extraction pipeline is unpinned "
            f"({', '.join(missing)}).\n"
            "Pin Charon, Aeneas, Lean, and the Aeneas Lean backend in\n"
            "verification/policy/toolchains.lock.toml first.",
            file=sys.stderr,
        )
        return 1

    print(
        "FAIL: the pipeline is pinned but regeneration is not implemented yet.\n"
        "Implement the Charon → LLBC → Aeneas → Lean invocation here.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
