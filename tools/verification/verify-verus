#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""The authoritative Verus lane — ADR-MCPRE-059 §16, Operational Rule 5.

CI runs full verification for the selected scope (`cargo verus verify -p <crate>`).
`cargo verus focus` is a local developer convenience and is NEVER authoritative evidence:
a proof checked over part of a crate does not establish the crate's obligations, and a
lane that accepted focus output would be reporting a proof it did not have.

The lane resolves its prover from the pins in `verification/policy/toolchains.lock.toml`
and never falls back to whatever `verus`/`z3` happen to be on PATH. A proof checked by a
prover of unknown identity is not evidence, and reporting it as a pass would be exactly
the "stale or mismatched cache accepted as proof" threat the ADR names.

A lane with no V1/V3 unit to check is SKIPPED, whether or not the toolchain is pinned:
Phase 1 pins the toolchain and Phase 2 produces the first pilot, so the interval between
them is a legitimately empty lane rather than a failure.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _manifest import (  # noqa: E402
    ManifestError,
    load_toolchains,
    load_verification,
    unresolved_pins,
)

REQUIRED = {"verus", "verus.vstd", "verus.z3", "rust"}


def main() -> int:
    try:
        toolchains = load_toolchains()
        doc = load_verification()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    missing = sorted(REQUIRED & set(unresolved_pins(toolchains)))
    verus_units = [unit for unit in doc.get("unit", []) if unit["class"] in {"V1", "V3"}]

    if not verus_units:
        # NOT_REQUIRED, not SKIPPED: the manifest asks nothing of this lane, which is a
        # legitimate state and must not hold the aggregate back. SKIPPED would mean the
        # lane was required and deliberately not run.
        state = "unpinned" if missing else "pinned, lane not implemented"
        print(f"verify-verus: NOT_REQUIRED — no V1/V3 unit declared ({state})")
        print("VERDICT: NOT_REQUIRED")
        if missing:
            print(f"  unresolved: {', '.join(missing)}")
            print(
                "  pin these in verification/policy/toolchains.lock.toml to enable this lane"
            )
        return 0

    if missing:
        print(
            "FAIL: units are declared V1/V3 but the Verus toolchain is unpinned "
            f"({', '.join(missing)}).\n"
            "A unit cannot claim Verus evidence that no pinned prover produced.",
            file=sys.stderr,
        )
        return 1

    print(
        "FAIL: units are declared V1/V3 but this lane has no implementation yet.\n"
        "Implement `cargo verus verify` invocation here before declaring any V1 unit.\n"
        "Refusing rather than reporting a pass: an unimplemented lane that exits 0 is a\n"
        "green that measured nothing.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
