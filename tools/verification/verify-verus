#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""The authoritative Verus lane — ADR-MCPRE-059 §16, Operational Rule 5.

The lane verifies the whole crate: each V1/V3 unit's crate has a `verus_verify` target
(`//bazel/verus:defs.bzl`) that runs the pinned prover over the crate Bazel builds, with its
specification features on and its verified dependencies' specifications imported. A proof
checked over part of a crate does not establish the crate's obligations, and a lane that
accepted partial output would be reporting a proof it did not have.

The lane resolves its prover from the pins in `verification/policy/toolchains.lock.toml`
and never falls back to whatever `verus`/`z3` happen to be on PATH. A proof checked by a
prover of unknown identity is not evidence, and reporting it as a pass would be exactly
the "stale or mismatched cache accepted as proof" threat the ADR names.

The install root is a path outside the repository, on a persistent runner, so agreeing on
the path establishes nothing about the bytes there. Every identity the lock records is
compared before any verdict, and the lane refuses if one is absent:

  * every file `verification/policy/toolchains.lock.toml` names by digest must digest to
    it — `vstd.vir` and `libvstd.rlib`, the `verus.binaries` executables, and the pinned
    solver. The set comes from the lock, so pinning one more artefact is an edit there;
  * the release's `version.json` must declare the pinned commit, checked before the run
    rather than taken from the run's own report.

That set used to be `vstd.vir` and the commit alone, which established that the pinned
SPECIFICATION LIBRARY was installed and was read as establishing that the pinned PROVER
was. It does not: a substituted `rust_verify` shipping the pinned vstd beside a truthful
version.json passed both, and the solver — the component that decides each obligation —
was identified by a sentence about where it came from rather than by its bytes.

None of this is a signature. What it closes is the weaker and more common case: a digest
recorded in the lock and compared against nothing, which has exactly the standing of no
check while the repository believes otherwise.

The solver is NAMED, not inherited. The prover runs as a Bazel action with an environment
the rule states: `VERUS_Z3_PATH` is the install's own `z3`, an input of the action, so the
file this lane digested and the file the prover executes are the same one — a caller's
exported `VERUS_Z3_PATH` never reaches it. So is the compiler: the prover runs on the
registered Rust toolchain's `librustc_driver`, with no rustup.

A lane with no V1/V3 unit to check is NOT_REQUIRED, whether or not the toolchain is
pinned: the manifest asks nothing of it, which is a legitimately empty lane rather than a
failure. It is not SKIPPED, which would mean the lane was required and deliberately not
run, and it is not PASS, which would mean a proof was checked.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _evidence import EvidenceRecord, evidence_store, write_record  # noqa: E402
from _fingerprint import fingerprint_unit  # noqa: E402
from _manifest import (  # noqa: E402
    REPO_ROOT,
    ManifestError,
    load_assumptions,
    load_toolchains,
    load_verification,
    unpinned_identities,
)
from _unit_selection import (  # noqa: E402
    add_unit_argument,
    basis,
    filter_by_unit,
    refuse,
    selection_error,
)
from _verus_results import evaluate_unit, parse_reports  # noqa: E402
import _verus_nonvacuity  # noqa: E402
from _ecosystems import unit_projects  # noqa: E402
import _rust_targets  # noqa: E402

REQUIRED = {"verus", "verus.binaries", "verus.vstd", "verus.z3", "rust"}

#: Where this lane deposits what it measured. The record is written for a FAILED unit too:
#: a failure at a known fingerprint is evidence, and suppressing it would leave the last
#: passing attestation standing while the proof is broken.
EVIDENCE_STORE = evidence_store()


def unit_target(unit: dict) -> tuple[str | None, dict | None]:
    """The `verus_verify` target that carries this unit's specifications, and its row.

    Derived from the unit's declared paths rather than configured separately: a unit
    whose paths move to another crate must not keep verifying the crate it left. None
    unless the paths name exactly one Bazel package and it holds exactly one such target.
    """
    projects = unit_projects(unit)
    if len(projects) != 1:
        return None, None
    found = [
        (label, row)
        for label, row in _rust_targets.table().items()
        if row["kind"] == "verus_verify" and row["package"] == projects[0]
    ]
    return found[0] if len(found) == 1 else (None, None)


def build_and_read(label: str) -> tuple[str | None, str, str, int | None]:
    """Build the unit's `verus_verify` target and read what the prover recorded.

    Returns (why the build could not run, report, log, prover exit status). The prover's
    status is an OUTPUT of the action rather than the action's own: a failed proof is a
    result to report, not a build error that would hide the report. A cached action is the
    same measurement — every prover file, source and dependency is one of its inputs.
    """
    proc = subprocess.run(
        ["bazel", "build", label], cwd=REPO_ROOT, capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        return f"bazel build {label} failed:\n{proc.stderr[-3000:]}", "", "", None
    listed = subprocess.run(
        ["bazel", "cquery", "--output=files", label],
        cwd=REPO_ROOT, capture_output=True, text=True, check=False,
    ).stdout.split()
    outputs = {Path(f).suffix: REPO_ROOT / f for f in listed}
    try:
        report = outputs[".json"].read_text()
        log = outputs[".log"].read_text()
        status = int(outputs[".status"].read_text().strip())
    except (KeyError, OSError, ValueError) as exc:
        return f"{label} left no readable report, log and status ({exc})", "", "", None
    return None, report, log, status


#: The units whose proved contracts the non-vacuity probe answers for. Selecting one runs it.
NONVACUITY_UNITS = {"http_profile.artifact_typing"}


def nonvacuity_probe() -> int:
    """Run the artifact verifiers' non-vacuity probe; 1 when it does not refuse as it must.

    r12 Ruling 38 §7. The units' own runs establish that the verifiers' postconditions hold;
    this establishes that the postconditions over the uninterpreted thumbprint functions
    CONSTRAIN — see `_verus_nonvacuity`.
    """
    label = _verus_nonvacuity.LABEL
    print(f"verify-verus: non-vacuity probe -> bazel build {label}")
    problem, output, log, status = build_and_read(label)
    if problem is not None:
        print(f"  FAIL: {problem}", file=sys.stderr)
        return 1
    source = (REPO_ROOT / _verus_nonvacuity.SOURCE).read_text(encoding="utf-8")
    ok, detail = _verus_nonvacuity.evaluate(parse_reports(output), log, status, source)
    if not ok:
        print(f"  FAIL: {detail}", file=sys.stderr)
        return 1
    print(f"  PASS: {detail}")
    return 0


def _pinned_files(toolchains: dict) -> dict[str, str]:
    """Every file under the install root the lock names by digest, path -> `sha256:…`.

    Assembled from the lock rather than listed here, so pinning one more artefact is an
    edit to `toolchains.lock.toml` and to nothing else. A hard-coded list would be a second
    place that decides what the prover IS, and the two would diverge the first time only
    one was updated.
    """
    verus = toolchains["verus"]
    pinned = {
        name: str(digest)
        for name, digest in verus.get("binaries", {}).items()
        if name != "state" and not isinstance(digest, dict) and name != "note"
    }
    rlib = str(verus.get("vstd", {}).get("rlib_identity", ""))
    if rlib:
        pinned["libvstd.rlib"] = rlib
    solver = verus.get("z3", {})
    solver_identity = str(solver.get("identity", ""))
    if solver_identity:
        pinned[str(solver.get("path", "z3"))] = solver_identity
    return pinned


def _pinned_file_mismatch(toolchains: dict, install_root: Path) -> str | None:
    """Why the files under `install_root` are not the pinned ones, or None.

    R9-C070 / R9-C083. `vstd.vir` and the declared commit established that the pinned
    SPECIFICATION LIBRARY was installed, and that was read as establishing that the pinned
    PROVER was. It does not: a substituted `rust_verify` shipping the pinned vstd beside a
    truthful `version.json` passed both checks, and the solver — the component that decides
    each obligation — was identified by a sentence about where it came from.

    A digest recorded in the lock and compared against nothing is not a weaker check than
    this one. It is the same standing as no check, with the repository believing otherwise,
    which is why the `libvstd.rlib` digest sitting unread in a `note` field counted as a
    finding rather than as documentation.
    """
    pinned_files = _pinned_files(toolchains)
    # EVERY identity's SHAPE first, before any file is looked at. A lock recording prose
    # where a digest belongs is a defect in the lock, and it is one whether or not the
    # prover is installed — so it must not be reachable only after every file above it
    # alphabetically happens to be present. Interleaving the two checks let an absent
    # binary mask the solver's unusable `identity`, which is the finding hiding behind an
    # unrelated symptom.
    for name, pinned in sorted(pinned_files.items()):
        if not pinned.startswith("sha256:"):
            return (
                f"the lock identifies {name} as {pinned!r}, which is not a digest. An "
                f"identity that cannot be compared with the bytes on disk is not an "
                f"identity."
            )
    for name, pinned in sorted(pinned_files.items()):
        path = install_root / name
        if not path.is_file():
            return f"the pinned prover is incomplete: {path} is missing"
        digest = "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()
        if digest != pinned:
            return (
                f"{name} identity mismatch: {path} digests to {digest[:23]}, the lock "
                f"records {pinned[:23]}. The installation is not the pinned release."
            )
    return None


def _unpinned_detail(unpinned: dict[str, str]) -> str:
    """Each unpinned identity with its reason, so the message names the right remedy.

    `verus.z3 absent` and `verus.z3 unresolved` are the same disqualification and different
    repairs: the first is a lock that does not know the solver exists, the second a lock
    that knows and has no identity to record yet.
    """
    return ", ".join(f"{name} ({reason})" for name, reason in sorted(unpinned.items()))


def installed_identity(toolchains: dict, install_root: Path) -> str | None:
    """Why the installation at `install_root` is NOT the pinned prover, or None.

    Content, not location. The lock records `verus.vstd.identity` and `verus.commit`; until
    something compares them against the files on disk, both are decoration and the lane's
    only real claim is that some executable exists at an agreed path.
    """
    pinned_vstd = str(toolchains["verus"].get("vstd", {}).get("identity", ""))
    if not pinned_vstd.startswith("sha256:"):
        return (
            "the lock records no `verus.vstd.identity` digest, so the prover's "
            "specification library cannot be identified"
        )
    vstd = install_root / "vstd.vir"
    if not vstd.is_file():
        return f"the pinned prover's specification library is missing at {vstd}"
    digest = "sha256:" + hashlib.sha256(vstd.read_bytes()).hexdigest()
    if digest != pinned_vstd:
        return (
            f"vstd identity mismatch: {vstd} digests to {digest[:23]}, the lock records "
            f"{pinned_vstd[:23]}. The installation is not the pinned release."
        )

    mismatch = _pinned_file_mismatch(toolchains, install_root)
    if mismatch is not None:
        return mismatch

    pinned_commit = str(toolchains["verus"].get("commit", ""))
    version_file = install_root / "version.json"
    if not version_file.is_file():
        return f"the pinned prover declares no identity: {version_file} is missing"
    try:
        declared = json.loads(version_file.read_text(encoding="utf-8"))["verus"]["commit"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return f"{version_file} does not declare a verus commit"
    if declared != pinned_commit:
        return (
            f"installed prover declares commit {str(declared)[:12]}, the lock pins "
            f"{pinned_commit[:12]}"
        )
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    add_unit_argument(parser)
    args = parser.parse_args()
    try:
        toolchains = load_toolchains()
        doc = load_verification()
        assumptions = load_assumptions()
    except ManifestError as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    # R9-C069. Absence and `state = "unresolved"` are one fact — the tool's identity is
    # unknown — and both disqualify the lane. `REQUIRED & unresolved_pins(...)` could only
    # see an identity someone had written down and marked unresolved, so DELETING
    # `[verus.z3]` or `[rust]` left this set empty and the lane ran against whatever the
    # environment supplied. The reasons are kept apart in the message because the remedies
    # are opposite, and never in the decision.
    unpinned = unpinned_identities(toolchains, REQUIRED)
    missing = sorted(unpinned)
    verus_units = [unit for unit in doc.get("unit", []) if unit["class"] in {"V1", "V3"}]
    total = len(verus_units)
    if args.unit:
        declared = {unit["id"] for unit in doc.get("unit", [])}
        applicable = {unit["id"] for unit in verus_units}
        problem = selection_error(args.unit, declared, applicable, "Verus evidence")
        if problem:
            return refuse("verify-verus", problem)
        verus_units = filter_by_unit(verus_units, args.unit, lambda unit: unit["id"])
    print(
        "verify-verus: selection basis — "
        + basis(args.unit, len(verus_units), total, f"every V1/V3 unit ({total})")
    )

    if not verus_units:
        # NOT_REQUIRED, not SKIPPED: the manifest asks nothing of this lane, which is a
        # legitimate state and must not hold the aggregate back. SKIPPED would mean the
        # lane was required and deliberately not run.
        state = "unpinned" if missing else "pinned, lane not implemented"
        print(f"verify-verus: NOT_REQUIRED — no V1/V3 unit declared ({state})")
        print("VERDICT: NOT_REQUIRED")
        if missing:
            print(f"  unpinned: {_unpinned_detail(unpinned)}")
            print(
                "  pin these in verification/policy/toolchains.lock.toml to enable this lane"
            )
        return 0

    if missing:
        print(
            "FAIL: units are declared V1/V3 but the Verus toolchain is unpinned "
            f"({_unpinned_detail(unpinned)}).\n"
            "A unit cannot claim Verus evidence that no pinned prover produced.",
            file=sys.stderr,
        )
        return 1

    pinned_commit = str(toolchains["verus"].get("commit", ""))
    install_root = Path(toolchains["verus"]["install_root"])
    driver = install_root / "verus"
    if not driver.is_file():
        print(
            f"UNAVAILABLE: the pinned prover is not installed at {driver}.\n"
            "Not a FAIL — an absent toolchain is a missing measurement, not a failed one —\n"
            "and not a PASS, because nothing was proved.",
            file=sys.stderr,
        )
        print("VERDICT: UNAVAILABLE")
        return 1

    # A wrong installation is a FAIL, not UNAVAILABLE: something IS installed at the pinned
    # path and it is not what the lock describes, which is a stronger statement than "the
    # measurement is missing" and must not be recoverable by installing anything.
    wrong = installed_identity(toolchains, install_root)
    if wrong is not None:
        print(f"FAIL: {wrong}", file=sys.stderr)
        print(
            "The lock's recorded identity is compared against the installation before any "
            "proof is\nattributed to it. Re-install the pinned release, or re-pin the lock "
            "deliberately.",
            file=sys.stderr,
        )
        print("VERDICT: FAIL")
        return 1

    # The prover runs on Bazel's Rust toolchain, and loads that toolchain's compiler driver:
    # the release's declared toolchain must BE the pinned channel, or the driver it links
    # is not there to load and every unit fails on a dynamic-loader error that names neither.
    declared = str(
        json.loads((install_root / "version.json").read_text()).get("verus", {}).get("toolchain", "")
    )
    channel = str(toolchains["rust"].get("channel", ""))
    if not declared.startswith(f"{channel}-"):
        print(
            f"FAIL: the pinned Verus release is built against the {declared or 'unstated'} "
            f"toolchain and the build pins {channel}. The prover runs on the build's own "
            "compiler driver, so the two move together or the lane cannot run.",
            file=sys.stderr,
        )
        print("VERDICT: FAIL")
        return 1

    failures = 0
    for unit in verus_units:
        # Taken BEFORE the prover runs, and recorded alongside the result: the record must
        # say which source was measured, not which source exists when someone later reads
        # it. This is the binding the issuer checks.
        measured_at = fingerprint_unit(unit, doc, toolchains, assumptions)["fingerprint"]

        def record(
            result: str,
            detail: str,
            prover: dict | None = None,
            unit_id: str = unit["id"],
            fingerprint: str = measured_at,
        ) -> None:
            write_record(
                EVIDENCE_STORE,
                EvidenceRecord(
                    unit_id=unit_id,
                    lane="verus",
                    result=result,
                    fingerprint=fingerprint,
                    detail=detail,
                    prover=prover,
                ),
            )

        label, row = unit_target(unit)
        if label is None or row is None:
            print(
                f"FAIL: unit {unit['id']} is class {unit['class']} but its paths name no "
                "crate with a `verus_verify` target.",
                file=sys.stderr,
            )
            record("fail", "the unit's paths name no single crate with a verus_verify target")
            failures += 1
            continue
        crate = str(row["crate_name"])
        # The unit's specification features must be on in the run it claims. A target that
        # verified the crate without them checked a crate whose specifications were cfg'd
        # out — `vstd::prelude::*` absent, every proof vacuous.
        absent = sorted(set(unit.get("features", [])) - set(row["features"]))
        if absent:
            detail = f"{label} does not turn on the unit's specification feature(s) {absent}"
            print(f"FAIL: {unit['id']}: {detail}", file=sys.stderr)
            record("fail", detail)
            failures += 1
            continue
        print(f"verify-verus: {unit['id']} -> bazel build {label}")
        problem, output, log, status = build_and_read(label)
        if problem is not None:
            print(f"  FAIL: {problem}", file=sys.stderr)
            record("fail", problem)
            failures += 1
            continue
        reports = parse_reports(output)
        ok, detail = evaluate_unit(
            reports,
            crate,
            list(unit.get("proved_symbols", [])),
            pinned_commit,
        )
        prover = {"commit": pinned_commit}
        if reports:
            prover = {"commit": reports[0].commit, "version": reports[0].version}
        if not ok or status != 0:
            print(f"  FAIL: {detail} (exit {status})", file=sys.stderr)
            print((log.strip() or output.strip())[-4000:], file=sys.stderr)
            record("fail", f"{detail} (exit {status})", prover)
            failures += 1
        else:
            print(f"  PASS: {detail}")
            record("pass", detail, prover)

    if any(unit["id"] in NONVACUITY_UNITS for unit in verus_units):
        failures += nonvacuity_probe()

    if failures:
        print(
            f"\nFAIL: {failures} of {len(verus_units)} Verus unit(s) did not verify.",
            file=sys.stderr,
        )
        print("VERDICT: FAIL")
        return 1

    print(f"\nverify-verus: PASS — {len(verus_units)} unit(s) verified")
    print("VERDICT: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
