load("//bazel:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

# ADR-MCPRE-066 §2.1: the source tree, exposed so the conformance audit-vocabulary guard can
# MEASURE which files decide what an `mcp-re.*` verdict token says, rather than reading a
# hand-maintained list of producers. The sentinel names the tree; the guard walks it.
filegroup(
    name = "guard_src_files",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# Test-only helper: resolve child-process binaries and data fixtures under Bazel runfiles.
# Each test target sets the env keys it reads to `$(rlocationpath ...)`. Pure std-only.
nt_rust_library(
    name = "mcp_re_test_paths",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mcp_re_test_paths",
    edition = "2021",
    deps = [],
)

nt_rust_test(
    name = "mcp_re_test_paths_test",
    crate = ":mcp_re_test_paths",
    data = ["src/lib.rs"],
    env = {
        "MCP_RE_TEST_PATHS_MISSING": "_main/mcp-re-test-paths/no-such-file",
        "MCP_RE_TEST_PATHS_PROBE": "$(rlocationpath src/lib.rs)",
    },
)
