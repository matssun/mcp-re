load("//bazel:defs.bzl", "nt_rust_library")

package(default_visibility = ["//visibility:public"])

# ADR-MCPRE-066 §2.1: the source tree, exposed so the conformance audit-vocabulary guard can
# MEASURE which files decide what an `mcp-re.*` verdict token says, rather than reading a
# hand-maintained list of producers. The sentinel names the tree; the guard walks it.
filegroup(
    name = "guard_src_files",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# Test-only helper: resolve child-process binaries and data fixtures under
# Bazel runfiles OR a plain Cargo build. The Bazel branch is a no-op pass-
# through (env vars are already set by the test target); the cargo-fallback
# branches activate only under `cargo test`. Pure std-only library.
nt_rust_library(
    name = "mcp_re_test_paths",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mcp_re_test_paths",
    edition = "2021",
    deps = [],
)
