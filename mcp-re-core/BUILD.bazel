load("//bazel:defs.bzl", "nt_rust_library", "nt_rust_test")
load("//bazel/charon:defs.bzl", "charon_llbc")
load("//bazel/verus:defs.bzl", "verus_verify")

package(default_visibility = ["//visibility:public"])

# ADR-MCPRE-066 §2.1: the source tree, exposed so the conformance audit-vocabulary guard can
# MEASURE which files decide what an `mcp-re.*` verdict token says, rather than reading a
# hand-maintained list of producers. The sentinel names the tree; the guard walks it.
filegroup(
    name = "guard_src_files",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# ADR-MCPS-011/012: mcp-re-core stays pure (no networking / async / filesystem).
# Crate deps come from the isolated `crates_mcp_re` crate_universe hub. They are named here,
# not derived, so `firewall_test` reads the exact set this library links.
nt_rust_library(
    name = "mcp_re_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mcp_re_core",
    edition = "2021",
    deps = [
        "@crates_mcp_re//:base64",
        "@crates_mcp_re//:ed25519-dalek",
        "@crates_mcp_re//:serde",
        "@crates_mcp_re//:serde_json",
        "@crates_mcp_re//:sha2",
        "@crates_mcp_re//:thiserror",
    ],
)

nt_rust_test(
    name = "mcp_re_core_test",
    crate = ":mcp_re_core",
    edition = "2021",
    deps = [
        "@crates_mcp_re//:hex",
        "@crates_mcp_re//:zeroize",
    ],
)

# ADR-MCPS-034: the Core source tree, exposed so the method-name drift guard in
# mcp-re-conformance can scan non-test mcp-re-core/src for banned MCP method-name
# literals from DISK (via runfiles) — the same data-dep scheme the conformance
# drift_guard uses for the vector fixtures.
filegroup(
    name = "src_files",
    srcs = glob(["src/**/*.rs"]),
)
# The crates `mcp_re_core` links, direct and transitive, read off the build graph.
genquery(
    name = "mcp_re_core_dependency_closure",
    expression = 'kind("rust_library|rust_proc_macro", deps(//mcp-re-core:mcp_re_core))',
    opts = ["--noimplicit_deps"],
    scope = [":mcp_re_core"],
)

# ADR-MCPRE-051 "Compliance and Enforcement": the core purity firewall. Reads the
# dependency closure and fails on any networking/async/fs or up-stack crate in it —
# encoding the ADR-051 split (core pure; the async stack is admitted into the proxy
# serving path only).
nt_rust_test(
    name = "firewall_test",
    srcs = ["tests/firewall_test.rs"],
    data = [":mcp_re_core_dependency_closure"],
    edition = "2021",
    env = {
        "MCP_RE_CORE_DEPENDENCY_CLOSURE": "$(rlocationpath :mcp_re_core_dependency_closure)",
    },
    deps = [
        ":mcp_re_core",
        "//mcp-re-test-paths:mcp_re_test_paths",
    ],
)

# The Verus lane (ADR-MCPRE-059 §16): the pinned prover over this crate with its `verify`
# specifications on. `manual`: it needs the pinned install, which only the Verus lane's
# hosts carry; `tools/verification/verify-verus` builds it.
verus_verify(
    name = "mcp_re_core_verus",
    crate = ":mcp_re_core",
    spec_features = ["verify"],
    tags = ["manual"],
)

# The Lean extraction lane (ADR-MCPRE-059 §8): Charon's LLBC of this crate, built on the
# nightly Charon's driver is compiled against. `manual`: it runs only inside the pinned
# extraction container; `tools/verification/regenerate-lean` builds it with the units'
# `extracted_symbols`.
charon_llbc(
    name = "mcp_re_core_llbc",
    crate = ":mcp_re_core",
    tags = ["manual"],
)
