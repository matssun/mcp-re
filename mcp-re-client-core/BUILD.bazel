load("//bazel:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

# ADR-MCPRE-066 §2.1: the source tree, exposed so the conformance audit-vocabulary guard can
# MEASURE which files decide what an `mcp-re.*` verdict token says, rather than reading a
# hand-maintained list of producers. The sentinel names the tree; the guard walks it.
filegroup(
    name = "guard_src_files",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# ADR-MCPRE-066 Slice 2: this crate's binding-spec refusal algebra and the one file that
# decides which Core verdict each refusal IS, exposed so the conformance audit-vocabulary
# guard can read both from DISK. The guard asserts the algebra mints no `mcp-re.*` token
# of its own — the two SDKs render these refusals, so a hand-written table here would be a
# parallel namespace two published surfaces emit from.
exports_files([
    "src/binding_spec/refusal.rs",
    "src/core_projection.rs",
])

# MCPS-40 (ADR-MCPS-044 §mcp-re-client-core): the client-side shared seam consumed
# by the local proxy and the SDK. Pure library — depends only on the verification
# crate plus serde_json (request construction). No networking/async/fs: those are
# the mode-specific layers ABOVE this seam.
nt_rust_library(
    name = "mcp_re_client_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mcp_re_client_core",
    edition = "2021",
    deps = [
        "//mcp-re-core:mcp_re_core",
        "//mcp-re-http-profile:mcp_re_http_profile",
        "@crates_mcp_re//:serde",
        "@crates_mcp_re//:serde_json",
    ],
)

# Inline crate unit tests (request / response / enforcement / authz / signer /
# correlation #[cfg(test)] modules). The MCPRE-122 delegated-verify tests build
# server-signed fixtures via mcp-re-http-profile custody/sign/rejection primitives.
nt_rust_test(
    name = "mcp_re_client_core_test",
    crate = ":mcp_re_client_core",
    auto_cargo_toml = False,
    bazel_build_cfg = False,
    edition = "2021",
    deps = [
        "//mcp-re-core:mcp_re_core",
        "//mcp-re-http-profile:mcp_re_http_profile",
        "@crates_mcp_re//:serde",
        "@crates_mcp_re//:serde_json",
    ],
)
