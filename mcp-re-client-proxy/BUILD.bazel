load("//bazel:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

# ADR-MCPRE-066 §2.1: the source tree, exposed so the conformance audit-vocabulary guard can
# MEASURE which files decide what an `mcp-re.*` verdict token says, rather than reading a
# hand-maintained list of producers. The sentinel names the tree; the guard walks it.
filegroup(
    name = "guard_src_files",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# MCPS-49 (ADR-MCPS-044 §Proxy transparency / §Security adapter scope): the local
# client-side MCP-RE proxy — the first adoption bridge. Mode-specific layer above the
# pure mcp-re-client-core seam; the transport is abstracted behind a trait so the
# security pipeline links no networking crate here.
nt_rust_library(
    name = "mcp_re_client_proxy",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mcp_re_client_proxy",
    edition = "2021",
    deps = [
        "//mcp-re-client-core:mcp_re_client_core",
        "//mcp-re-core:mcp_re_core",
        "@crates_mcp_re//:serde_json",
    ],
)

# Inline crate unit tests. Currently the `manifest_floor` #[cfg(test)] module (the
# ADR-MCPRE-052 durable trust-anchor rollback floor: durability across reopen,
# monotonicity, fail-closed on a corrupt floor). This crate had no test target at all
# while it had no inline tests, so adding the module without adding this would have
# left them running under cargo and invisible to `bazel test //...`.
nt_rust_test(
    name = "mcp_re_client_proxy_test",
    crate = ":mcp_re_client_proxy",
    auto_cargo_toml = False,
    bazel_build_cfg = False,
    edition = "2021",
    deps = [
        "//mcp-re-client-core:mcp_re_client_core",
        "//mcp-re-core:mcp_re_core",
        # The `verified_outcome` controls perform a real delegated signing round trip:
        # `VerifiedDelegatedResponse` is only obtainable from a verification that
        # succeeded, so the server half is a TEST dependency and not a library one.
        "//mcp-re-http-profile:mcp_re_http_profile",
        "@crates_mcp_re//:serde_json",
    ],
)
