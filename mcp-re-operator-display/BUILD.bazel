load("//bazel:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

# ADR-MCPRE-066 §2.1: the source tree, exposed so the conformance audit-vocabulary guard can
# MEASURE which files decide what an `mcp-re.*` verdict token says, rather than reading a
# hand-maintained list of producers. The sentinel names the tree; the guard walks it.
filegroup(
    name = "guard_src_files",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# The one operator-facing projection of a configured locator. Pure std-only library with
# NO deps — the hand-written decomposition is what keeps it that way, and what keeps a
# shape it cannot take apart named rather than echoed.
nt_rust_library(
    name = "mcp_re_operator_display",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mcp_re_operator_display",
    edition = "2021",
    deps = [],
)

# The projection's own battery: the five negative controls (userinfo absent, the complete
# configured locator absent, query material absent, an unparseable locator not echoed,
# the markers not carrying what they name) plus the positive control that a credential-free
# locator still shows the routing coordinates an operator needs. Hermetic — pure string
# projection, no filesystem and no environment — so it runs on every `bazel test //...`.
nt_rust_test(
    name = "mcp_re_operator_display_test",
    crate = ":mcp_re_operator_display",
    auto_cargo_toml = False,
    bazel_build_cfg = False,
    edition = "2021",
    deps = [],
)
