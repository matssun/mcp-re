load("//bazel:defs.bzl", "nt_rust_test")
load("//bazel/napi:defs.bzl", "nt_napi_addon")

package(default_visibility = ["//visibility:public"])

# A test binary is not loaded by Node, so no test calls into N-API. `napi_host_stub` defines every
# N-API symbol the binding's dependencies reference, and each aborts if called: the dependencies
# call N-API through the GOT, which the loader resolves before `main`, so a symbol left undefined
# would stop the test process before any test runs. The link does not ignore unresolved symbols,
# so an N-API symbol the stub does not define fails the link and the stub is extended with it.
# The stub is one object compiled directly from its source, not a crate of the build graph.
genrule(
    name = "napi_host_stub",
    srcs = ["napi_host_stub.rs"],
    outs = ["napi_host_stub.o"],
    cmd = "$(RUSTC) --edition=2021 --crate-type=lib --crate-name=napi_host_stub --emit=obj=$@ -C panic=abort $(location napi_host_stub.rs)",
    toolchains = ["@rules_rust//rust/toolchain:current_rust_toolchain"],
    tools = ["@rules_rust//rust/toolchain:current_rust_toolchain"],
    visibility = ["//visibility:private"],
)

# ADR-MCPRE-066 §2.1: the source tree, exposed so the conformance audit-vocabulary guard can
# MEASURE which files decide what an `mcp-re.*` verdict token says, rather than reading a
# hand-maintained list of producers. The sentinel names the tree; the guard walks it.
filegroup(
    name = "guard_src_files",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# The TypeScript SDK's Node addon, `mcp-re-sdk-core.<platformArchABI>.node`: the napi-rs
# binding to mcp-re-client-core. `native_type_defs` feeds `scripts/write-binding.mjs`,
# which renders the committed native/binding.js loader and native/binding.d.ts.
nt_napi_addon(
    name = "native",
    binary_name = "mcp-re-sdk-core",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    proc_macro_deps = ["@crates_mcp_re//:napi-derive"],
    deps = [
        "//mcp-re-client-core:mcp_re_client_core",
        "//mcp-re-core:mcp_re_core",
        "@crates_mcp_re//:napi",
        "@crates_mcp_re//:serde",
        "@crates_mcp_re//:serde_json",
    ],
)

# The binding's own unit tests: trust-anchor construction, whole-second time input and the
# verdict projection. The test binary links the crate against `napi_host_stub`; no test calls
# into N-API.
nt_rust_test(
    name = "native_binding_test",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mcp_re_sdk_core",
    crate_root = "src/lib.rs",
    edition = "2021",
    compile_data = [":napi_host_stub"],
    proc_macro_deps = ["@crates_mcp_re//:napi-derive"],
    rustc_flags = ["-C", "link-arg=$(execpath :napi_host_stub)"],
    deps = [
        "//mcp-re-client-core:mcp_re_client_core",
        "//mcp-re-core:mcp_re_core",
        "@crates_mcp_re//:napi",
        "@crates_mcp_re//:serde",
        "@crates_mcp_re//:serde_json",
    ],
)
