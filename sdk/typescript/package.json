{
  "name": "@mcp-re/sdk",
  "version": "0.1.1",
  "description": "MCP-RE TypeScript SDK \u2014 runtime-evidence security (signed requests, verified responses) for the MCP TypeScript SDK, via a transport adapter over the audited mcp-re-client-core.",
  "license": "Apache-2.0",
  "author": "Mats Sundvall",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./mtls": {
      "types": "./dist/mtls.d.ts",
      "default": "./dist/mtls.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "transport": [
        "dist/transport.d.ts"
      ],
      "mtls": [
        "dist/mtls.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "native/binding.js",
    "native/binding.d.ts",
    "native/*.node"
  ],
  "napi": {
    "binaryName": "mcp-re-sdk-core",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build:native": "napi build --platform --release --manifest-path Cargo.toml --output-dir native --js binding.js --dts binding.d.ts",
    "build:native:debug": "napi build --platform --manifest-path Cargo.toml --output-dir native --js binding.js --dts binding.d.ts",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "test": "npm run build && vitest run"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": ">=2.0.0 <3.0.0",
    "@modelcontextprotocol/core": ">=2.0.0 <3.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@modelcontextprotocol/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@napi-rs/cli": "^3.8.6",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@hono/node-server": "^2.0.10",
    "fast-uri": "^3.1.4"
  }
}
